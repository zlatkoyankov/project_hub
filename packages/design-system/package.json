{
  "name": "@zyankov/design-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared tokens, fonts, theme and page shell for every zyankov.eu app.",
  "exports": {
    "./tokens.css": "./tokens.css",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*",
    "./shell.css": "./shell.css",
    "./boards.css": "./boards.css",
    "./boards": {
      "types": "./boards.d.ts",
      "default": "./boards.js"
    },
    "./base.css": "./base.css",
    "./projects.json": "./projects.json",
    "./theme": {
      "types": "./theme.d.ts",
      "default": "./theme.js"
    },
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.mjs"
    },
    "./inject": "./shell/inject.mjs",
    "./analytics": {
      "types": "./analytics.d.ts",
      "default": "./analytics.js"
    },
    "./site.config.json": "./site.config.json",
    "./render": {
      "types": "./shell/render.d.ts",
      "default": "./shell/render.mjs"
    }
  },
  "bin": {
    "zy-inject": "./shell/inject.mjs"
  },
  "scripts": {
    "preview": "node scripts/build-preview.mjs && vite preview --outDir preview-dist --port 4174"
  }
}
