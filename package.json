{
  "name": "project-hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:letterwell": "npm --prefix ../test-app run build && node scripts/copy-letterwell.mjs",
    "prepare:calculators": "npm --prefix ../calculators run build:prod && node scripts/copy-calculators.mjs",
    "prepare:projects": "npm run prepare:letterwell && npm run prepare:calculators",
    "predev": "npm run prepare:projects",
    "prebuild": "npm run prepare:projects",
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-home.mjs && node scripts/generate-sitemap.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
