---
import BaseLayout from '../layouts/BaseLayout.astro'
import HomePage from '../components/HomePage.astro'
import { getPosts } from '../lib/site'

const posts = (await getPosts('en')).slice(0, 5)
---

<BaseLayout
  title="Zyankov.eu | Small browser tools made with care"
  description="Free browser tools by Zlatko Yankov: a Wordle helper, a word finder in English and Bulgarian, and home-improvement calculators. No account needed."
  path="/"
  alternates={{ en: '/', bg: '/bg/' }}
  rss="/blog/rss.xml"
  jsonLd={{ '@type': 'WebSite', name: 'Zyankov.eu' }}
>
  <HomePage lang="en" posts={posts} />
</BaseLayout>
