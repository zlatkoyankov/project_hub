---
import BaseLayout from '../../layouts/BaseLayout.astro'
import HomePage from '../../components/HomePage.astro'
import { getPosts } from '../../lib/site'

const posts = (await getPosts('bg')).slice(0, 5)
---

<BaseLayout
  title="Zyankov.eu | Малки инструменти в браузъра"
  description="Безплатни инструменти от Златко Янков: помощник за Wordle, търсачка за думи от букви на български и английски и калкулатори за ремонт."
  path="/bg/"
  lang="bg"
  alternates={{ en: '/', bg: '/bg/' }}
  rss="/bg/blog/rss.xml"
  jsonLd={{ '@type': 'WebSite', name: 'Zyankov.eu' }}
>
  <HomePage lang="bg" posts={posts} />
</BaseLayout>
