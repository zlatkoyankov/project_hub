---
import PageLayout from '../../layouts/PageLayout.astro'

const title = 'Terms of Use | Zyankov.eu'
const description = 'Terms for using the free tools and articles on Zyankov.eu: calculators, BuildCalc and Letterwell. Why results are estimates, acceptable use and contact.'
const jsonLd = {
  '@type': 'WebPage',
  dateModified: '2026-11-15',
}
---

<PageLayout title={title} description={description} path="/terms/" lang="en" alternates={{ en: '/terms/', bg: '/bg/usloviya/' }} noAds={true} project="hub" jsonLd={jsonLd}>
      <p class="eyebrow">Using these projects</p>
      <h1>Terms of use</h1>
      <p class="updated">Last updated: November 15, 2026</p>
      <p class="intro">
        These terms apply to Zyankov.eu and everything published on it: the calculators,
        BuildCalc, Letterwell and the articles. By using the site, you agree to use it lawfully
        and in accordance with these terms.
      </p>

      <section>
        <h2>What the site provides</h2>
        <p>
          Zyankov.eu offers free browser tools and articles in English and Bulgarian. The
          calculators on Zyankov.eu give arithmetic estimates for building and home-improvement
          materials, household energy use, and everyday sums such as percentages, dates, loan
          payments, VAT, currency conversion and holiday lists. BuildCalc provides further
          estimates for construction and home-improvement materials. Letterwell searches its
          included English and Bulgarian word lists and provides word and game-score tools. The
          articles explain the tools and the figures behind them. Everything is provided for
          general information and planning.
        </p>
      </section>

      <section>
        <h2>Estimates and decisions</h2>
        <p>
          Results depend on the measurements, options, rates, dates, assumptions, dictionaries,
          and scoring rules used. They may contain limitations or errors and are not guarantees,
          supplier quotes, professional, legal, tax or financial advice, structural designs, or a
          substitute for product instructions and applicable requirements.
        </p>
        <p>
          Each calculator shows its formula and sources. Check measurements, rates and figures
          against those sources, and check product coverage, material properties, dictionary
          results, and game rules independently before relying on them. For construction work,
          confirm quantities and safety or structural questions with qualified professionals and
          suppliers; for tax, payroll, loan or legal matters, check with the competent body or a
          qualified professional.
        </p>
      </section>

      <section>
        <h2>Acceptable use</h2>
        <p>
          Do not misuse the site, interfere with their operation, attempt unauthorized access,
          or use them in a way that violates applicable law. The site is provided without
          an account or user-submitted content service.
        </p>
      </section>

      <section>
        <h2>Availability and changes</h2>
        <p>
          Features, content, and availability may change as the site is maintained. The
          site is provided without a promise of uninterrupted availability or error-free
          results. Nothing in these terms limits rights that cannot be excluded under
          applicable law.
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>
          Questions about these terms can be sent to
          <a href="mailto:hello@zyankov.eu">hello@zyankov.eu</a>.
        </p>
      </section>
</PageLayout>
