---
import BlogPost from '../../../components/BlogPost.astro'
import { getPosts, postSlug } from '../../../lib/site'

export async function getStaticPaths() {
  return (await getPosts('en')).map((post) => ({ params: { slug: postSlug(post) }, props: { post } }))
}
const { post } = Astro.props
---

<BlogPost post={post} />
