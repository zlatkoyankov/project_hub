---
// English everyday calculators (percentages, dates, loan payment). The Bulgarian versions are in
// MaterialCalculatorBg.astro; both use the same maths from src/lib/everyday.ts.
import BaseLayout from '../layouts/BaseLayout.astro'
import RelatedTools from './RelatedTools.astro'
import '@zyankov/design-system/boards.css'
import { boardFor } from '@zyankov/design-system/boards'
import { AUTHOR, getPosts, ogKey, postPath } from '../lib/site'
import { postsForTool } from '../lib/related-posts'
import { POST_TOOL_IDS } from '../lib/tools'
import { TOOL_ICONS } from '../lib/tools'
import {
  ALL_ORDER,
  COOK_UNITS,
  CUPS_CHECKED,
  CUPS_CHECKED_ISO,
  FROM_ORDER,
  INGREDIENTS_EN,
  SOURCES_EN,
  TO_ORDER,
  UNIT_SOURCES,
  convertCooking,
  roundCooking,
} from '../lib/kitchen-en'
import '../styles/tool.css'

type Kind = 'percent' | 'dates' | 'loan' | 'savings' | 'kitchen'

interface Props {
  kind: Kind
}

interface Field {
  name: string
  label: string
  unit: string
  value: number | string
  type?: 'number' | 'date'
  signed?: boolean
  step?: string
  hint?: string
  show?: string
}

interface Select {
  name: string
  label: string
  options: { value: string; label: string }[]
}

interface Config {
  path: string
  bg: string
  tool: string
  catalogId: string
  title: string
  description: string
  h1: string
  intro: string
  answer: string
  resultTitle: string
  big: string
  caveat: string
  formula: string
  how: string
  tips: string[]
  sources?: { label: string; href: string }[]
  checked?: string
  checkedIso?: string
  jsonName: string
  formTitle: string
  formHint: string
  selects: Select[]
  fields: Field[]
}

// Cups to grams: the examples in the text are computed with the same function as the calculator.
const cupsFmt = (value: number) => value.toLocaleString('en-US', { maximumFractionDigits: 2 })
const cupsExample = (amount: number, from: 'us-cup' | 'metric-cup' | 'tbsp', ingredient: string) => {
  const result = convertCooking({ amount, from, to: 'g', ingredient })!
  return { ml: cupsFmt(roundCooking('ml', result.ml)), g: cupsFmt(roundCooking('g', result.grams)) }
}
const cupsFlourUs = cupsExample(1, 'us-cup', 'flour')
const cupsSugarUs = cupsExample(1, 'us-cup', 'sugar')
const cupsButterUs = cupsExample(1, 'us-cup', 'butter')
const cupsFlourMetric = cupsExample(1, 'metric-cup', 'flour')
const cupsFlourOneAndHalf = cupsExample(1.5, 'metric-cup', 'flour')
const cupsFlourOneAndHalfUs = cupsExample(1.5, 'us-cup', 'flour')

const CONFIGS: Record<Kind, Config> = {
  percent: {
    path: '/percentage-calculator/',
    bg: '/bg/kalkulator-protsenti/',
    tool: 'percent-calculator',
    catalogId: 'percent',
    title: 'Percentage Calculator: Percent Of, Change, Discount | Zyankov.eu',
    description: 'Work out X% of a number, what percent one number is of another, the percent change between two values, and a price after a discount or markup.',
    h1: 'Percentage calculator',
    intro: 'Pick what you want to work out and enter the two numbers. The result updates as you type.',
    answer: '15% of 200 is 30 (15 ÷ 100 × 200). Going from 80 to 100 is a 25% increase, because the change of 20 is divided by the old value, 80. A 50 price with 20% off costs 40.',
    resultTitle: 'RESULT',
    big: '',
    caveat: 'Rounded to two decimal places. Percent change makes sense when the old value is positive. The discount and markup mode is our own use of the same formulas (price × (1 ± percent ÷ 100)), and the examples with successive discounts are our own arithmetic.',
    formula: 'X% of Y = X ÷ 100 × Y · percent change = (new − old) ÷ old × 100',
    how: 'A percent is a hundredth: 15% of 200 is 15 ÷ 100 × 200 = 30. What percent A is of B is A ÷ B × 100. A percent change is the difference between the new and the old value, divided by the old value. A discount or markup multiplies the price by (1 ± percent ÷ 100).',
    tips: [
      '20% off and then another 10% off is not 30% off but 28%: the second discount applies to the already reduced price.',
      'If a price falls by 50%, it has to rise by 100% to get back to where it was.',
      'For a discount, enter the percent with a minus sign, for example −15.',
      'A percent and a percentage point are different: going from 10% to 9% is a fall of 1 percentage point, but a fall of 10% of the old value.',
    ],
    sources: [
      { label: 'Math Is Fun: a percent is "per 100"; X% of a number and what percent A is of B', href: 'https://www.mathsisfun.com/percentage.html' },
      { label: 'Math Is Fun: percentage change = (new − old) ÷ old × 100', href: 'https://www.mathsisfun.com/numbers/percentage-change.html' },
      { label: 'Eurostat glossary: percentage change = [(later value ÷ earlier value) − 1] × 100', href: 'https://ec.europa.eu/eurostat/statistics-explained/SEPDF/cache/42723.pdf' },
      { label: 'UK Office for National Statistics style guide: a percentage point is the difference between percentages', href: 'https://service-manual.ons.gov.uk/content/numbers/percentages' },
    ],
    checked: '15 November 2026',
    checkedIso: '2026-11-15',
    jsonName: 'Percentage calculator',
    formTitle: 'What to work out',
    formHint: 'Decimals are fine.',
    selects: [
      { name: 'mode', label: 'Calculation', options: [{ value: 'of', label: 'What is X% of a number' }, { value: 'share', label: 'What percent is A of B' }, { value: 'change', label: 'Percent change from A to B' }, { value: 'add', label: 'Price after a discount or markup' }] },
    ],
    fields: [
      { name: 'pct', label: 'Percent', unit: '%', value: 15, signed: true, show: 'mode:of' },
      { name: 'base', label: 'Of the number', unit: '', value: 200, signed: true, show: 'mode:of' },
      { name: 'part', label: 'Number A', unit: '', value: 30, signed: true, show: 'mode:share' },
      { name: 'whole', label: 'Of number B', unit: '', value: 200, signed: true, show: 'mode:share' },
      { name: 'old', label: 'Old value', unit: '', value: 80, signed: true, show: 'mode:change' },
      { name: 'new', label: 'New value', unit: '', value: 100, signed: true, show: 'mode:change' },
      { name: 'price', label: 'Price', unit: '', value: 50, show: 'mode:add' },
      { name: 'adjust', label: 'Discount (−) or markup (+)', unit: '%', value: -20, signed: true, show: 'mode:add' },
    ],
  },
  dates: {
    path: '/date-calculator/',
    bg: '/bg/kalkulator-dati/',
    tool: 'date-calculator',
    catalogId: 'dates',
    title: 'Days Between Dates and Business Days Calculator | Zyankov.eu',
    description: 'Count the days and business days between two dates, without US federal or UK bank holidays, and find the date N days or N business days from another date.',
    h1: 'Date calculator',
    intro: 'Count how many days are left until a date or have passed since one, or find the date 30, 60 or 90 days from now. Handy for deadlines, notice periods and payment terms.',
    answer: 'From 1 January to 31 December 2027 there are 364 days (the end date is not counted, so add 1 to include both), of which 260 are Monday to Friday. 90 days after 1 March 2027 is 30 May 2027.',
    resultTitle: 'RESULT',
    big: 'days',
    caveat: 'Business days skip weekends and, if you pick a calendar, the US federal holidays or the UK bank holidays of that region (observed dates). The way days are counted (the start day counts, the end day does not) is our own choice, not a standard: for legal deadlines check the contract or the law.',
    formula: 'days = end date − start date (the end date is not counted); business days = weekdays − holidays on weekdays',
    how: 'The difference between two dates is counted in whole days: the start day counts and the end day does not, so Monday to the next Monday is 7 days. Weekdays are the Mondays to Fridays in that span. For a date N days later, N days are added to the start date, taking the different month lengths and leap years into account. Business days are the weekdays left after the holidays of the calendar you pick; for N business days later the start day is not counted and each following working day is.',
    tips: [
      'If a term says "within 14 days of receipt", the day of receipt usually does not count. Check the contract or the law for the exact rule.',
      'To count both end days (for example days of leave), add 1.',
      'Pick a holiday calendar to take out the US federal holidays or the UK bank holidays. They are worked out by the published rules for every year; one-off days (such as a state funeral) are not included.',
      'For "N business days after", the start day does not count: 3 business days after Wednesday 22 December 2027 is Tuesday 28 December in the US, because Christmas is observed on Friday 24 December.',
    ],
    sources: [
      { label: 'ISO: ISO 8601 writes a date as year-month-day, YYYY-MM-DD, the form used in the date fields and in the page address', href: 'https://help.iso.org/en/articles/376284-iso-8601-international-standard-for-date-and-time-format' },
      { label: '5 U.S.C. § 6103 (Cornell LII): the list of US federal legal public holidays and the Friday-before rule for a Saturday holiday', href: 'https://law.cornell.edu/uscode/text/5/6103' },
      { label: 'GOV.UK: UK bank holidays for England and Wales, Scotland and Northern Ireland, and the substitute weekday when one falls on a weekend', href: 'https://www.gov.uk/bank-holidays' },
      { label: 'Our own pages: US federal holidays 2027 and UK bank holidays 2027, which the calendar choice uses', href: '/us-federal-holidays-2027/' },
    ],
    checked: '15 November 2026',
    checkedIso: '2026-11-15',
    jsonName: 'Date calculator',
    formTitle: 'The dates',
    formHint: 'An empty date is filled in with today.',
    selects: [
      { name: 'mode', label: 'Calculation', options: [{ value: 'between', label: 'Days between two dates' }, { value: 'add', label: 'Date after (or before) N days' }, { value: 'addwork', label: 'Date after (or before) N business days' }] },
      { name: 'calendar', label: 'Holidays to skip', options: [{ value: 'none', label: 'None (weekends only)' }, { value: 'us', label: 'US federal holidays' }, { value: 'england-and-wales', label: 'UK: England and Wales' }, { value: 'scotland', label: 'UK: Scotland' }, { value: 'northern-ireland', label: 'UK: Northern Ireland' }] },
    ],
    fields: [
      { name: 'from', label: 'Start date', unit: '', value: '', type: 'date' },
      { name: 'to', label: 'End date', unit: '', value: '', type: 'date', show: 'mode:between' },
      { name: 'days', label: 'Number of days', unit: 'days', value: 30, step: '1', signed: true, show: 'mode:add', hint: 'Use a minus sign for a date in the past, for example −14.' },
      { name: 'workdays', label: 'Number of business days', unit: 'days', value: 10, step: '1', signed: true, show: 'mode:addwork', hint: 'Use a minus sign to count back.' },
    ],
  },
  loan: {
    path: '/loan-calculator/',
    bg: '/bg/kalkulator-kredit/',
    tool: 'loan-calculator',
    catalogId: 'loan',
    title: 'Loan Payment Calculator: Monthly Payment, Interest | Zyankov.eu',
    description: 'Work out the monthly payment on a fixed-rate loan, the total you repay and the interest, from the amount, annual rate and term. The formula is on the page.',
    h1: 'Loan payment calculator',
    intro: 'Enter the loan amount, the annual interest rate and the term. The calculator works out the equal monthly payment (amortized loan), the total paid and the interest.',
    answer: 'A 25,000 loan at 7% a year over 5 years costs 495.03 a month. Over 60 payments you pay back 29,701.80, so the interest is 4,701.80. The same formula works for car loans, personal loans and fixed-rate mortgages.',
    resultTitle: 'MONTHLY PAYMENT',
    big: 'per month',
    caveat: 'Principal and interest only. Fees, insurance, taxes and escrow are not included; the APR on the offer shows the full cost.',
    formula: 'payment = P × r ÷ (1 − (1 + r)^−n), where r = annual rate ÷ 12 and n = number of months',
    how: 'With an amortized loan you pay the same amount every month. Early payments are mostly interest, later ones mostly principal. The payment comes from the annuity formula with a monthly rate equal to the annual rate divided by 12. The total is the payment times the number of months, and the interest is the total minus the amount borrowed.',
    tips: [
      'Compare loans by APR, not just the interest rate. The APR includes the lender\'s fees.',
      'A longer term lowers the payment but raises the total interest.',
      'This is for a fixed rate. With a variable rate the payment changes with the index.',
      'Extra payments in the first years save the most interest, because the balance is highest then. Check whether your loan has a prepayment penalty.',
    ],
    sources: [
      { label: 'Math Central (University of Regina): the amortization payment formula', href: 'https://mathcentral.uregina.ca/QandQ/topics/amortization' },
      { label: 'CFPB: the difference between a loan\'s interest rate and its APR', href: 'https://www.consumerfinance.gov/ask-cfpb/what-is-an-apr-en-733/' },
      { label: 'AJ Design: worked example, 25,000 at 7% for 5 years ≈ 495.03 a month', href: 'https://ajdesigner.com/loan/' },
    ],
    checked: '11 November 2026',
    checkedIso: '2026-11-11',
    jsonName: 'Loan payment calculator',
    formTitle: 'The loan',
    formHint: 'Any currency. The rate is per year; the term is in years or months.',
    selects: [
      { name: 'termUnit', label: 'Term in', options: [{ value: 'years', label: 'years' }, { value: 'months', label: 'months' }] },
    ],
    fields: [
      { name: 'principal', label: 'Loan amount', unit: '', value: 25000 },
      { name: 'rate', label: 'Annual interest rate', unit: '%', value: 7 },
      { name: 'term', label: 'Term', unit: '', value: 5, step: '1' },
      { name: 'extra', label: 'Extra payment each month', unit: '', value: 0, hint: 'Optional: an amount on top of the payment that goes to the principal.' },
    ],
  },
  savings: {
    path: '/compound-interest-calculator/',
    bg: '',
    tool: 'compound-interest-calculator',
    catalogId: 'savings',
    title: 'Compound Interest Calculator with Monthly Deposits | Zyankov.eu',
    description: 'See how savings grow with compound interest: a starting amount, a monthly deposit, the annual rate and the years, with the balance by year. Formula shown.',
    h1: 'Compound interest calculator',
    intro: 'Enter what you start with, what you add each month, the annual interest rate and how many years. See the final balance, how much of it is your own money and how much is interest.',
    answer: '10,000 plus 200 a month at 7% a year for 20 years grows to 144,572.72. You put in 58,000; the other 86,572.72 is interest. Without the monthly deposits, the 10,000 alone would be 40,387.39. At 7% money roughly doubles every 10 years (72 ÷ 7 ≈ 10.3).',
    resultTitle: 'FINAL BALANCE',
    big: '',
    caveat: 'Interest compounded monthly, deposits at the end of each month, a fixed rate, before tax and fees. Real returns on investments change from year to year.',
    formula: 'balance = P × (1 + r)^n + PMT × ((1 + r)^n − 1) ÷ r, where r = annual rate ÷ 12 and n = number of months',
    how: 'Each month the balance earns the monthly rate (the annual rate divided by 12), and the deposit is added at the end of the month. The interest then earns interest of its own, which is why the curve gets steeper with time. The total is the starting amount grown for all the months plus every deposit grown for the months it was in the account. This is the same method as the SEC’s Investor.gov calculator with monthly compounding.',
    tips: [
      'Start early: with the same deposits, the extra years at the end add the most, because the balance is biggest then.',
      'A bank quotes APY (annual percentage yield) when interest is compounded. 7% compounded monthly is an APY of about 7.23%.',
      'The rule of 72 gives the doubling time: 72 ÷ the rate in percent. At 4% about 18 years, at 8% about 9.',
      'Inflation and tax reduce what the balance can buy. Enter a lower rate to see a real (after-inflation) estimate.',
    ],
    sources: [
      { label: 'SEC Investor.gov: compound interest calculator (monthly compounding, regular deposits)', href: 'https://www.investor.gov/financial-tools-calculators/calculators/compound-interest-calculator' },
      { label: 'SEC Investor.gov glossary: the rule of 72', href: 'https://www.investor.gov/introduction-investing/investing-basics/glossary/rule-72' },
      { label: 'Worked example elsewhere: 10,000 + 200 a month at 7% for 20 years = 144,572.72', href: 'https://hiinformation.pages.dev/calculators/finance/compound-interest/' },
    ],
    checked: '12 November 2026',
    checkedIso: '2026-11-12',
    jsonName: 'Compound interest calculator',
    formTitle: 'Your savings',
    formHint: 'Any currency. The rate is per year.',
    selects: [],
    fields: [
      { name: 'principal', label: 'Starting amount', unit: '', value: 10000 },
      { name: 'monthly', label: 'Monthly deposit', unit: '', value: 200 },
      { name: 'rate', label: 'Annual interest rate', unit: '%', value: 7 },
      { name: 'years', label: 'Years', unit: 'yr', value: 20, step: '1' },
    ],
  },
  kitchen: {
    path: '/cups-to-grams-calculator/',
    bg: '/bg/kuhnenski-merki/',
    tool: 'cups-to-grams-calculator',
    catalogId: 'kitchen',
    title: 'Cups to Grams Converter: Flour, Sugar, Butter | Zyankov.eu',
    description: 'Convert US cups, metric cups (250 ml), tablespoons and teaspoons to grams and ml for 15 ingredients, with the formula and a sourced density table.',
    h1: 'Cups to grams converter',
    intro: 'Pick an ingredient, enter how much you have and what you measure it in, and see the amount in grams, millilitres, US cups, metric cups and spoons. The result updates as you type.',
    answer: `1 US cup of all-purpose flour is ${cupsFlourUs.g} g, 1 US cup of granulated sugar is ${cupsSugarUs.g} g and 1 US cup of butter is ${cupsButterUs.g} g. A 250 ml metric cup of flour is about ${cupsFlourMetric.g} g, and 1½ metric cups are ${cupsFlourOneAndHalf.ml} ml, or about ${cupsFlourOneAndHalf.g} g. The conversion is grams = ml × density, so it is different for every ingredient.`,
    resultTitle: 'THAT IS',
    big: 'grams',
    caveat: 'An estimate. The weight of a cup depends on the ingredient, on how the cup is filled (sifted, spooned, scooped or packed) and on the size of your own cup. For dough and baking, weigh on a kitchen scale.',
    formula: 'ml = amount × volume of the measure · grams = ml × density (g/ml) · amount in a measure = ml ÷ volume of the measure',
    how: 'Every measure has a volume in millilitres: a US cup is 236.588 ml (8 US fluid ounces), a US tablespoon 14.787 ml, a US teaspoon 4.929 ml, and the metric cup used in UK, Australian and other metric recipes is 250 ml. Every ingredient has a density in grams per millilitre. For most we took a published weight of one US cup or tablespoon and divided it by the volume of that measure; for water, milk and sunflower oil we used a measured density. Grams are the millilitres times the density. Our own rounding: grams and ml are whole numbers from 10 up and have one decimal below 10, cups and spoons have two decimals. The "by eye" line is the nearest quarter, for example 1½. Ingredients with no source we could find are not in the list.',
    tips: [
      'A cup is a volume, not a weight. A US cup of flour is 120 g and a US cup of sugar is 198 g.',
      'Check which cup the recipe means. A US cup (236.6 ml) is about 5% smaller than a metric cup (250 ml). Some US labels round the cup to 240 ml, which is 1.4% more than the exact figure we use.',
      'Flour packs down. A cup scooped straight from the bag weighs more than one spooned in and levelled, which is why baking recipes give grams.',
      'Spoons are level, not heaped. We use US spoons (tablespoon 14.79 ml, teaspoon 4.93 ml); the metric 15 ml and 5 ml spoons are within 1.4% of them. Australian recipes use a 20 ml tablespoon: enter 20 ml per tablespoon in millilitres instead.',
    ],
    sources: [
      ...Object.values(SOURCES_EN).map((source) => ({ label: source.label, href: source.href })),
      ...UNIT_SOURCES,
    ],
    checked: CUPS_CHECKED,
    checkedIso: CUPS_CHECKED_ISO,
    jsonName: 'Cups to grams converter',
    formTitle: 'What are you measuring',
    formHint: 'Decimals are fine, for example 0.5 for half a cup.',
    selects: [
      { name: 'ingredient', label: 'Ingredient', options: INGREDIENTS_EN.map((item) => ({ value: item.id, label: item.label })) },
      { name: 'from', label: 'I have', options: FROM_ORDER.map((unit) => ({ value: unit, label: COOK_UNITS[unit].label })) },
      { name: 'to', label: 'I want to know', options: TO_ORDER.map((unit) => ({ value: unit, label: COOK_UNITS[unit].label })) },
    ],
    fields: [
      { name: 'amount', label: 'Amount', unit: '', value: 1, step: 'any' },
    ],
  },
}

const { kind } = Astro.props
const page = CONFIGS[kind]
const posts = postsForTool(POST_TOOL_IDS[page.tool], await getPosts('en'))
const jsonLd = {
  '@type': 'WebApplication',
  name: page.jsonName,
  description: page.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: 'en',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: AUTHOR,
  publisher: AUTHOR,
  ...(page.checkedIso && { dateModified: page.checkedIso }),
}
---

<BaseLayout title={page.title} description={page.description} path={page.path} lang="en" alternates={page.bg ? { en: page.path, bg: page.bg } : undefined} project="buildcalc" jsonLd={jsonLd} breadcrumbs={[{ name: 'Home', path: '/' }, { name: page.jsonName, path: page.path }]}>
  <div class="tool-page zy-board" data-board={boardFor(kind)}>
    <main id="top">
      <nav class="tool-crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/#everyday">Everyday sums</a></nav>
      <header class="tool-head">
        <span class="tool-head__icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={TOOL_ICONS[kind]} /></span>
        <div>
          <p class="tool-kicker">EVERYDAY SUMS · CALCULATOR</p>
          <h1>{page.h1}</h1>
          <p class="tool-intro">{page.intro}</p>
          <p class="tool-answer"><strong>In short:</strong> {page.answer}</p>
        </div>
      </header>

      <section class="tool-layout" aria-label={page.h1} data-everyday={kind} data-title={page.jsonName}>
        <form class="tool-form" novalidate>
          <h2>{page.formTitle}</h2>
          <p class="tool-form__hint">{page.formHint}</p>
          <div class="tool-fields">
            {page.selects.map((select) => (
              <div class="tool-field">
                <label for={`ev-${select.name}`}>{select.label}</label>
                <select id={`ev-${select.name}`} name={select.name}>
                  {select.options.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </div>
            ))}
            {page.fields.map((field) => (
              <div class="tool-field" data-show={field.show}>
                <label for={`ev-${field.name}`}>{field.label}</label>
                <div class="tool-input">{field.type === 'date'
                  ? <input id={`ev-${field.name}`} name={field.name} type="date" value={field.value} data-today aria-describedby={field.hint ? `ev-${field.name}-hint` : undefined} />
                  : <input id={`ev-${field.name}`} name={field.name} type="number" inputmode="decimal" min={field.signed ? undefined : '0'} step={field.step ?? 'any'} value={field.value} aria-describedby={field.hint ? `ev-${field.name}-hint` : undefined} />}{field.unit && <span>{field.unit}</span>}</div>
                {field.hint && <small id={`ev-${field.name}-hint`}>{field.hint}</small>}
              </div>
            ))}
          </div>
        </form>

        <aside class="tool-result" aria-live="polite">
          <p class="tool-result__kicker">{page.resultTitle}</p>
          <p class="tool-result__big"><span data-out="big">–</span> <small data-out="bigUnit">{page.big}</small></p>
          <dl data-out="rows"></dl>
          <p class="tool-result__caveat">{page.caveat}</p>
          <div class="tool-result__actions">
            <button type="button" data-copy-list>Copy the result</button>
            <button type="button" data-share-link>Share link</button>
            <p class="tool-result__status" role="status" data-share-status></p>
          </div>
        </aside>
      </section>

      {kind === 'savings' && (
        <section class="tool-schedule" data-growth hidden aria-labelledby="growth-title">
          <h2 id="growth-title">Year by year</h2>
          <p>What you add each year, the interest it earns and the balance at the end of the year.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th>Year</th><th>Deposits</th><th>Interest</th><th>Balance</th></tr></thead><tbody data-growth-body></tbody></table></div>
        </section>
      )}

      {kind === 'loan' && (
        <section class="tool-schedule" data-schedule hidden aria-labelledby="schedule-title">
          <h2 id="schedule-title">Amortization schedule</h2>
          <p>How much of your payments goes to interest and how much to principal, and what you still owe after each year. Each month's interest is the balance × the annual rate ÷ 12.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th data-schedule-period>Year</th><th>Paid</th><th>Interest</th><th>Principal</th><th>Balance</th></tr></thead><tbody data-schedule-body></tbody></table></div>
          <button type="button" data-schedule-toggle data-labels="Show by month|Show by year" data-periods="Month|Year">Show by month</button>
        </section>
      )}

      {kind === 'kitchen' && (
        <section class="tool-schedule tool-schedule--rates" aria-labelledby="cups-table-title">
          <h2 id="cups-table-title">How many grams in a cup: table by ingredient</h2>
          <p>The weight of a measure is the ingredient's density times the volume of the measure. Every density has a source, and this is the same data the calculator above uses. Grams are rounded by our own rule: whole numbers from 10 g up, one decimal below 10 g.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th>Ingredient</th><th>Figure from the source</th><th>g/ml</th><th>1 US cup (236.6 ml)</th><th>1 metric cup (250 ml)</th><th>1 US tbsp (14.79 ml)</th><th>1 US tsp (4.93 ml)</th><th>Source</th></tr></thead><tbody>
            {INGREDIENTS_EN.map((item) => (
              <tr>
                <td>{item.label}</td>
                <td>{item.basis}</td>
                <td>{item.density.toLocaleString('en-US', { minimumFractionDigits: 3, maximumFractionDigits: 3 })}</td>
                {(['us-cup', 'metric-cup', 'tbsp', 'tsp'] as const).map((unit) => <td>{roundCooking('g', item.density * COOK_UNITS[unit].ml!).toLocaleString('en-US')} g</td>)}
                <td><a href={SOURCES_EN[item.source].href} target="_blank" rel="noopener">{SOURCES_EN[item.source].short}</a></td>
              </tr>
            ))}
          </tbody></table></div>
          <h3>Notes on the ingredients</h3>
          <ul>
            {INGREDIENTS_EN.filter((item) => item.note).map((item) => <li><strong>{item.label}.</strong> {item.note}</li>)}
          </ul>
          <p>Example: 1½ metric cups of flour are 1.5 × 250 = 375 ml. King Arthur gives 120 g for a US cup of flour (236.588 ml), which is 0.5072 g/ml, so 375 × 0.5072 = {cupsFlourOneAndHalf.g} g. The same 1½ cups measured as US cups are 1.5 × 236.588 × 0.5072 = {cupsFlourOneAndHalfUs.g} g.</p>
        </section>
      )}

      <section class="tool-notes">
        <article>
          <h2>How it is calculated</h2>
          <p>{page.how}</p>
          <p class="tool-formula">{page.formula}</p>
          {page.sources && (
            <div class="tool-sources">
              <h3>Sources{page.checked && <span> · checked {page.checked}</span>}</h3>
              <ul>{page.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener">{source.label}</a></li>)}</ul>
            </div>
          )}
        </article>
        <article>
          <h2>Tips</h2>
          <ul>{page.tips.map((tip) => <li>{tip}</li>)}</ul>
          {page.bg && <p class="tool-switch"><a href={page.bg} hreflang="bg">На български →</a></p>}
        </article>
      </section>

      <RelatedTools lang="en" id={page.catalogId} />

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
          <h2 id="tool-articles-title">Articles on this</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <img src={`/og/${ogKey(postPath(post))}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" decoding="async" />
                  <span><strong>{post.data.title}</strong></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </div>
</BaseLayout>

<script>
  import { track } from '@zyankov/design-system/analytics'
  import { addDays, compoundSavings, daysBetween, loanPayment, loanSchedule, percent, type PercentMode, type ScheduleRow } from '../lib/everyday'
  import { addWorkdays, workdaysBetween, type HolidayCalendar } from '../lib/workdays'
  import { ALL_ORDER, COOK_UNITS, convertCooking, ingredientEnById, nearestQuarter, roundCooking, type CookUnit } from '../lib/kitchen-en'

  const root = document.querySelector<HTMLElement>('[data-everyday]')
  if (root) {
    const kind = root.dataset.everyday
    const form = root.querySelector('form')!
    const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)
    const num = (name: string) => Math.max(0, Number(field(name)?.value.replace(',', '.')) || 0)
    const signed = (name: string) => Number(field(name)?.value.replace(',', '.')) || 0
    const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60_000).toISOString().slice(0, 10)
    form.querySelectorAll<HTMLInputElement>('input[data-today]').forEach((input) => { if (!input.value) input.value = today })
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const fmt = (value: number, digits = 2) => value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: digits })
    const money = (value: number) => value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
    const unitOut = out('bigUnit')
    const defaultUnit = unitOut.textContent ?? ''
    let tracked = false
    // Amortization schedule: a table under the calculator, by year or by month.
    const schedule = document.querySelector<HTMLElement>('[data-schedule]')
    let scheduleView: 'years' | 'months' = 'years'
    let lastPlan: { years: ScheduleRow[]; months: ScheduleRow[] } | null = null
    const showSchedule = (rows: ScheduleRow[] | null) => {
      if (!schedule) return
      schedule.hidden = !rows?.length
      if (!rows) return
      schedule.querySelector('[data-schedule-body]')!.replaceChildren(...rows.map((row) => {
        const tr = document.createElement('tr')
        for (const value of [String(row.period), money(row.payment), money(row.interest), money(row.principal), money(row.balance)]) tr.append(Object.assign(document.createElement('td'), { textContent: value }))
        return tr
      }))
    }
    schedule?.querySelector<HTMLButtonElement>('[data-schedule-toggle]')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement
      scheduleView = scheduleView === 'years' ? 'months' : 'years'
      const [toMonths, toYears] = (button.dataset.labels ?? '').split('|')
      const [month, year] = (button.dataset.periods ?? '').split('|')
      button.textContent = scheduleView === 'years' ? toMonths : toYears
      schedule.querySelector('[data-schedule-period]')!.textContent = scheduleView === 'years' ? year : month
      if (lastPlan) showSchedule(lastPlan[scheduleView])
    })

    const render = (big: string | null, rows: [string, string, string?][], unit = defaultUnit) => {
      out('big').textContent = big ?? '–'
      unitOut.textContent = unit
      out('rows').replaceChildren(...rows.map(([label, value, detail]) => {
        const row = document.createElement('div')
        const dt = document.createElement('dt')
        dt.textContent = label
        if (detail) dt.append(Object.assign(document.createElement('small'), { textContent: detail }))
        row.append(dt, Object.assign(document.createElement('dd'), { textContent: value }))
        return row
      }))
    }

    const update = () => {
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((element) => {
        const [name, value] = (element.dataset.show ?? '').split(':')
        element.hidden = field(name)?.value !== value
      })
      if (kind === 'percent') {
        const mode = (field('mode')?.value ?? 'of') as PercentMode
        const a = mode === 'of' ? signed('pct') : mode === 'share' ? signed('part') : mode === 'change' ? signed('old') : signed('adjust')
        const b = mode === 'of' ? signed('base') : mode === 'share' ? signed('whole') : mode === 'change' ? signed('new') : num('price')
        const result = percent(mode, a, b)
        const unit = mode === 'share' || mode === 'change' ? '%' : ''
        if (!result) return render(null, [['Result', 'none', 'cannot divide by 0']], unit)
        const rows: [string, string, string?][] =
          mode === 'of' ? [['Sum', `${fmt(a)}% of ${fmt(b)}`], ['Result', fmt(result.value)]]
          : mode === 'share' ? [['Sum', `${fmt(a)} of ${fmt(b)}`], ['Share', `${fmt(result.value)}%`]]
          : mode === 'change' ? [['Change', `${result.value > 0 ? '+' : ''}${fmt(result.value)}%`, result.value >= 0 ? 'increase' : 'decrease'], ['Difference', `${result.extra! > 0 ? '+' : ''}${fmt(result.extra!)}`]]
          : [['New price', money(result.value)], [a < 0 ? 'You save' : 'Markup', money(Math.abs(result.extra!))]]
        render(fmt(Math.round(result.value * 100) / 100), rows, unit)
      } else if (kind === 'dates') {
        const from = field('from')?.value ?? ''
        const calendar = (field('calendar')?.value ?? 'none') as HolidayCalendar
        if (field('mode')?.value === 'add' || field('mode')?.value === 'addwork') {
          const work = field('mode')?.value === 'addwork'
          const date = work ? addWorkdays(from, Math.round(signed('workdays')), calendar) : addDays(from, Math.round(signed('days')))
          if (!date) return render(null, [])
          const shown = new Date(`${date}T12:00:00`)
          render(shown.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }), [
            ['Day of the week', shown.toLocaleDateString('en-US', { weekday: 'long' })],
            ['Date', date],
          ], '')
          return
        }
        const span = daysBetween(from, field('to')?.value ?? '')
        const work = workdaysBetween(from, field('to')?.value ?? '', calendar)
        if (!span || !work) return render(null, [])
        render(span.days.toLocaleString('en-US'), [
          ['Business days', `${work.workdays}`, calendar === 'none' ? 'Monday – Friday; pick a calendar to skip holidays' : `without weekends and ${work.holidays} holiday${work.holidays === 1 ? '' : 's'} on a weekday`],
          ['Weekdays', `${span.weekdays}`, 'Monday – Friday, holidays included'],
          ['Weeks', `${span.weeks} wk and ${Math.abs(span.restDays)} days`],
          ['Counting both end dates', `${span.days + Math.sign(span.days || 1)}`, 'if you count the last day too'],
        ], Math.abs(span.days) === 1 ? 'day' : 'days')
      } else if (kind === 'savings') {
        const result = compoundSavings(num('principal'), num('monthly'), num('rate'), num('years'))
        const growth = document.querySelector<HTMLElement>('[data-growth]')
        if (growth) {
          growth.hidden = !result
          growth.querySelector('[data-growth-body]')!.replaceChildren(...(result?.years ?? []).map((row) => {
            const tr = document.createElement('tr')
            for (const value of [String(row.year), money(row.deposits), money(row.interest), money(row.balance)]) tr.append(Object.assign(document.createElement('td'), { textContent: value }))
            return tr
          }))
        }
        if (!result) return render(null, [])
        const rate = num('rate')
        render(money(result.balance), [
          ['Your deposits', money(result.contributions), `starting amount + ${money(num('monthly'))} × ${Math.round(num('years') * 12)} months`],
          ['Interest earned', money(result.interest), `${fmt((result.interest / result.balance) * 100, 1)}% of the balance`],
          ...(rate > 0 ? [['Doubling time (rule of 72)', `about ${fmt(72 / rate, 1)} years`] as [string, string]] : []),
        ])
      } else if (kind === 'kitchen') {
        const unitOf = (name: string, fallback: CookUnit) => (ALL_ORDER.includes(field(name)?.value as CookUnit) ? (field(name)!.value as CookUnit) : fallback)
        const from = unitOf('from', 'us-cup')
        const to = unitOf('to', 'g')
        const ingredient = ingredientEnById(field('ingredient')?.value ?? '')
        const result = convertCooking({ amount: num('amount'), from, to, ingredient: ingredient?.id ?? '' })
        if (!result || !ingredient) return render(null, [])
        const shown = roundCooking(to, result.value)
        const rows: [string, string, string?][] = [
          ['Ingredient', ingredient.label, ingredient.basis],
          ['Volume', `${fmt(roundCooking('ml', result.ml))} ml`, from === 'g' ? `${fmt(num('amount'))} g ÷ ${fmt(result.density, 3)} g/ml` : `${fmt(num('amount'))} × ${fmt(COOK_UNITS[from].ml!, 2)} ml`],
          ['Weight', `${fmt(roundCooking('g', result.grams))} g`, `${fmt(roundCooking('ml', result.ml))} ml × ${fmt(result.density, 3)} g/ml`],
        ]
        for (const unit of ALL_ORDER) {
          if (unit === to || unit === 'g' || unit === 'ml') continue
          rows.push([COOK_UNITS[unit].label, `${fmt(roundCooking(unit, result.all[unit]))}`, `by eye ≈ ${nearestQuarter(result.all[unit])}`])
        }
        if (to !== 'g' && to !== 'ml') rows.splice(1, 0, ['By eye', nearestQuarter(result.value), 'nearest quarter'])
        render(fmt(shown), rows, shown === 1 ? COOK_UNITS[to].one : COOK_UNITS[to].many)
      } else if (kind === 'loan') {
        const months = field('termUnit')?.value === 'months' ? num('term') : num('term') * 12
        const result = loanPayment(num('principal'), num('rate'), months)
        if (!result) { showSchedule(null); return render(null, []) }
        const extra = num('extra')
        const plan = loanSchedule(num('principal'), num('rate'), months, extra)
        lastPlan = plan
        showSchedule(plan?.[scheduleView] ?? null)
        const rows: [string, string, string?][] = [
          ['Number of payments', `${result.months}`],
          ['Total paid', money(result.total)],
          ['Interest', money(result.interest), `${fmt((result.interest / num('principal')) * 100, 1)}% of the amount`],
        ]
        if (plan && extra > 0) {
          rows.push(['With the extra payment', `${plan.paidOffIn} months`, `${result.months - plan.paidOffIn} months sooner`])
          rows.push(['Interest saved', money(result.interest - plan.totalInterest), `interest ${money(plan.totalInterest)}`])
        }
        render(money(result.payment), rows)
      }
    }

    form.addEventListener('input', () => {
      update()
      if (!tracked) {
        tracked = true
        // Only that the tool was used, never the values.
        track('material_calculate', { kind: kind ?? '', language: 'en' })
      }
    })
    form.addEventListener('submit', (event) => event.preventDefault())

    // Shared links carry the values that differ from the defaults, e.g. ?rate=5.5&term=10.
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]')]
    const isDefault = (control: HTMLInputElement | HTMLSelectElement) =>
      control instanceof HTMLSelectElement ? control.selectedIndex === 0 : control.value === control.defaultValue
    const params = new URLSearchParams(window.location.search)
    let restored = false
    for (const control of controls) {
      const value = params.get(control.name)
      if (value === null) continue
      if (control instanceof HTMLSelectElement) {
        if (![...control.options].some((option) => option.value === value)) continue
      } else if (control.type === 'date' ? !/^\d{4}-\d{2}-\d{2}$/.test(value) : !Number.isFinite(Number(value.replace(',', '.')))) continue
      control.value = value
      restored = true
    }
    if (restored) track('material_open_shared', { kind: kind ?? '', language: 'en' })

    const shareUrl = () => {
      const query = new URLSearchParams()
      for (const control of controls) if (!isDefault(control) && control.value !== '') query.set(control.name, control.value)
      const search = query.toString()
      return `${window.location.origin}${window.location.pathname}${search ? `?${search}` : ''}`
    }
    const status = root.querySelector<HTMLElement>('[data-share-status]')
    const say = (text: string) => {
      if (!status) return
      status.textContent = text
      window.setTimeout(() => { if (status.textContent === text) status.textContent = '' }, 3000)
    }
    const copyText = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text)
        return true
      } catch {
        return false
      }
    }
    root.querySelector('[data-copy-list]')?.addEventListener('click', async () => {
      const lines = [
        `${root.dataset.title ?? document.title} – zyankov.eu`,
        `${root.querySelector('.tool-result__kicker')?.textContent?.trim() ?? ''}: ${out('big').textContent} ${unitOut.textContent}`.trim(),
        ...[...out('rows').querySelectorAll('div')].map((row) => {
          const label = row.querySelector('dt')?.firstChild?.textContent?.trim() ?? ''
          const value = row.querySelector('dd')?.textContent?.trim() ?? ''
          const detail = row.querySelector('dt small')?.textContent?.trim()
          return `• ${label}: ${value}${detail ? ` (${detail})` : ''}`
        }),
        '',
        shareUrl(),
      ]
      say((await copyText(lines.join('\n'))) ? 'Copied ✓' : 'Could not copy. Select the text and copy it by hand.')
      track('material_list_copy', { kind: kind ?? '', language: 'en' })
    })
    root.querySelector('[data-share-link]')?.addEventListener('click', async () => {
      const url = shareUrl()
      if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title: root.dataset.title ?? document.title, url })
          track('material_share', { kind: kind ?? '', method: 'native', language: 'en' })
          return
        } catch {
          /* Cancelled or unsupported: fall back to copying. */
        }
      }
      say((await copyText(url)) ? 'Link copied ✓' : url)
      track('material_share', { kind: kind ?? '', method: 'copy', language: 'en' })
    })
    update()
  }
</script>
