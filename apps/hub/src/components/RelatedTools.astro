---
// "Related tools" block: a few tools that go with the current one, linking the site together.
import type { Lang } from '../lib/site'
import { relatedTools, TOOL_ICONS } from '../lib/tools'

interface Props {
  lang: Lang
  /** Catalogue id of the current tool (see TOOL_CATALOG). */
  id: string | undefined
  title?: string
}

const { lang, id, title } = Astro.props
const tools = relatedTools(id)
const heading = title ?? (lang === 'bg' ? 'Свързани инструменти' : 'Related tools')
---

{tools.length > 0 && (
  <section class="related-tools" aria-labelledby={`related-${id}`}>
    <h2 id={`related-${id}`}>{heading}</h2>
    <ul>
      {tools.map((tool) => (
        <li>
          <a href={tool.href[lang]}>
            {tool.icon && <span class="related-tools__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={TOOL_ICONS[tool.icon]} /></span>}
            <span class="related-tools__text">
              <strong>{tool.name[lang]}</strong>
              <span>{tool.description[lang]}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .related-tools {
    margin: 40px 0 8px;
  }

  .related-tools h2 {
    margin: 0 0 14px;
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
  }

  .related-tools ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-tools a {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    height: 100%;
    padding: 14px 16px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .related-tools a:hover {
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }

  .related-tools a:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }

  .related-tools__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    color: var(--coral-strong);
    background: var(--surface-soft);
    border-radius: 10px;
  }

  .related-tools__icon svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .related-tools__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .related-tools__text span {
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.4;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-tools a {
      transition: none;
    }
  }
</style>
