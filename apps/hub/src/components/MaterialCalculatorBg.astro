<script>
  import { track } from '@zyankov/design-system/analytics'
  import { addWorkdays, workdaysBetween } from '../lib/workdays'
  import { addDays, convertEuro, daysBetween, loanPayment, loanSchedule, sickPay, type ScheduleRow, MAX_INSURABLE_EUR, MIN_WAGE_EUR, percent, salaryFromGross, salaryFromNet, vat, type BirthGroup, type PercentMode } from '../lib/everyday'
  import { estimateFence, FENCE_PANELS as PANELS } from '../lib/materials'
  import { estimateAdhesive, estimateAircon, estimateBulk, estimateConcrete, estimateFuelAmount, estimateHeating, estimatePaint, estimateTiles, estimateDrywall, estimateFlooring, estimateInsulation, estimateMasonry, estimateScreed, estimateWallpaper } from '../lib/materials'

  const root = document.querySelector<HTMLElement>('[data-material]')
  if (root) {
    const kind = root.dataset.material
    const form = root.querySelector('form')!
    const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)
    const num = (name: string) => Math.max(0, Number(field(name)?.value.replace(',', '.')) || 0)
    const signed = (name: string) => Number(field(name)?.value.replace(',', '.')) || 0
    // Empty date fields start at today (the page is built ahead of time, so not in the HTML).
    const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60_000).toISOString().slice(0, 10)
    form.querySelectorAll<HTMLInputElement>('input[data-today]').forEach((input) => { if (!input.value) input.value = today })
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const fmt = (value: number, digits = 2) => value.toLocaleString('bg-BG', { minimumFractionDigits: 0, maximumFractionDigits: digits })
    const money = (value: number) => `${value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`
    const unitOut = out('bigUnit')
    let tracked = false
    // Loan repayment plan: a table under the calculator, by year or by month.
    const schedule = document.querySelector<HTMLElement>('[data-schedule]')
    let scheduleView: 'years' | 'months' = 'years'
    let lastPlan: { years: ScheduleRow[]; months: ScheduleRow[] } | null = null
    const showSchedule = (rows: ScheduleRow[] | null) => {
      if (!schedule) return
      schedule.hidden = !rows?.length
      if (!rows) return
      const body = schedule.querySelector('[data-schedule-body]')!
      body.replaceChildren(...rows.map((row) => {
        const tr = document.createElement('tr')
        for (const value of [String(row.period), money(row.payment), money(row.interest), money(row.principal), money(row.balance)]) tr.append(Object.assign(document.createElement('td'), { textContent: value }))
        return tr
      }))
    }
    schedule?.querySelector<HTMLButtonElement>('[data-schedule-toggle]')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement
      scheduleView = scheduleView === 'years' ? 'months' : 'years'
      const [toMonths, toYears] = (button.dataset.labels ?? '').split('|')
      const [month, year] = (button.dataset.periods ?? '').split('|')
      button.textContent = scheduleView === 'years' ? toMonths : toYears
      schedule.querySelector('[data-schedule-period]')!.textContent = scheduleView === 'years' ? year : month
      if (lastPlan) showSchedule(lastPlan[scheduleView])
    })

    const render = (big: number | null, rows: [string, string, string?][]) => {
      out('big').textContent = big === null ? '–' : Number.isInteger(big) ? big.toLocaleString('bg-BG') : fmt(big, 2)
      unitOut.textContent = big === 1 ? unitOut.dataset.one ?? '' : unitOut.dataset.many ?? ''
      out('rows').replaceChildren(...rows.map(([label, value, detail]) => {
        const row = document.createElement('div')
        const dt = document.createElement('dt')
        dt.textContent = label
        if (detail) dt.append(Object.assign(document.createElement('small'), { textContent: detail }))
        row.append(dt, Object.assign(document.createElement('dd'), { textContent: value }))
        return row
      }))
    }

    const update = () => {
      const extraOn = root.querySelector<HTMLSelectElement>('[data-extra-toggle]')?.value === '1'
      const extraBox = root.querySelector<HTMLElement>('[data-extra-fields]')
      if (extraBox) extraBox.hidden = !extraOn
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((element) => {
        const [name, value] = (element.dataset.show ?? '').split(':')
        element.hidden = field(name)?.value !== value
      })
      if (kind === 'percent') {
        const mode = (field('mode')?.value ?? 'of') as PercentMode
        const a = mode === 'of' ? signed('pct') : mode === 'share' ? signed('part') : mode === 'change' ? signed('old') : signed('adjust')
        const b = mode === 'of' ? signed('base') : mode === 'share' ? signed('whole') : mode === 'change' ? signed('new') : num('price')
        const result = percent(mode, a, b)
        unitOut.dataset.one = mode === 'share' || mode === 'change' ? '%' : mode === 'add' ? '€' : ''
        unitOut.dataset.many = unitOut.dataset.one
        if (!result) return render(null, [['Резултат', 'няма', 'не може да се дели на 0']])
        const rows: [string, string, string?][] =
          mode === 'of' ? [['Сметка', `${fmt(a)}% от ${fmt(b)}`], ['Резултат', fmt(result.value)]]
          : mode === 'share' ? [['Сметка', `${fmt(a)} от ${fmt(b)}`], ['Дял', `${fmt(result.value)}%`]]
          : mode === 'change' ? [['Промяна', `${result.value > 0 ? '+' : ''}${fmt(result.value)}%`, result.value >= 0 ? 'увеличение' : 'намаление'], ['Разлика', `${result.extra! > 0 ? '+' : ''}${fmt(result.extra!)}`]]
          : [['Нова цена', money(result.value)], [a < 0 ? 'Спестяваш' : 'Надценка', money(Math.abs(result.extra!))]]
        render(Math.round(result.value * 100) / 100, rows)
      } else if (kind === 'vat') {
        const removing = field('mode')?.value === 'remove'
        const result = vat(num('amount'), Number(field('rate')?.value ?? 20), removing ? 'remove' : 'add')
        unitOut.dataset.one = removing ? '€ без ДДС' : '€ с ДДС'
        unitOut.dataset.many = unitOut.dataset.one
        if (!result) return render(null, [])
        render(Math.round((removing ? result.net : result.gross) * 100) / 100, [
          ['Без ДДС', money(result.net)],
          [`ДДС ${field('rate')?.value ?? 20}%`, money(result.vat)],
          ['С ДДС', money(result.gross)],
        ])
      } else if (kind === 'euro') {
        const toEur = field('direction')?.value !== 'toBgn'
        const result = convertEuro(num('amount'), toEur ? 'toEur' : 'toBgn')
        unitOut.dataset.one = toEur ? '€' : 'лв.'
        unitOut.dataset.many = unitOut.dataset.one
        if (result === null) return render(null, [])
        render(Math.round(result * 100) / 100, [
          ['Курс', '1 € = 1,95583 лв.', 'фиксиран'],
          ['Без закръгляне', `${fmt(result, 5)} ${toEur ? '€' : 'лв.'}`],
        ])
      } else if (kind === 'dates') {
        const from = field('from')?.value ?? ''
        if (field('mode')?.value === 'add' || field('mode')?.value === 'addwork') {
          const work = field('mode')?.value === 'addwork'
          const date = work ? addWorkdays(from, Math.round(signed('workdays')), 'bg') : addDays(from, Math.round(signed('days')))
          if (!date) return render(null, [])
          const shown = new Date(`${date}T12:00:00`)
