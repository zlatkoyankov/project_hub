          ['От работодателя', money(result.employer), `${result.employerDays} дни × ${money(result.employerPerDay)} (70%)`],
          ['От НОИ', money(result.noi), `${result.noiDays} дни × ${money(result.noiPerDay)}${result.capped ? ', до нетната заплата' : field('cause')?.value === 'accident' ? ' (90%)' : ' (80%)'}`],
          ['80% от среднодневния доход', money(result.noiGrossRate), `${result.periodWorkdays} работни дни за 18 месеца`],
          ['Таван: среднодневна нетна заплата', money(result.noiNetCap)],
          ['Нетна заплата за същите дни', money(result.usualNet), 'за сравнение'],
        ]
        render(result.total, rows)
      } else if (kind === 'leave') {
        const daily = field('base')?.value === 'daily'
