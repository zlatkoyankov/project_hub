          <p class="tool-form__hint">{config ? config.formHint : adhesive ? 'Плочката е в сантиметри, фугата и дебелината в милиметри. Цените не са задължителни.' : wallpaper ? 'Стаята е в метри, ролката и раппортът в сантиметри. Цената не е задължителна.' : screed ? 'Площта е в м², дебелината в милиметри. Цената не е задължителна.' : insulation ? 'Площите са в м², дебелината в сантиметри. Цената не е задължителна.' : masonry ? 'Стената е в метри, отворите в м². Цената не е задължителна.' : 'Всички мерки са в метри. Цените не са задължителни.'}</p>
          <div class="tool-fields">
            {config?.selects.map((select) => (
              <div class="tool-field" data-show={select.show}>
                <label for={`mat-${select.name}`}>{select.label}</label>
                <select id={`mat-${select.name}`} name={select.name}>
                  {select.options.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
                </select>
              </div>
            ))}
            {mainFields.map((field) => (
              <div class="tool-field" data-show={field.show}>
                <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                <div class="tool-input">{field.type === 'date'
                  ? <input id={`mat-${field.name}`} name={field.name} type="date" value={field.value} data-today aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} />
                  : <input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min={field.signed ? undefined : '0'} step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} />}{field.unit && <span>{field.unit}</span>}</div>
                {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
              </div>
            ))}
            {masonry && (
              <div class="tool-field">
                <label for="mat-unit">Тухла или блок</label>
                <select id="mat-unit" name="unit">
                  {MASONRY_UNITS.map((unit, index) => <option value={index}>{unit.label}</option>)}
                </select>
              </div>
            )}
            {insulation && (
              <div class="tool-field">
                <label for="mat-board">Плоча</label>
                <select id="mat-board" name="board">
                  {INSULATION_BOARDS.map((board, index) => <option value={index}>{board.label} ({board.area.toLocaleString('bg-BG')} м²)</option>)}
                </select>
              </div>
            )}
            {screed && (
              <div class="tool-field">
                <label for="mat-material">Материал</label>
                <select id="mat-material" name="material">
                  {SCREED_MATERIALS.map((material, index) => <option value={index} data-bag={material.bag}>{material.label} (около {material.kgPerM2PerMm.toLocaleString('bg-BG')} кг/м² на мм)</option>)}
                </select>
              </div>
            )}
            {adhesive && (
              <>
              <div class="tool-field">
                <label for="mat-product">Лепило</label>
                <select id="mat-product" name="product" data-adhesive-product>
                  {ADHESIVE_PRODUCTS.map((product, index) => <option value={index} data-bag={product.bag}>{product.label}</option>)}
                </select>
                <small>Числата са ориентировъчни, от техническите листове на производителите. Разходът зависи от основата и от майстора.</small>
              </div>
              <div class="tool-field" data-adhesive-rate hidden>
                <label for="mat-adhesiveRate">Разход на лепило</label>
                <div class="tool-input"><input id="mat-adhesiveRate" name="adhesiveRate" type="number" inputmode="decimal" min="0" step="0.1" value="3.5" aria-describedby="mat-adhesiveRate-hint" /><span>кг/м²</span></div>
                <small id="mat-adhesiveRate-hint" data-adhesive-rate-hint></small>
              </div>
              <div class="tool-field" data-adhesive-notch>
                <label for="mat-notch">Зъб на маламашката</label>
                <select id="mat-notch" name="notch">
                  <option value="-1">Според размера на плочката</option>
                  {TROWEL_NOTCHES.map((notch, index) => <option value={index}>{notch.mm} мм (около {notch.kgPerM2.toLocaleString('bg-BG')} кг/м²)</option>)}
                </select>
              </div>
              </>
            )}
            {kind === 'drywall' && (
              <>
                <div class="tool-field">
                  <label for="mat-sheet">Размер на плоскостта</label>
                  <select id="mat-sheet" name="sheet">
                    {DRYWALL_SHEETS.map((sheet, index) => <option value={index} selected={index === 1}>{sheet.label} ({sheet.area.toLocaleString('bg-BG')} м²)</option>)}
                  </select>
                </div>
                <div class="tool-field">
                  <label for="mat-ceiling">Таван</label>
                  <select id="mat-ceiling" name="ceiling">
                    <option value="0">Само стените</option>
                    <option value="1">Стените и тавана</option>
                  </select>
                </div>
              </>
            )}
          </div>

          {extra && (
          <fieldset class="tool-fieldset">
              <legend>{extra.legend}</legend>
              <div class="tool-field">
                <label for={`mat-${extra.name}`}>{extra.label}</label>
                <select id={`mat-${extra.name}`} name={extra.name} data-extra-toggle>
                  <option value="1">{extra.on}</option>
                  <option value="0">{extra.off}</option>
                </select>
              </div>
              <div class="tool-fields" data-extra-fields>
                {extraFields.map((field) => (
                  <div class="tool-field">
                    <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                    <div class="tool-input"><input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min="0" step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} /><span>{field.unit}</span></div>
                    {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
                  </div>
                ))}
              </div>
            </fieldset>
          )}
        </form>

        <aside class="tool-result" aria-live="polite">
          <p class="tool-result__kicker" data-out="resultTitle">{page.resultTitle ?? 'ТРЯБВАТ ТИ'}</p>
          <p class="tool-result__big"><span data-out="big">–</span> <small data-out="bigUnit" data-one={page.bigOne} data-many={page.big}>{page.big}</small></p>
          <dl data-out="rows"></dl>
          <p class="tool-result__caveat">{page.caveat ?? 'Ориентировъчна сметка. Провери количествата с магазина, преди да купиш.'}</p>
          {!embed && (
            <div class="tool-result__actions">
              <button type="button" data-copy-list>Копирай списъка</button>
              <button type="button" data-share-link>Сподели връзка</button>
              <p class="tool-result__status" role="status" data-share-status></p>
            </div>
          )}
          {!embed && <Feedback lang="bg" tool={page.tool} title={page.h1} />}
        </aside>
      </section>

      {kind === 'interest' && !embed && (
        <section class="tool-schedule tool-schedule--rates" aria-labelledby="rates-title">
          <h2 id="rates-title">Законна лихва по полугодия</h2>
          <p>Годишният процент за всяко полугодие: референтният процент в сила на 1 януари или 1 юли плюс надбавката. Дневната лихва е 1/360 от него.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th>Период</th><th>Референтен процент</th><th>Надбавка</th><th>Законна лихва</th></tr></thead><tbody>
            {LEGAL_INTEREST_RATES.map((rate) => (
              <tr><td>{rate.from.split('-').reverse().join('.')} – {rate.to.split('-').reverse().join('.')}</td><td>{rate.referenceName === 'ОЛП' ? 'ОЛП на БНБ' : 'ЕЦБ, основни операции'} {rate.reference.toFixed(2).replace('.', ',')}%</td><td>+{rate.margin}</td><td>{rate.rate.toFixed(2).replace('.', ',')}%</td></tr>
            ))}
          </tbody></table></div>
        </section>
      )}

      {kind === 'percent' && !embed && (
        <section class="tool-schedule" aria-labelledby="quick-title">
          <h2 id="quick-title">Колко процента? Трите най-чести въпроса</h2>
          <p>Кратки отговори с формулата на калкулатора по-горе.</p>
          <dl class="tool-quick">
            {quickPercent.map((item) => <div><dt>{item.question}</dt><dd>{item.answer}</dd></div>)}
          </dl>
        </section>
      )}

      {kind === 'dates' && !embed && workdaysExample && (
        <section class="tool-schedule" aria-labelledby="workdays-title">
          <h2 id="workdays-title">Работни (делнични) дни между две дати</h2>
          <p>Калкулаторът брои делничните дни от понеделник до петък, като началният ден се брои, а крайният не. От тях вади официалните почивни дни в България, ако се падат в делничен ден. Събота и неделя не са работни дни.</p>
          <p>Пример: от {new Date(`${WORKDAYS_FROM}T12:00:00Z`).toLocaleDateString('bg-BG', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })} до {new Date(`${WORKDAYS_TO}T12:00:00Z`).toLocaleDateString('bg-BG', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })} има {workdaysExample.days} дни, от тях {workdaysExample.weekdays} делнични и {workdaysExample.workdays} работни, защото {workdaysExample.holidays} от делничните са почивни: {workdaysExample.names.join(', ')}.</p>
          <p>Всички почивни дни по месеци и дългите уикенди са на страницата <a href="/bg/pochivni-dni-2027/">Почивни дни 2027</a>.</p>
        </section>
      )}

      {kind === 'aircon' && !embed && (
        <section class="tool-schedule tool-schedule--rates" aria-labelledby="btu-area-title">
          <h2 id="btu-area-title">BTU по квадратура: за колко м² стига 12000 BTU и другите размери</h2>
          <p>Климатик 12000 BTU (около 3,5 kW) стига за стая до {airconAreas[1].areas[1]} м² с нова дограма, до {airconAreas[1].areas[0]} м² в стара сграда без изолация и до {airconAreas[1].areas[2]} м² при изолирана фасада. Таблицата е по формулата на калкулатора: таван 2,6 м, район със средна зима (като София), климатик за отопление и охлаждане, не на последен етаж. W/м² е наша оценка, виж „Как се изчислява“ по-долу.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th>Климатик</th>{[0, 1, 2].map((index) => <th>{HOME_INSULATION[index].label}</th>)}</tr></thead><tbody>
            {airconAreas.map((row) => (
              <tr><td>{row.btu.toLocaleString('bg-BG')} BTU ({row.kw.toLocaleString('bg-BG')} kW)</td>{row.areas.map((area) => <td>до {area} м²</td>)}</tr>
            ))}
          </tbody></table></div>
        </section>
      )}

      {kind === 'leave' && !embed && (
        <section class="tool-schedule" aria-labelledby="leave-scope-title">
          <h2 id="leave-scope-title">Какво смята калкулаторът и какво не</h2>
          <p>Калкулаторът дава брутна ориентировъчна сума за един ясен случай: постоянна месечна заплата (или известно среднодневно брутно), дни от предходни години, които още не са погасени, и пропорционалния отпуск за годината на прекратяване. Правното основание е чл. 224 КТ. Калкулаторът не заменя консултация със счетоводител или юрист.</p>
          <p>Пример от страницата: 1 760 € ÷ 22 дни = {leaveMoney(leaveExample.daily)} на ден. За 2026 г.: 20 × 6 ÷ 12 = {leaveExample.proportionalDays} дни, минус 4 ползвани = {leaveExample.currentDays} дни. Заедно с 8 дни от 2025 г. са {leaveExample.totalDays} дни × {leaveMoney(leaveExample.daily)} = {leaveMoney(leaveExample.amount)} брутно.</p>
          <h3>Не се смята</h3>
          <ul>
            {LEAVE_NOT_COVERED.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      )}

      {kind === 'kitchen' && !embed && (
        <section class="tool-schedule tool-schedule--rates" aria-labelledby="kitchen-table-title">
          <h2 id="kitchen-table-title">Колко грама са чашата и лъжицата: таблица по продукти</h2>
          <p>Теглото на една мярка е плътността на продукта по обема на мярката. Всяка плътност има източник: така е смятана и калкулаторът по-горе. Грамовете са закръглени по нашите правила (цяло число от 10 г нагоре, една десета под 10 г).</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th>Продукт</th><th>Опорна стойност от източника</th><th>г/мл</th><th>Чаена чаша 200 мл</th><th>Водна чаша 250 мл</th><th>Супена лъжица 15 мл</th><th>Чаена лъжичка 5 мл</th><th>Източник</th></tr></thead><tbody>
            {INGREDIENTS.map((item) => (
              <tr>
                <td>{item.label}</td>
                <td>{item.basis}</td>
                <td>{item.density.toLocaleString('bg-BG', { minimumFractionDigits: 3, maximumFractionDigits: 3 })}</td>
                {(['tea-cup', 'water-cup', 'tbsp', 'tsp'] as const).map((unit) => <td>{roundKitchen('g', item.density * KITCHEN_UNITS[unit].ml!).toLocaleString('bg-BG')} г</td>)}
                <td><a href={KITCHEN_SOURCES[item.source].href} target="_blank" rel="noopener">{KITCHEN_SOURCES[item.source].short}</a></td>
              </tr>
            ))}
          </tbody></table></div>
          <h3>Бележки към продуктите</h3>
          <ul>
            {INGREDIENTS.filter((item) => item.note).map((item) => <li><strong>{item.label}.</strong> {item.note}</li>)}
          </ul>
          <p>Пример: 1,5 водна чаша брашно са 1,5 × 250 = 375 мл. Брашното е 120 г на американска чаша (236,588 мл), тоест 0,5072 г/мл, затова 375 × 0,5072 = {kitchenExample.cups.g} г. С чаена чаша от 200 мл същото количество е 1,5 × 200 × 0,5072 = 152 г.</p>
        </section>
      )}

      {kind === 'loan' && (
        <section class="tool-schedule" data-schedule hidden aria-labelledby="schedule-title">
          <h2 id="schedule-title">Погасителен план</h2>
          <p>Колко от вноските е лихва и колко главница, и колко дължиш след всяка година. Лихвата за месеца е остатъкът × годишната лихва ÷ 12.</p>
          <div class="tool-schedule__wrap"><table><thead><tr><th data-schedule-period>Година</th><th>Платено</th><th>Лихва</th><th>Главница</th><th>Остатък</th></tr></thead><tbody data-schedule-body></tbody></table></div>
          <button type="button" data-schedule-toggle data-labels="Покажи по месеци|Покажи по години" data-periods="Месец|Година">Покажи по месеци</button>
        </section>
      )}

      {!embed && (<>
      <section class="tool-notes">
        <article>
          <h2>Как се изчислява</h2>
          <p>{page.how}</p>
          <p class="tool-formula">{page.formula}</p>
          {page.sources && (
            <div class="tool-sources">
              <h3>Източници{page.checked && <span> · проверено {page.checked}</span>}</h3>
              <ul>{page.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener">{source.label}</a></li>)}</ul>
            </div>
          )}
        </article>
        <article>
          <h2>Съвети</h2>
          <ul>{page.tips.map((tip) => <li>{tip}</li>)}</ul>
          {page.en && <p class="tool-switch"><a href={page.en} hreflang="en">{page.enLabel ?? 'In English, in feet or metres →'}</a></p>}
        </article>
      </section>

      <section class="tool-embed" aria-labelledby="tool-embed-title">
        <h2 id="tool-embed-title">Вгради калкулатора на твоя сайт</h2>
        <p>Безплатно за блогове, форуми и сайтове на фирми. Постави кода в страницата си и калкулаторът ще работи при теб, с връзка към нас.</p>
        <label class="tool-embed__label" for="embed-code">Код за вграждане</label>
        <textarea id="embed-code" class="tool-embed__code" readonly rows="4" data-embed-code>{embedCode}</textarea>
        <details class="tool-embed__more">
          <summary>Височината да се нагажда сама (по желание)</summary>
          <p>Добави и този ред веднъж в страницата. Тогава рамката става точно колкото калкулатора.</p>
          <textarea class="tool-embed__code" readonly rows="3" aria-label="Скрипт за автоматична височина">{embedResize}</textarea>
        </details>
        <p class="tool-embed__actions">
          <button type="button" class="tool-embed__copy" data-embed-copy>Копирай кода</button>
          <a href={embedPath(page.path)} target="_blank" rel="noopener">Виж как изглежда ↗</a>
        </p>
      </section>

      <RelatedTools lang="bg" id={kind} />

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
          <h2 id="tool-articles-title">Статии по темата</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <img src={`/og/${ogKey(postPath(post))}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
                  <span><strong>{post.data.title}</strong></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      </>)}
    </main>
  </div>
</Layout>

<script>
  import { track } from '@zyankov/design-system/analytics'
  import { addWorkdays, workdaysBetween } from '../lib/workdays'
  import { addDays, convertEuro, daysBetween, tripFuelCost, legalInterest, LEGAL_INTEREST_FIRST, LEGAL_INTEREST_LAST, loanPayment, loanSchedule, sickPay, type ScheduleRow, MAX_INSURABLE_EUR, MIN_WAGE_EUR, percent, salaryFromGross, salaryFromNet, vat, type BirthGroup, type PercentMode } from '../lib/everyday'
  import { estimateFence, FENCE_PANELS as PANELS } from '../lib/materials'
  import { KITCHEN_UNITS, UNIT_ORDER, convertKitchen, ingredientById, nearestQuarter, roundKitchen, type KitchenUnit } from '../lib/kitchen'
  import { unusedLeaveCompensation } from '../lib/leave'
  import { ADHESIVE_PRODUCTS as PRODUCTS, estimateAdhesive, estimateAircon, estimateBulk, estimateConcrete, estimateFuelAmount, estimateHeating, estimatePaint, estimateTiles, estimateDrywall, estimateFlooring, estimateInsulation, estimateMasonry, estimateScreed, estimateWallpaper } from '../lib/materials'

  const root = document.querySelector<HTMLElement>('[data-material]')
  if (root) {
    const kind = root.dataset.material
    const form = root.querySelector('form')!
    const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)
    const num = (name: string) => Math.max(0, Number(field(name)?.value.replace(',', '.')) || 0)
    const signed = (name: string) => Number(field(name)?.value.replace(',', '.')) || 0
    // Empty date fields start at today (the page is built ahead of time, so not in the HTML).
    const today = new Date(Date.now() - new Date().getTimezoneOffset() * 60_000).toISOString().slice(0, 10)
    form.querySelectorAll<HTMLInputElement>('input[data-today]').forEach((input) => { if (!input.value) input.value = today })
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const fmt = (value: number, digits = 2) => value.toLocaleString('bg-BG', { minimumFractionDigits: 0, maximumFractionDigits: digits })
    const money = (value: number) => `${value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`
    const unitOut = out('bigUnit')
    let tracked = false
    // Loan repayment plan: a table under the calculator, by year or by month.
    const schedule = document.querySelector<HTMLElement>('[data-schedule]')
    let scheduleView: 'years' | 'months' = 'years'
    let lastPlan: { years: ScheduleRow[]; months: ScheduleRow[] } | null = null
    const showSchedule = (rows: ScheduleRow[] | null) => {
      if (!schedule) return
      schedule.hidden = !rows?.length
      if (!rows) return
      const body = schedule.querySelector('[data-schedule-body]')!
      body.replaceChildren(...rows.map((row) => {
        const tr = document.createElement('tr')
        for (const value of [String(row.period), money(row.payment), money(row.interest), money(row.principal), money(row.balance)]) tr.append(Object.assign(document.createElement('td'), { textContent: value }))
        return tr
      }))
    }
    schedule?.querySelector<HTMLButtonElement>('[data-schedule-toggle]')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement
      scheduleView = scheduleView === 'years' ? 'months' : 'years'
      const [toMonths, toYears] = (button.dataset.labels ?? '').split('|')
      const [month, year] = (button.dataset.periods ?? '').split('|')
      button.textContent = scheduleView === 'years' ? toMonths : toYears
      schedule.querySelector('[data-schedule-period]')!.textContent = scheduleView === 'years' ? year : month
      if (lastPlan) showSchedule(lastPlan[scheduleView])
    })

    const render = (big: number | null, rows: [string, string, string?][]) => {
      out('big').textContent = big === null ? '–' : Number.isInteger(big) ? big.toLocaleString('bg-BG') : fmt(big, 2)
      unitOut.textContent = big === 1 ? unitOut.dataset.one ?? '' : unitOut.dataset.many ?? ''
      out('rows').replaceChildren(...rows.map(([label, value, detail]) => {
        const row = document.createElement('div')
        const dt = document.createElement('dt')
        dt.textContent = label
        if (detail) dt.append(Object.assign(document.createElement('small'), { textContent: detail }))
        row.append(dt, Object.assign(document.createElement('dd'), { textContent: value }))
        return row
      }))
    }

    const update = () => {
      if (kind === 'adhesive') syncProduct()
      const extraOn = root.querySelector<HTMLSelectElement>('[data-extra-toggle]')?.value === '1'
      const extraBox = root.querySelector<HTMLElement>('[data-extra-fields]')
      if (extraBox) extraBox.hidden = !extraOn
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((element) => {
        const [name, value] = (element.dataset.show ?? '').split(':')
        element.hidden = field(name)?.value !== value
      })
      if (kind === 'percent') {
        const mode = (field('mode')?.value ?? 'of') as PercentMode
        const a = mode === 'of' ? signed('pct') : mode === 'share' ? signed('part') : mode === 'change' ? signed('old') : signed('adjust')
        const b = mode === 'of' ? signed('base') : mode === 'share' ? signed('whole') : mode === 'change' ? signed('new') : num('price')
        const result = percent(mode, a, b)
        unitOut.dataset.one = mode === 'share' || mode === 'change' ? '%' : mode === 'add' ? '€' : ''
        unitOut.dataset.many = unitOut.dataset.one
        if (!result) return render(null, [['Резултат', 'няма', 'не може да се дели на 0']])
        const rows: [string, string, string?][] =
          mode === 'of' ? [['Сметка', `${fmt(a)}% от ${fmt(b)}`], ['Резултат', fmt(result.value)]]
          : mode === 'share' ? [['Сметка', `${fmt(a)} от ${fmt(b)}`], ['Дял', `${fmt(result.value)}%`]]
          : mode === 'change' ? [['Промяна', `${result.value > 0 ? '+' : ''}${fmt(result.value)}%`, result.value >= 0 ? 'увеличение' : 'намаление'], ['Разлика', `${result.extra! > 0 ? '+' : ''}${fmt(result.extra!)}`]]
          : [['Нова цена', money(result.value)], [a < 0 ? 'Спестяваш' : 'Надценка', money(Math.abs(result.extra!))]]
        render(Math.round(result.value * 100) / 100, rows)
      } else if (kind === 'vat') {
        const removing = field('mode')?.value === 'remove'
        const result = vat(num('amount'), Number(field('rate')?.value ?? 20), removing ? 'remove' : 'add')
        unitOut.dataset.one = removing ? '€ без ДДС' : '€ с ДДС'
        unitOut.dataset.many = unitOut.dataset.one
        if (!result) return render(null, [])
        render(Math.round((removing ? result.net : result.gross) * 100) / 100, [
          ['Без ДДС', money(result.net)],
          [`ДДС ${field('rate')?.value ?? 20}%`, money(result.vat)],
          ['С ДДС', money(result.gross)],
        ])
      } else if (kind === 'euro') {
        const toEur = field('direction')?.value !== 'toBgn'
        const result = convertEuro(num('amount'), toEur ? 'toEur' : 'toBgn')
        unitOut.dataset.one = toEur ? '€' : 'лв.'
        unitOut.dataset.many = unitOut.dataset.one
        if (result === null) return render(null, [])
        render(Math.round(result * 100) / 100, [
          ['Курс', '1 € = 1,95583 лв.', 'фиксиран'],
          ['Без закръгляне', `${fmt(result, 5)} ${toEur ? '€' : 'лв.'}`],
        ])
      } else if (kind === 'dates') {
        const from = field('from')?.value ?? ''
        if (field('mode')?.value === 'add' || field('mode')?.value === 'addwork') {
          const work = field('mode')?.value === 'addwork'
          const date = work ? addWorkdays(from, Math.round(signed('workdays')), 'bg') : addDays(from, Math.round(signed('days')))
          if (!date) return render(null, [])
          const shown = new Date(`${date}T12:00:00`)
          render(null, [
            ['Ден от седмицата', shown.toLocaleDateString('bg-BG', { weekday: 'long' })],
            ['Дата', date.split('-').reverse().join('.')],
          ])
          out('big').textContent = shown.toLocaleDateString('bg-BG', { day: 'numeric', month: 'long', year: 'numeric' })
          unitOut.textContent = ''
          return
        }
        const span = daysBetween(from, field('to')?.value ?? '')
        const work = workdaysBetween(from, field('to')?.value ?? '', 'bg')
        if (!span || !work) return render(null, [])
        render(span.days, [
          ['Работни дни', `${work.workdays}`, `без събота, неделя и ${work.holidays} ${work.holidays === 1 ? 'празник' : 'празника'} в делничен ден`],
          ['Делнични дни', `${span.weekdays}`, 'понеделник – петък, с празниците'],
          ['Седмици', `${span.weeks} седм. и ${Math.abs(span.restDays)} дни`],
          ['С двата крайни дни', `${span.days + Math.sign(span.days || 1)}`, 'ако броиш и последния ден'],
        ])
      } else if (kind === 'loan') {
        const months = field('termUnit')?.value === 'months' ? num('term') : num('term') * 12
        const result = loanPayment(num('principal'), num('rate'), months)
        if (!result) { showSchedule(null); return render(null, []) }
        const extra = num('extra')
        const plan = loanSchedule(num('principal'), num('rate'), months, extra)
        lastPlan = plan
        showSchedule(plan?.[scheduleView] ?? null)
        const rows: [string, string, string?][] = [
          ['Брой вноски', `${result.months}`],
          ['Общо връщаш', money(result.total)],
          ['Лихва', money(result.interest), `${fmt((result.interest / num('principal')) * 100, 1)}% от сумата`],
        ]
        if (plan && extra > 0) {
          rows.push(['С допълнително погасяване', `${plan.paidOffIn} месеца`, `${result.months - plan.paidOffIn} месеца по-рано`])
          rows.push(['Спестена лихва', money(result.interest - plan.totalInterest), `лихва ${money(plan.totalInterest)}`])
        }
        render(Math.round(result.payment * 100) / 100, rows)
      } else if (kind === 'salary') {
        const fromNet = field('mode')?.value === 'net'
        const born = (field('born')?.value === 'before1960' ? 'before1960' : 'after1959') as BirthGroup
        const accident = Number(field('accident')?.value ?? 0.4)
        const result = fromNet ? salaryFromNet(num('amount'), born, accident) : salaryFromGross(num('amount'), born, accident)
        unitOut.dataset.one = fromNet ? '€ бруто' : '€ нето'
        unitOut.dataset.many = unitOut.dataset.one
        out('resultTitle').textContent = fromNet ? 'БРУТНА ЗАПЛАТА' : 'НА РЪКА'
        if (!result) return render(null, [])
        const e = result.employee
        const rows: [string, string, string?][] = [
          ['Брутна заплата', money(result.gross)],
          ['Осигуровки (лични)', `− ${money(e.total)}`, result.insurable < result.gross ? `13,78% от тавана ${fmt(MAX_INSURABLE_EUR)} €` : '13,78%'],
          ['· ДОО: пенсии, болнични, безработица', money(e.pension + e.sickness + e.unemployment), born === 'before1960' ? '10,58%' : '8,38%'],
          ...(e.supplementary ? [['· ДЗПО (универсален пенсионен фонд)', money(e.supplementary), '2,2%'] as [string, string, string]] : []),
          ['· Здравни', money(e.health), '3,2%'],
          ['Данък (ДДФЛ)', `− ${money(result.tax)}`, `10% от ${money(result.taxBase)}`],
          ['Нетна заплата', money(result.net)],
          ['Осигуровки на работодателя', money(result.employer.total), `18,52% + ТЗПБ ${fmt(accident, 1)}%`],
          ['Общ разход за работодателя', money(result.cost)],
        ]
        if (result.gross < MIN_WAGE_EUR) rows.push(['Внимание', 'под минималната', `МРЗ е ${fmt(MIN_WAGE_EUR)} € за пълен месец`])
        render(fromNet ? result.gross : result.net, rows)
      } else if (kind === 'fence') {
        const type = field('type')?.value === 'mesh' ? 'mesh' : 'panels'
        const panelField = field('panel')?.closest<HTMLElement>('.tool-field')
        if (panelField) panelField.hidden = type !== 'panels'
        const result = estimateFence({ type, length: num('length'), panel: Number(field('panel')?.value ?? 2), meshHeight: num('meshHeight'), rollLength: num('rollLength'), spacing: num('spacing'), holeSide: num('holeSide'), holeDepth: num('holeDepth') })
        if (!result) return render(null, [])
        const panel = PANELS[Number(field('panel')?.value ?? 2)]
        const rows: [string, string, string?][] = type === 'panels'
          ? [
              ['Оградни пана', `${result.panels} бр.`, '2,5 м широки, стъпка 2,53 м'],
              ['Колове', `${result.posts} бр. по ${fmt(result.postLength, 1)} м`, 'дължина за бетониране по Betafence'],
              ['Скоби', `${result.clips} бр.`, `по ${panel?.clips ?? 0} на кол`],
            ]
          : [
              ['Ролки мрежа', `${result.rolls} бр.`, `по ${fmt(num('rollLength'), 1)} м`],
              ['Колове', `${result.posts} бр. по около ${fmt(result.postLength, 1)} м`, 'височината плюс около 0,6 м в земята'],
              ['Обтегателна тел', `${fmt(result.tensionWire, 0)} м`, '3 реда по дължината, плюс малко за връзване'],
            ]
        if (result.concreteM3 > 0) {
          rows.push(['Бетон за коловете', `${fmt(result.concreteM3, 2)} м³`, `${fmt(num('holeSide'), 0)} × ${fmt(num('holeSide'), 0)} см, ${fmt(num('holeDepth'), 2)} м дълбочина`])
          rows.push(['Или сух бетон', `${result.concreteBags} торби по 25 кг`, 'около 12 л от торба'])
