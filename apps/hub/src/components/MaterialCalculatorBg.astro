        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Среднодневно брутно', money(result.daily), daily ? 'въведено от теб' : `${money(num('gross'))} ÷ ${fmt(num('workdays'), 0)} работни дни (наша оценка: месецът е отработен изцяло)`],
          ['Дни от предходни години', `${fmt(result.carriedDays)} дни`, 'не са погасени по давност, ти ги въвеждаш'],
          ['Пропорционален отпуск за годината', `${fmt(result.proportionalDays)} дни`, `${fmt(num('annual'))} дни × ${fmt(Math.min(12, num('months')), 0)} мес. ÷ 12 (наша оценка)`],
          ['Неизползвани дни за годината', `${fmt(result.currentDays)} дни`, `след ${fmt(num('used'))} ползвани`],
          ['Общо дни', `${fmt(result.totalDays)} дни`],
        ]
        if (result.overUsed) rows.push(['Внимание', 'ползвани са повече дни от полагащите се', 'удръжка или връщане не се смятат'])
        render(result.amount, rows)
      } else if (kind === 'interest') {
        const result = legalInterest(num('principal'), field('from')?.value ?? '', field('to')?.value ?? '')
        const shortDate = (iso: string) => iso.split('-').reverse().map((part, index) => index < 2 ? String(Number(part)) : part).join('.')
        if (result === 'input') return render(null, [])
        if (result === 'order') return render(null, [['Датите', 'разменени', 'последният ден е преди първия']])
        if (result === 'range') return render(null, [['Периодът', 'извън таблицата', `от ${shortDate(LEGAL_INTEREST_FIRST)} до ${shortDate(LEGAL_INTEREST_LAST)} г.`]])
        const two = (value: number) => value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        const pct = (value: number) => `${two(value)}%`
        const rows: [string, string, string?][] = result.periods.map((period) => [
          `${shortDate(period.start)} – ${shortDate(period.end)}`,
          money(period.interest),
          `${period.days} дни × ${pct(period.rate)} (${period.referenceName} ${two(period.reference)} + ${period.margin}) ÷ 360`,
        ])
        rows.push(['Дни забава', `${result.days}`], ['Главница', money(num('principal'))], ['Главница и лихва', money(result.total)])
        render(result.interest, rows)
      } else if (kind === 'kitchen') {
        const unitOf = (name: string) => (UNIT_ORDER.includes(field(name)?.value as KitchenUnit) ? (field(name)!.value as KitchenUnit) : 'g')
        const from = unitOf('from')
        const to = unitOf('to')
        const ingredient = ingredientById(field('ingredient')?.value ?? '')
        const result = convertKitchen({ amount: num('amount'), from, to, ingredient: ingredient?.id ?? '' })
        if (!result || !ingredient) { unitOut.textContent = ''; return render(null, []) }
        const shown = roundKitchen(to, result.value)
        const isVolumeMeasure = (unit: KitchenUnit) => unit !== 'g' && unit !== 'ml'
        const rows: [string, string, string?][] = [
          ['Продукт', ingredient.label, ingredient.basis],
          ['Обем', `${fmt(roundKitchen('ml', result.ml))} мл`, from === 'g' ? `${fmt(num('amount'))} г ÷ ${fmt(result.density, 3)} г/мл` : `${fmt(num('amount'))} × ${fmt(KITCHEN_UNITS[from].ml!, 1)} мл`],
          ['Тегло', `${fmt(roundKitchen('g', result.grams))} г`, `${fmt(roundKitchen('ml', result.ml))} мл × ${fmt(result.density, 3)} г/мл`],
        ]
        for (const unit of UNIT_ORDER) {
          if (unit === to || unit === 'g' || unit === 'ml') continue
          const value = result.all[unit]
          rows.push([KITCHEN_UNITS[unit].label, `${fmt(roundKitchen(unit, value))}`, `на око ≈ ${nearestQuarter(value)}`])
        }
        if (isVolumeMeasure(to)) rows.splice(1, 0, ['На око', nearestQuarter(result.value), 'най-близката четвъртинка'])
        render(shown, rows)
        unitOut.textContent = shown === 1 ? KITCHEN_UNITS[to].one : KITCHEN_UNITS[to].many
      } else if (kind === 'fuel') {
        const type = field('fuelType')?.value ?? 'petrol'
        const price = num(type === 'diesel' ? 'priceDiesel' : type === 'lpg' ? 'priceLpg' : 'pricePetrol')
        const result = tripFuelCost({ distance: num('distance'), roundTrip: field('trip')?.value !== 'one', consumption: num('consumption'), price, people: num('people'), extra: num('extra') })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Изминати км', `${fmt(result.km, 1)} км`, field('trip')?.value !== 'one' ? 'отиване и връщане' : 'в едната посока'],
          ['Гориво', `${fmt(result.litres, 1)} л`, `${fmt(result.km, 1)} км × ${fmt(num('consumption'), 1)} л ÷ 100`],
          ['За горивото', money(result.fuel), `${fmt(result.litres, 1)} л × ${fmt(price, 3)} €/л`],
        ]
        if (num('extra') > 0) rows.push(['Общо с други разходи', money(result.total)])
        if (num('people') > 1) rows.push(['На човек', money(result.perPerson), `${fmt(Math.max(1, Math.floor(num('people'))), 0)} души`])
        rows.push(['На 100 км', money(result.per100km)], ['На километър', `${fmt(result.perKm * 100, 1)} цента`])
        render(result.total, rows)
      } else if (kind === 'aircon') {
        const result = estimateAircon({
          area: num('area'), height: num('height'), insulation: Number(field('insulation')?.value ?? 1), climate: Number(field('climate')?.value ?? 1),
          use: field('use')?.value === 'cooling' ? 'cooling' : 'both', sunny: field('sunny')?.value === '1', topFloor: field('topFloor')?.value === '1',
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Нужна мощност', `${fmt(result.needKw, 1)} kW`, `около ${fmt(Math.round(result.needBtu / 100) * 100, 0)} BTU`],
        ]
        if (field('use')?.value !== 'cooling') rows.push(['За отопление', `${fmt(result.heatingKw, 1)} kW`, 'в студените дни'])
        rows.push(['За охлаждане', `${fmt(result.coolingKw, 1)} kW`, 'в горещите дни'])
        if (result.size) rows.push(['Стандартен размер', `${result.size.btu.toLocaleString('bg-BG')} BTU`, `${fmt(result.size.kw, 1)} kW номинално`])
        else rows.push(['Стандартен размер', 'над 24 000 BTU', 'два климатика или мулти сплит система'])
        render(result.size ? result.size.btu : null, rows)
      } else if (kind === 'firewood') {
        const pellets = field('fuel')?.value === 'pellets'
        const result = estimateFuelAmount({
          fuel: pellets ? 'pellets' : 'wood', area: num('area'), heatedShare: num('heatedShare'),
          insulation: Number(field('insulation')?.value ?? 1), climate: Number(field('climate')?.value ?? 1), homeType: Number(field('homeType')?.value ?? 0),
          species: Number(field('species')?.value ?? 0), moisture: Number(field('moisture')?.value ?? 0),
          efficiency: pellets ? num('pelletEfficiency') : num('efficiency'), price: pellets ? num('pelletPrice') : num('woodPrice'),
          pelletKwhPerKg: num('pelletKwh'), bag: num('bag'),
        })
        if (!result) return render(null, [])
        unitOut.dataset.one = pellets ? 'тон пелети' : 'пространствен м³'
        unitOut.dataset.many = pellets ? 'тона пелети' : 'пространствени м³'
        const rows: [string, string, string?][] = [['Нужна топлина', `${fmt(result.demand, 0)} kWh`, 'за целия сезон']]
        if (pellets) {
          rows.push(['Торби', `${result.bags} бр.`, `по ${fmt(num('bag'), 0)} кг`])
        } else {
          rows.push(
            ['Плътни кубици', `${fmt(result.solid, 1)} м³`, 'ако продавачът мери плътно'],
            ['Насипни кубици', `${fmt(result.loose, 1)} м³`, 'нацепени и нахвърлени'],
