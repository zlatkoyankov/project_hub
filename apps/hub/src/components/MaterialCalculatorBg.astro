---
// Bulgarian, metric laminate and drywall calculators (/bg/kalkulator-laminat/, /bg/kalkulator-gipsokarton/).
// The English versions live in BuildCalc; the maths is in src/lib/materials.ts.
import BaseLayout from '../layouts/BaseLayout.astro'
import { getPosts, ogKey, postPath } from '../lib/site'
import { DRYWALL_SHEETS, SCREED_MATERIALS, TROWEL_NOTCHES } from '../lib/materials'
import { TOOL_ICONS } from '../lib/tools'
import '../styles/tool.css'

interface Props {
  kind: 'flooring' | 'drywall' | 'adhesive' | 'wallpaper' | 'screed'
}

interface Field {
  name: string
  label: string
  unit: string
  value: number
  step?: string
  hint?: string
  optional?: boolean
}

const { kind } = Astro.props
const flooring = kind === 'flooring'
const adhesive = kind === 'adhesive'
const wallpaper = kind === 'wallpaper'
const screed = kind === 'screed'

const screedPage = {
  path: '/bg/zamazka-i-mazilka/',
  en: '/calculators/screed-plaster-calculator/',
  tool: 'screed-plaster-calculator',
  title: 'Калкулатор за замазка и мазилка: колко торби ми трябват | Zyankov.eu',
  description: 'Изчисли колко торби циментова или саморазливна замазка или гипсова мазилка трябват по площ и дебелина, с разхода от техническите листове.',
  h1: 'Колко замазка или мазилка ми трябва?',
  intro: 'Въведи площта и средната дебелина и избери материала. Калкулаторът умножава по разхода на милиметър от техническите листове, добавя фира и закръгля до цели торби.',
  big: 'торби',
  bigOne: 'торба',
  formula: 'смес (кг) = площ (м²) × дебелина (мм) × разход (кг/м² на мм)',
  how: 'Производителите дават разхода в килограми суха смес на квадратен метър за всеки милиметър дебелина. Умножава се по площта и средната дебелина, добавя се фира и се дели на теглото на торбата. Типичните стойности са около 2,0 кг за циментова замазка, 1,8 кг за саморазливна и 0,8–1,0 кг за гипсова мазилка.',
  tips: [
    'Измери нивото на няколко места с мастар или лазер и вземи средната дебелина. Една вдлъбнатина може да промени сметката с няколко торби.',
    'Ако знаеш разхода на конкретния продукт, въведи го. Пише на торбата или в техническия лист.',
    'Саморазливната замазка се разлива наведнъж, затова приготви всички торби предварително.',
  ],
  jsonName: 'Калкулатор за замазка и мазилка',
}

const wallpaperPage = {
  path: '/bg/kalkulator-tapeti/',
  en: '/calculators/wallpaper-calculator/',
  tool: 'wallpaper-calculator',
  title: 'Калкулатор за тапети: колко ролки ми трябват | Zyankov.eu',
  description: 'Изчисли колко ролки тапет трябват за стаята по размерите, височината, ролката и раппорта на десена. Брои цели ивици, както го прави майсторът.',
  h1: 'Колко ролки тапет ми трябват?',
  intro: 'Въведи размерите на стаята, височината на стените, вратите и прозорците и размера на ролката. Калкулаторът брои колко цели ивици излизат от една ролка, като спазва раппорта на десена.',
  big: 'ролки',
  bigOne: 'ролка',
  formula: 'ролки = ивици ÷ ивици в ролка, а ивици = (периметър − ширина на отворите) ÷ ширина на ролката',
  how: 'Тапетът се лепи на цели ивици от тавана до пода. Броят ивици е периметърът на стаята без ширината на вратите и прозорците, разделен на ширината на ролката. Всяка ивица е височината на стената, закръглена до цял раппорт, плюс 10 см за подрязване. Остатъкът в края на ролката обикновено е къс за още една ивица, затова се броят цели ивици в ролка.',
  tips: [
    'Купи една ролка в повече от същата партида. Различните партиди може да се различават по тон.',
    'Провери номера на партидата на всяка ролка, преди да започнеш.',
    'При голям раппорт или десен със смяна на половин раппорт (half-drop) фирата е по-голяма.',
  ],
  jsonName: 'Калкулатор за тапети',
}

const adhesivePage = {
      path: '/bg/lepilo-i-fuga/',
      en: '/calculators/tile-adhesive-grout-calculator/',
      tool: 'tile-adhesive-grout-calculator',
      title: 'Калкулатор за лепило и фуга за плочки: колко торби | Zyankov.eu',
      description: 'Изчисли колко лепило и фугираща смес трябват за плочките по площ, размер на плочката, фуга и зъб на маламашката. В кг, торби и евро.',
      h1: 'Колко лепило и фуга ми трябват?',
      intro: 'Въведи площта, размера и дебелината на плочката и ширината на фугата. Калкулаторът избира зъб на маламашката, добавя фира и закръгля до цели торби.',
      big: 'торби лепило',
      bigOne: 'торба лепило',
      formula: 'фуга кг/м² = (дължина + ширина) ÷ (дължина × ширина) × фуга × дебелина × 1,6',
      how: 'Лепилото е площта по типичния разход за зъба на маламашката (по данни на Ceresit CM 11). Фугата се смята от обема на фугите: колкото по-малки са плочките, толкова повече фуги има на квадратен метър. Добавя се фира и се закръгля до цели торби.',
      tips: [
        'Големите плочки искат по-дълбок зъб, за да легнат изцяло в лепилото. При плочки над 60 см намажи и гърба на плочката.',
        'Купи фугата от една партида. Различните партиди може да се различават по цвят.',
        'Фугирай след като лепилото е изсъхнало, обикновено след 24 часа. Виж указанията на производителя.',
      ],
      jsonName: 'Калкулатор за лепило и фуга',
    }

const page = screed ? screedPage : wallpaper ? wallpaperPage : adhesive ? adhesivePage : flooring
  ? {
      path: '/bg/kalkulator-laminat/',
      en: '/calculators/laminate-flooring-calculator/',
      tool: 'laminate-flooring-calculator',
      title: 'Калкулатор за ламинат: колко кутии и первази ми трябват | Zyankov.eu',
      description: 'Изчисли колко кутии ламинат или винил трябват за стаята, с фира, первази, ъгли, капачки и прагове. В метри и евро, безплатно.',
      h1: 'Колко ламинат ми трябва?',
      intro: 'Въведи размерите на стаята и колко м² има в една кутия. Калкулаторът добавя фира, закръгля до цели кутии и брои первазите, ъглите и праговете.',
      big: 'кутии',
      bigOne: 'кутия',
      formula: 'кутии = дължина × ширина × (1 + фира) ÷ м² в кутия',
      how: 'Площта на пода се умножава по фирата и се дели на квадратурата в една кутия, след което се закръгля нагоре. Первазите са периметърът на стаята без вратите, плюс същата фира, разделен на дължината на една лайсна.',
      tips: [
        'Купи всички кутии наведнъж и провери, че са от една партида. Следващата може да е в малко различен тон.',
        'При редене по диагонал или в сложна стая с ниши сложи 12–15% фира вместо 10%.',
        'Остави ламината 48 часа в стаята, преди да го редиш, за да свикне с температурата и влажността.',
      ],
      jsonName: 'Калкулатор за ламинат',
    }
  : {
      path: '/bg/kalkulator-gipsokarton/',
      en: '/calculators/drywall-calculator/',
      tool: 'drywall-calculator',
      title: 'Калкулатор за гипсокартон: колко плоскости ми трябват | Zyankov.eu',
      description: 'Изчисли плоскостите гипсокартон за стените и тавана, CW и UW профилите, винтовете, лентата и шпакловката за фугите. В метри и евро.',
      h1: 'Колко гипсокартон ми трябва?',
      intro: 'Въведи размерите на стаята, височината на стените и отворите. Виж колко цели плоскости трябват за стените и тавана, и колко профили, винтове, лента и шпакловка да купиш.',
      big: 'плоскости',
      bigOne: 'плоскост',
      formula: 'плоскости = (стени + таван − отвори) × (1 + фира) ÷ площ на плоскост',
      how: 'Площта на стените е периметърът на стаята по височината. Добавя се таванът, ако го покриваш, изваждат се вратите и прозорците и се добавя фира. Резултатът се дели на площта на една плоскост и се закръгля нагоре.',
      tips: [
        'В баня и кухня ползвай влагоустойчив (зелен) гипсокартон, а около камина или котел – огнеустойчив.',
        'За таван често се ползват по-тънки и леки плоскости, затова ги поръчай отделно.',
        'По-дългите плоскости дават по-малко фуги, но 3 м плоскост трудно минава по тясно стълбище.',
      ],
      jsonName: 'Калкулатор за гипсокартон',
    }

const adhesiveFields: Field[] = [
  { name: 'area', label: 'Площ за облицоване', unit: 'м²', value: 12, step: '0.01', hint: 'Под или стени. Ако правиш и двете, събери площите.' },
  { name: 'tileLength', label: 'Дължина на плочката', unit: 'см', value: 60, step: '0.1' },
  { name: 'tileWidth', label: 'Ширина на плочката', unit: 'см', value: 60, step: '0.1' },
  { name: 'thickness', label: 'Дебелина на плочката', unit: 'мм', value: 10, step: '0.5', hint: 'Фугата обикновено се пълни до цялата дебелина.' },
  { name: 'joint', label: 'Ширина на фугата', unit: 'мм', value: 3, step: '0.5' },
  { name: 'waste', label: 'Фира', unit: '%', value: 10, step: '1' },
  { name: 'adhesiveBag', label: 'Торба лепило', unit: 'кг', value: 25, step: '1' },
  { name: 'groutBag', label: 'Торба фуга', unit: 'кг', value: 5, step: '1', hint: 'Често 2 или 5 кг.' },
  { name: 'adhesivePrice', label: 'Цена за торба лепило', unit: '€', value: 0, step: '0.01', optional: true },
  { name: 'groutPrice', label: 'Цена за торба фуга', unit: '€', value: 0, step: '0.01', optional: true },
]

const wallpaperFields: Field[] = [
  { name: 'length', label: 'Дължина на стаята', unit: 'м', value: 4, step: '0.01' },
  { name: 'width', label: 'Ширина на стаята', unit: 'м', value: 3.5, step: '0.01' },
  { name: 'height', label: 'Височина на стените', unit: 'м', value: 2.6, step: '0.01' },
  { name: 'openings', label: 'Врати и прозорци', unit: 'м²', value: 1.8, step: '0.01', hint: 'Една интериорна врата е около 1,8 м².' },
  { name: 'rollWidth', label: 'Ширина на ролката', unit: 'см', value: 53, step: '0.1', hint: 'Стандартната ролка е 53 см, широката 106 см.' },
  { name: 'rollLength', label: 'Дължина на ролката', unit: 'м', value: 10.05, step: '0.01', hint: 'Обикновено 10,05 м.' },
  { name: 'repeat', label: 'Раппорт на десена', unit: 'см', value: 0, step: '0.1', hint: 'Пише на етикета. 0 за едноцветен тапет или свободно подреждане.' },
  { name: 'price', label: 'Цена за ролка', unit: '€', value: 0, step: '0.01', optional: true },
]

const screedFields: Field[] = [
  { name: 'area', label: 'Площ', unit: 'м²', value: 15, step: '0.01', hint: 'Под, стени или таван.' },
  { name: 'thickness', label: 'Средна дебелина', unit: 'мм', value: 40, step: '1', hint: 'Замазка обикновено 30–60 мм, саморазливна 2–10 мм, мазилка 10–15 мм.' },
  { name: 'consumption', label: 'Разход на продукта', unit: 'кг/м²·мм', value: 0, step: '0.05', optional: true, hint: 'От торбата или техническия лист. Остави празно за типичната стойност.' },
  { name: 'waste', label: 'Фира', unit: '%', value: 10, step: '1' },
  { name: 'bag', label: 'Торба', unit: 'кг', value: 25, step: '1', hint: 'Замазките обикновено са по 25 кг, мазилките по 30 кг.' },
  { name: 'price', label: 'Цена за торба', unit: '€', value: 0, step: '0.01', optional: true },
]

const mainFields: Field[] = screed ? screedFields : wallpaper ? wallpaperFields : adhesive ? adhesiveFields : flooring
  ? [
      { name: 'length', label: 'Дължина на стаята', unit: 'м', value: 4, step: '0.01' },
      { name: 'width', label: 'Ширина на стаята', unit: 'м', value: 3.5, step: '0.01' },
      { name: 'boxArea', label: 'Квадратура в една кутия', unit: 'м²', value: 2.22, step: '0.001', hint: 'Пише на кутията, често между 1,7 и 2,5 м².' },
      { name: 'waste', label: 'Фира', unit: '%', value: 10, step: '1', hint: '10% за права наредба, 12–15% за диагонал или сложна стая.' },
      { name: 'price', label: 'Цена за м²', unit: '€', value: 0, step: '0.01', optional: true },
    ]
  : [
      { name: 'length', label: 'Дължина на стаята', unit: 'м', value: 4, step: '0.01' },
      { name: 'width', label: 'Ширина на стаята', unit: 'м', value: 3.5, step: '0.01' },
      { name: 'height', label: 'Височина на стените', unit: 'м', value: 2.6, step: '0.01' },
      { name: 'openings', label: 'Врати и прозорци', unit: 'м²', value: 1.8, step: '0.01', hint: 'Една интериорна врата е около 0,9 × 2,0 м = 1,8 м².' },
      { name: 'waste', label: 'Фира', unit: '%', value: 10, step: '1', hint: 'Около 10%. Повече при много ъгли, скосен таван или много отвори.' },
      { name: 'price', label: 'Цена за плоскост', unit: '€', value: 0, step: '0.01', optional: true },
    ]

const trimFields: Field[] = [
  { name: 'doorways', label: 'Брой врати', unit: 'бр.', value: 1, step: '1' },
  { name: 'doorWidth', label: 'Ширина на вратата', unit: 'м', value: 0.9, step: '0.01' },
  { name: 'pieceLength', label: 'Дължина на една лайсна', unit: 'м', value: 2.5, step: '0.01', hint: 'Обикновено 2,4 или 2,5 м.' },
  { name: 'insideCorners', label: 'Вътрешни ъгли', unit: 'бр.', value: 4, step: '1', hint: 'Правоъгълна стая има 4. Добави по 2 за всяка ниша.' },
  { name: 'outsideCorners', label: 'Външни ъгли', unit: 'бр.', value: 0, step: '1', hint: 'Където стената излиза навън: колона, комин, край на преграда.' },
  { name: 'transitions', label: 'Прагове (преходни лайсни)', unit: 'бр.', value: 1, step: '1', hint: 'Където ламинатът среща друг под, обикновено на вратата.' },
  { name: 'trimPrice', label: 'Цена за лайсна', unit: '€', value: 0, step: '0.01', optional: true },
]

const supplyFields: Field[] = [
  { name: 'studSpacing', label: 'Разстояние между профилите', unit: 'м', value: 0.6, step: '0.01', hint: 'Обикновено 0,6 м. При 0,4 м стената е по-здрава.' },
  { name: 'profileLength', label: 'Дължина на профила', unit: 'м', value: 3, step: '0.01', hint: 'CW и UW профилите са обикновено 2,6, 3 или 4 м.' },
]
const extraFields = flooring ? trimFields : supplyFields
const extra = adhesive || wallpaper || screed ? null : flooring
  ? { name: 'trim', legend: 'Первази и лайсни', label: 'Первази', on: 'Включи первази и лайсни', off: 'Само ламинат' }
  : { name: 'supplies', legend: 'Профили и консумативи', label: 'Консумативи', on: 'Включи профили, винтове, лента и шпакловка', off: 'Само плоскости' }

const posts = (await getPosts('bg')).filter((post) => post.data.tool === page.tool)
const jsonLd = {
  '@type': 'WebApplication',
  name: page.jsonName,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
}
---

<BaseLayout title={page.title} description={page.description} path={page.path} lang="bg" alternates={{ en: page.en, bg: page.path }} project="buildcalc" jsonLd={jsonLd}>
  <div class="tool-page">
    <main id="top">
      <nav class="tool-crumbs" aria-label="Breadcrumb"><a href="/bg/">Начало</a><span aria-hidden="true">/</span><a href="/bg/#home-diy">Дом и ремонт</a></nav>
      <header class="tool-head">
        <span class="tool-head__icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={TOOL_ICONS[kind]} /></span>
        <div>
          <p class="tool-kicker">ДОМ И РЕМОНТ · КАЛКУЛАТОР</p>
          <h1>{page.h1}</h1>
          <p class="tool-intro">{page.intro}</p>
        </div>
      </header>

      <section class="tool-layout" aria-label={page.h1} data-material={kind}>
        <form class="tool-form" novalidate>
          <h2>{adhesive ? 'Площ и плочки' : screed ? 'Площ и дебелина' : 'Твоята стая'}</h2>
          <p class="tool-form__hint">{adhesive ? 'Плочката е в сантиметри, фугата и дебелината в милиметри. Цените не са задължителни.' : wallpaper ? 'Стаята е в метри, ролката и раппортът в сантиметри. Цената не е задължителна.' : screed ? 'Площта е в м², дебелината в милиметри. Цената не е задължителна.' : 'Всички мерки са в метри. Цените не са задължителни.'}</p>
          <div class="tool-fields">
            {mainFields.map((field) => (
              <div class="tool-field">
                <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                <div class="tool-input"><input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min="0" step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} /><span>{field.unit}</span></div>
                {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
              </div>
            ))}
            {screed && (
              <div class="tool-field">
                <label for="mat-material">Материал</label>
                <select id="mat-material" name="material">
                  {SCREED_MATERIALS.map((material, index) => <option value={index} data-bag={material.bag}>{material.label} (около {material.kgPerM2PerMm.toLocaleString('bg-BG')} кг/м² на мм)</option>)}
                </select>
              </div>
            )}
            {adhesive && (
              <div class="tool-field">
                <label for="mat-notch">Зъб на маламашката</label>
                <select id="mat-notch" name="notch">
                  <option value="-1">Според размера на плочката</option>
                  {TROWEL_NOTCHES.map((notch, index) => <option value={index}>{notch.mm} мм (около {notch.kgPerM2.toLocaleString('bg-BG')} кг/м²)</option>)}
                </select>
              </div>
            )}
            {kind === 'drywall' && (
              <>
                <div class="tool-field">
                  <label for="mat-sheet">Размер на плоскостта</label>
                  <select id="mat-sheet" name="sheet">
                    {DRYWALL_SHEETS.map((sheet, index) => <option value={index} selected={index === 1}>{sheet.label} ({sheet.area.toLocaleString('bg-BG')} м²)</option>)}
                  </select>
                </div>
                <div class="tool-field">
                  <label for="mat-ceiling">Таван</label>
                  <select id="mat-ceiling" name="ceiling">
                    <option value="0">Само стените</option>
                    <option value="1">Стените и тавана</option>
                  </select>
                </div>
              </>
            )}
          </div>

          {extra && (
          <fieldset class="tool-fieldset">
              <legend>{extra.legend}</legend>
              <div class="tool-field">
                <label for={`mat-${extra.name}`}>{extra.label}</label>
                <select id={`mat-${extra.name}`} name={extra.name} data-extra-toggle>
                  <option value="1">{extra.on}</option>
                  <option value="0">{extra.off}</option>
                </select>
              </div>
              <div class="tool-fields" data-extra-fields>
                {extraFields.map((field) => (
                  <div class="tool-field">
                    <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                    <div class="tool-input"><input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min="0" step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} /><span>{field.unit}</span></div>
                    {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
                  </div>
                ))}
              </div>
            </fieldset>
          )}
        </form>

        <aside class="tool-result" aria-live="polite">
          <p class="tool-result__kicker">ТРЯБВАТ ТИ</p>
          <p class="tool-result__big"><span data-out="big">–</span> <small data-out="bigUnit" data-one={page.bigOne} data-many={page.big}>{page.big}</small></p>
          <dl data-out="rows"></dl>
          <p class="tool-result__caveat">Ориентировъчна сметка. Провери количествата с магазина, преди да купиш.</p>
        </aside>
      </section>

      <section class="tool-notes">
        <article>
          <h2>Как се изчислява</h2>
          <p>{page.how}</p>
          <p class="tool-formula">{page.formula}</p>
        </article>
        <article>
          <h2>Съвети</h2>
          <ul>{page.tips.map((tip) => <li>{tip}</li>)}</ul>
          <p class="tool-switch"><a href={page.en} hreflang="en">In English, in feet or metres →</a></p>
        </article>
      </section>

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
          <h2 id="tool-articles-title">Статии по темата</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <img src={`/og/${ogKey(postPath(post))}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
                  <span><strong>{post.data.title}</strong></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </div>
</BaseLayout>

<script>
  import { track } from '@zyankov/design-system/analytics'
  import { estimateAdhesive, estimateDrywall, estimateFlooring, estimateScreed, estimateWallpaper } from '../lib/materials'

  const root = document.querySelector<HTMLElement>('[data-material]')
  if (root) {
    const kind = root.dataset.material
    const form = root.querySelector('form')!
    const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)
    const num = (name: string) => Math.max(0, Number(field(name)?.value.replace(',', '.')) || 0)
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const fmt = (value: number, digits = 2) => value.toLocaleString('bg-BG', { minimumFractionDigits: 0, maximumFractionDigits: digits })
    const money = (value: number) => `${value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`
    const unitOut = out('bigUnit')
    let tracked = false

    const render = (big: number | null, rows: [string, string, string?][]) => {
      out('big').textContent = big === null ? '–' : String(big)
      unitOut.textContent = big === 1 ? unitOut.dataset.one ?? '' : unitOut.dataset.many ?? ''
      out('rows').replaceChildren(...rows.map(([label, value, detail]) => {
        const row = document.createElement('div')
        const dt = document.createElement('dt')
        dt.textContent = label
        if (detail) dt.append(Object.assign(document.createElement('small'), { textContent: detail }))
        row.append(dt, Object.assign(document.createElement('dd'), { textContent: value }))
        return row
      }))
    }

    const update = () => {
      const extraOn = root.querySelector<HTMLSelectElement>('[data-extra-toggle]')?.value === '1'
      const extraBox = root.querySelector<HTMLElement>('[data-extra-fields]')
      if (extraBox) extraBox.hidden = !extraOn
      if (kind === 'flooring') {
        const trimOn = extraOn
        const result = estimateFlooring({
          length: num('length'), width: num('width'), waste: num('waste'), boxArea: num('boxArea'), price: num('price'),
          trim: trimOn, doorways: num('doorways'), doorWidth: num('doorWidth'), pieceLength: num('pieceLength'),
          insideCorners: num('insideCorners'), outsideCorners: num('outsideCorners'), transitions: num('transitions'), trimPrice: num('trimPrice'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ на пода', `${fmt(result.area)} м²`],
          ['С фирата', `${fmt(result.areaWithWaste)} м²`],
          ['Ламинат в кутиите', `${fmt(result.boughtArea)} м²`, 'закръглено до цели кутии'],
        ]
        if (result.trim) {
          const trim = result.trim
          rows.push(
            ['Периметър на стаята', `${fmt(trim.perimeter)} м`],
            ['Дължина на первазите', `${fmt(trim.baseboardLength)} м`, 'без вратите, с фирата'],
            ['Первази (лайсни)', `${trim.pieces} бр.`],
            ['Вътрешни ъгли', `${trim.insideCorners} бр.`],
          )
          if (trim.outsideCorners > 0) rows.push(['Външни ъгли', `${trim.outsideCorners} бр.`])
          if (trim.endCaps > 0) rows.push(['Крайни капачки', `${trim.endCaps} бр.`, 'където первазът спира до касата'])
          if (trim.connectors > 0) rows.push(['Съединители', `${trim.connectors} бр.`, 'приблизително, по дългите стени'])
        }
        if (result.transitions > 0) rows.push(['Прагове', `${result.transitions} бр.`])
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.boxes, rows)
      } else if (kind === 'screed') {
        const result = estimateScreed({
          area: num('area'), thickness: num('thickness'), material: Number(field('material')?.value ?? 0),
          consumption: num('consumption'), waste: num('waste'), bag: num('bag'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Обем', `${fmt(result.volume, 3)} м³`],
          ['Разход', `${fmt(result.rate, 2)} кг/м² на мм`, result.custom ? 'въведен от теб' : 'типична стойност за материала'],
          ['Суха смес', `${fmt(result.kg, 0)} кг`, 'с фирата'],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.bags, rows)
      } else if (kind === 'wallpaper') {
        const result = estimateWallpaper({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'),
          rollWidth: num('rollWidth'), rollLength: num('rollLength'), repeat: num('repeat'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Периметър на стаята', `${fmt(result.perimeter)} м`],
          ['Дължина на ивицата', `${fmt(result.drop)} м`, num('repeat') > 0 ? 'височината в цели раппорти, плюс 10 см' : 'височината плюс 10 см за подрязване'],
          ['Ивици', `${result.strips} бр.`, 'вратите и прозорците са извадени по ширина'],
          ['Ивици от една ролка', `${result.stripsPerRoll} бр.`],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        rows.push(['Резервна ролка', '+1', 'от същата партида'])
        render(result.rolls, rows)
      } else if (kind === 'adhesive') {
        const result = estimateAdhesive({
          area: num('area'), tileLength: num('tileLength'), tileWidth: num('tileWidth'), thickness: num('thickness'), joint: num('joint'),
          notch: Number(field('notch')?.value ?? -1), waste: num('waste'), adhesiveBag: num('adhesiveBag'), groutBag: num('groutBag'),
          adhesivePrice: num('adhesivePrice'), groutPrice: num('groutPrice'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ с фирата', `${fmt(result.areaWithWaste)} м²`],
          ['Зъб на маламашката', `${result.notchMm} мм`, result.suggested ? 'според размера на плочката' : undefined],
          ['Лепило', `${fmt(result.adhesive, 1)} кг`, `около ${fmt(result.adhesivePerM2, 1)} кг/м²`],
        ]
        if (result.grout > 0) {
          rows.push(
            ['Фугираща смес', `${fmt(result.grout, 1)} кг`, `около ${fmt(result.groutPerM2, 2)} кг/м²`],
            ['Торби фуга', `${result.groutBags} бр.`, `по ${fmt(num('groutBag'), 1)} кг`],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.adhesiveBags, rows)
      } else {
        const result = estimateDrywall({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'),
          ceiling: field('ceiling')?.value === '1', sheet: Number(field('sheet')?.value ?? 1), waste: num('waste'), price: num('price'),
          supplies: extraOn, studSpacing: num('studSpacing'), profileLength: num('profileLength'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [['Площ на стените', `${fmt(result.walls)} м²`]]
        if (result.ceiling > 0) rows.push(['Площ на тавана', `${fmt(result.ceiling)} м²`])
        rows.push(
          ['Врати и прозорци', `−${fmt(result.openings)} м²`],
          ['За покриване', `${fmt(result.net)} м²`],
          ['С фирата', `${fmt(result.withWaste)} м²`],
          ['Плоскост', result.sheetLabel, 'закръглено до цели плоскости'],
        )
        if (result.supplies) {
          const supplies = result.supplies
          rows.push(
            ['CW профили (стойки)', `${supplies.studs} бр.`, 'само за стените, по една в края на всяка стена'],
            ['CW профили за купуване', `${supplies.studPieces} бр.`],
            ['UW профили (под и таван)', `${fmt(supplies.trackLength, 1)} м`, 'само за стените, с фирата'],
            ['UW профили за купуване', `${supplies.trackPieces} бр.`],
            ['Винтове', `${supplies.screws} бр.`, 'около 11 на м² плоскост'],
            ['Лента за фуги', `${fmt(supplies.tape, 0)} м`, 'фугите и вътрешните ъгли'],
            ['Шпакловка за фуги', `${fmt(supplies.compound, 1)} кг`, 'около 0,5 кг/м² стени и 0,3 кг/м² таван'],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.sheets, rows)
      }
    }

    // Plaster usually comes in 30 kg bags, screed in 25 kg: follow the material unless the user changed the bag.
    const materialSelect = root.querySelector<HTMLSelectElement>('#mat-material')
    const bagInput = root.querySelector<HTMLInputElement>('#mat-bag')
    let bagTouched = false
    bagInput?.addEventListener('input', () => { bagTouched = true })
    materialSelect?.addEventListener('change', () => {
      const bag = materialSelect.selectedOptions[0]?.dataset.bag
      if (bagInput && bag && !bagTouched) bagInput.value = bag
    })

    form.addEventListener('input', () => {
      update()
      if (!tracked) {
        tracked = true
        // Only that the tool was used, never the values.
        track('material_calculate', { kind: kind ?? '', language: 'bg' })
      }
    })
    form.addEventListener('submit', (event) => event.preventDefault())
    update()
  }
</script>
