import '../styles/tool.css'

type Kind = 'flooring' | 'drywall' | 'adhesive' | 'wallpaper' | 'screed' | 'insulation' | 'masonry' | 'concrete' | 'gravel' | 'paint' | 'tile' | 'heating' | 'firewood' | 'aircon' | 'percent' | 'vat' | 'euro' | 'dates' | 'loan' | 'salary' | 'fence' | 'sick' | 'fuel' | 'interest' | 'kitchen' | 'leave'

interface Props {
  kind: Kind
  /** Render for an iframe on another site (/bg/vgradi/…): just the calculator. */
  embed?: boolean
}

interface Field {
  name: string
  label: string
  unit: string
  value: number | string
  /** Date fields hold yyyy-mm-dd; an empty value is filled with today in the browser. */
  type?: 'number' | 'date'
  /** Percentages and changes can be negative. */
  signed?: boolean
  step?: string
  hint?: string
  optional?: boolean
  /** Only shown while a select has this value, as "select:value". */
  show?: string
}

interface Select {
  name: string
  label: string
  /** Only shown while another select has this value, as "select:value". */
  show?: string
  options: { value: string | number; label: string; selected?: boolean }[]
}

interface Page {
  path: string
  /** The English version, if there is one. */
  en?: string
  /** Text of the link to the English page; the default fits the building calculators. */
  enLabel?: string
  tool: string
  title: string
  description: string
  h1: string
  intro: string
  /** The answer in two or three sentences with one worked example, shown under the intro. Search engines and AI
   *  assistants quote this paragraph, so every number in it must come from the calculator's own functions. */
  answer?: string
  big: string
  bigOne: string
  formula: string
  how: string
  /** Heading above the big number; default "ТРЯБВАТ ТИ". */
  resultTitle?: string
  /** Note under the result; default: check the quantities with the shop. */
  caveat?: string
  tips: string[]
  /** Where the figures come from: shown under the explanation. */
  sources?: { label: string; href: string }[]
  /** Date the prices and figures were last checked, e.g. "7 ноември 2026". */
  checked?: string
  jsonName: string
  /** Heading kicker and breadcrumb; default "ДОМ И РЕМОНТ" and Дом и ремонт. */
  kicker?: string
  crumb?: { label: string; href: string }
}

/** Newer calculators are described here in one place: page text, form, selects and fields. */
interface Config {
  page: Page
  formTitle: string
  formHint: string
  selects: Select[]
  fields: Field[]
}

// Kitchen measures: the example in the intro is computed with the same functions as the calculator.
const kitchenFmt = (value: number) => value.toLocaleString('bg-BG', { maximumFractionDigits: 2 })
const kitchenGrams = (amount: number, from: 'water-cup' | 'tea-cup' | 'tbsp') => {
  const result = convertKitchen({ amount, from, to: 'g', ingredient: 'flour' })!
  return { ml: kitchenFmt(roundKitchen('ml', result.ml)), g: kitchenFmt(roundKitchen('g', result.grams)) }
}
const kitchenExample = { cups: kitchenGrams(1.5, 'water-cup'), tea: kitchenGrams(1, 'tea-cup'), spoon: kitchenGrams(1, 'tbsp') }

// Unused leave: the example on the page is computed with the same function as the calculator.
const leaveMoney = (value: number) => `${value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`
const leaveExample = unusedLeaveCompensation({ gross: 1760, workdays: 22, carriedDays: 8, annualDays: 20, months: 6, usedDays: 4 })!

