      { name: 'openings', label: 'Врати и прозорци', unit: 'м²', value: 1.8, step: '0.01', hint: 'Една интериорна врата е около 0,9 × 2,0 м = 1,8 м².' },
      { name: 'waste', label: 'Фира', unit: '%', value: 10, step: '1', hint: 'Около 10%. Повече при много ъгли, скосен таван или много отвори.' },
      { name: 'price', label: 'Цена за плоскост', unit: '€', value: 0, step: '0.01', optional: true },
    ]

const trimFields: Field[] = [
  { name: 'doorways', label: 'Брой врати', unit: 'бр.', value: 1, step: '1' },
  { name: 'doorWidth', label: 'Ширина на вратата', unit: 'м', value: 0.9, step: '0.01' },
  { name: 'pieceLength', label: 'Дължина на една лайсна', unit: 'м', value: 2.5, step: '0.01', hint: 'Обикновено 2,4 или 2,5 м.' },
  { name: 'insideCorners', label: 'Вътрешни ъгли', unit: 'бр.', value: 4, step: '1', hint: 'Правоъгълна стая има 4. Добави по 2 за всяка ниша.' },
  { name: 'outsideCorners', label: 'Външни ъгли', unit: 'бр.', value: 0, step: '1', hint: 'Където стената излиза навън: колона, комин, край на преграда.' },
  { name: 'transitions', label: 'Прагове (преходни лайсни)', unit: 'бр.', value: 1, step: '1', hint: 'Където ламинатът среща друг под, обикновено на вратата.' },
  { name: 'trimPrice', label: 'Цена за лайсна', unit: '€', value: 0, step: '0.01', optional: true },
]

const supplyFields: Field[] = [
  { name: 'studSpacing', label: 'Разстояние между профилите', unit: 'м', value: 0.6, step: '0.01', hint: 'Обикновено 0,6 м. При 0,4 м стената е по-здрава.' },
  { name: 'profileLength', label: 'Дължина на профила', unit: 'м', value: 3, step: '0.01', hint: 'CW и UW профилите са обикновено 2,6, 3 или 4 м.' },
]
const extraFields = flooring ? trimFields : insulation ? [] : supplyFields
const extra = config || adhesive || wallpaper || screed || masonry ? null : insulation
  ? { name: 'supplies', legend: 'Лепило, мрежа и дюбели', label: 'Консумативи', on: 'Включи лепило, шпакловка, мрежа и дюбели', off: 'Само плочи' }
  : flooring
  ? { name: 'trim', legend: 'Первази и лайсни', label: 'Первази', on: 'Включи первази и лайсни', off: 'Само ламинат' }
  : { name: 'supplies', legend: 'Профили и консумативи', label: 'Консумативи', on: 'Включи профили, винтове, лента и шпакловка', off: 'Само плоскости' }

const posts = postsForTool(kind, await getPosts('bg'))
const jsonLd = {
  '@type': 'WebApplication',
  name: page.jsonName,
  description: page.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: 'bg',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: AUTHOR,
  publisher: AUTHOR,
  // When the formula, rates and sources were last checked (shown on the page as "проверено").
  ...(page.checked && { dateModified: isoFromBgDate(page.checked) }),
}
const Layout = embed ? EmbedLayout : BaseLayout
const layoutProps: Record<string, unknown> = embed
  ? { title: page.title, description: page.description, canonical: page.path, lang: 'bg' }
  : { title: page.title, description: page.description, path: page.path, lang: 'bg', alternates: page.en ? { en: page.en, bg: page.path } : {}, project: 'buildcalc', jsonLd, breadcrumbs: [{ name: 'Начало', path: '/bg/' }, { name: page.jsonName, path: page.path }] }
const embedUrl = `https://zyankov.eu${embedPath(page.path)}`
const embedCode = `<iframe src="${embedUrl}" title="${page.jsonName} – zyankov.eu" width="100%" height="900" style="border:0;max-width:820px" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>`
const embedResize = `<script>addEventListener('message',function(e){if(e.origin!=='https://zyankov.eu'||!e.data||e.data.type!=='zyankov-height')return;document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=e.data.height+'px'})})</script>`
---

<Layout {...layoutProps}>
