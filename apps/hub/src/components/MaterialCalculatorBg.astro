  { name: 'doorways', label: 'Брой врати', unit: 'бр.', value: 1, step: '1' },
  { name: 'doorWidth', label: 'Ширина на вратата', unit: 'м', value: 0.9, step: '0.01' },
  { name: 'pieceLength', label: 'Дължина на една лайсна', unit: 'м', value: 2.5, step: '0.01', hint: 'Обикновено 2,4 или 2,5 м.' },
  { name: 'insideCorners', label: 'Вътрешни ъгли', unit: 'бр.', value: 4, step: '1', hint: 'Правоъгълна стая има 4. Добави по 2 за всяка ниша.' },
  { name: 'outsideCorners', label: 'Външни ъгли', unit: 'бр.', value: 0, step: '1', hint: 'Където стената излиза навън: колона, комин, край на преграда.' },
  { name: 'transitions', label: 'Прагове (преходни лайсни)', unit: 'бр.', value: 1, step: '1', hint: 'Където ламинатът среща друг под, обикновено на вратата.' },
  { name: 'trimPrice', label: 'Цена за лайсна', unit: '€', value: 0, step: '0.01', optional: true },
]

const supplyFields: Field[] = [
  { name: 'studSpacing', label: 'Разстояние между профилите', unit: 'м', value: 0.6, step: '0.01', hint: 'Обикновено 0,6 м. При 0,4 м стената е по-здрава.' },
  { name: 'profileLength', label: 'Дължина на профила', unit: 'м', value: 3, step: '0.01', hint: 'CW и UW профилите са обикновено 2,6, 3 или 4 м.' },
]
const extraFields = flooring ? trimFields : insulation ? [] : supplyFields
const extra = config || adhesive || wallpaper || screed || masonry ? null : insulation
  ? { name: 'supplies', legend: 'Лепило, мрежа и дюбели', label: 'Консумативи', on: 'Включи лепило, шпакловка, мрежа и дюбели', off: 'Само плочи' }
  : flooring
  ? { name: 'trim', legend: 'Первази и лайсни', label: 'Первази', on: 'Включи первази и лайсни', off: 'Само ламинат' }
  : { name: 'supplies', legend: 'Профили и консумативи', label: 'Консумативи', on: 'Включи профили, винтове, лента и шпакловка', off: 'Само плоскости' }

const posts = (await getPosts('bg')).filter((post) => post.data.tool === page.tool)
const jsonLd = {
  '@type': 'WebApplication',
  name: page.jsonName,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
}
const Layout = embed ? EmbedLayout : BaseLayout
const layoutProps: Record<string, unknown> = embed
  ? { title: page.title, canonical: page.path, lang: 'bg' }
  : { title: page.title, description: page.description, path: page.path, lang: 'bg', alternates: page.en ? { en: page.en, bg: page.path } : {}, project: 'buildcalc', jsonLd }
const embedUrl = `https://zyankov.eu${embedPath(page.path)}`
const embedCode = `<iframe src="${embedUrl}" title="${page.jsonName} – zyankov.eu" width="100%" height="900" style="border:0;max-width:820px" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>`
const embedResize = `<script>addEventListener('message',function(e){if(e.origin!=='https://zyankov.eu'||!e.data||e.data.type!=='zyankov-height')return;document.querySelectorAll('iframe').forEach(function(f){if(f.contentWindow===e.source)f.style.height=e.data.height+'px'})})</script>`
---

<Layout {...layoutProps}>
  <div class:list={['tool-page', { 'zy-board': !embed, 'is-embed': embed }]} data-board={boardFor(kind)}>
    <main id="top">
      {!embed && <nav class="tool-crumbs" aria-label="Breadcrumb"><a href="/bg/">Начало</a><span aria-hidden="true">/</span><a href="/bg/#home-diy">Дом и ремонт</a></nav>}
      <header class="tool-head">
        <span class="tool-head__icon" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={TOOL_ICONS[kind]} /></span>
        <div>
          <p class="tool-kicker">ДОМ И РЕМОНТ · КАЛКУЛАТОР</p>
          <h1>{page.h1}</h1>
          {!embed && <p class="tool-intro">{page.intro}</p>}
        </div>
      </header>

      <section class="tool-layout" aria-label={page.h1} data-material={kind}>
        <form class="tool-form" novalidate>
          <h2>{config ? config.formTitle : adhesive ? 'Площ и плочки' : screed ? 'Площ и дебелина' : insulation ? 'Фасада' : masonry ? 'Стената' : 'Твоята стая'}</h2>
          <p class="tool-form__hint">{config ? config.formHint : adhesive ? 'Плочката е в сантиметри, фугата и дебелината в милиметри. Цените не са задължителни.' : wallpaper ? 'Стаята е в метри, ролката и раппортът в сантиметри. Цената не е задължителна.' : screed ? 'Площта е в м², дебелината в милиметри. Цената не е задължителна.' : insulation ? 'Площите са в м², дебелината в сантиметри. Цената не е задължителна.' : masonry ? 'Стената е в метри, отворите в м². Цената не е задължителна.' : 'Всички мерки са в метри. Цените не са задължителни.'}</p>
          <div class="tool-fields">
            {config?.selects.map((select) => (
              <div class="tool-field" data-show={select.show}>
                <label for={`mat-${select.name}`}>{select.label}</label>
                <select id={`mat-${select.name}`} name={select.name}>
                  {select.options.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
                </select>
              </div>
            ))}
            {mainFields.map((field) => (
              <div class="tool-field" data-show={field.show}>
                <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                <div class="tool-input"><input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min="0" step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} /><span>{field.unit}</span></div>
                {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
              </div>
            ))}
            {masonry && (
              <div class="tool-field">
                <label for="mat-unit">Тухла или блок</label>
                <select id="mat-unit" name="unit">
                  {MASONRY_UNITS.map((unit, index) => <option value={index}>{unit.label}</option>)}
                </select>
              </div>
            )}
            {insulation && (
              <div class="tool-field">
                <label for="mat-board">Плоча</label>
                <select id="mat-board" name="board">
                  {INSULATION_BOARDS.map((board, index) => <option value={index}>{board.label} ({board.area.toLocaleString('bg-BG')} м²)</option>)}
                </select>
              </div>
            )}
            {screed && (
              <div class="tool-field">
                <label for="mat-material">Материал</label>
                <select id="mat-material" name="material">
                  {SCREED_MATERIALS.map((material, index) => <option value={index} data-bag={material.bag}>{material.label} (около {material.kgPerM2PerMm.toLocaleString('bg-BG')} кг/м² на мм)</option>)}
                </select>
              </div>
            )}
            {adhesive && (
              <div class="tool-field">
                <label for="mat-notch">Зъб на маламашката</label>
                <select id="mat-notch" name="notch">
                  <option value="-1">Според размера на плочката</option>
                  {TROWEL_NOTCHES.map((notch, index) => <option value={index}>{notch.mm} мм (около {notch.kgPerM2.toLocaleString('bg-BG')} кг/м²)</option>)}
                </select>
              </div>
            )}
            {kind === 'drywall' && (
              <>
                <div class="tool-field">
                  <label for="mat-sheet">Размер на плоскостта</label>
                  <select id="mat-sheet" name="sheet">
                    {DRYWALL_SHEETS.map((sheet, index) => <option value={index} selected={index === 1}>{sheet.label} ({sheet.area.toLocaleString('bg-BG')} м²)</option>)}
                  </select>
                </div>
                <div class="tool-field">
                  <label for="mat-ceiling">Таван</label>
                  <select id="mat-ceiling" name="ceiling">
                    <option value="0">Само стените</option>
                    <option value="1">Стените и тавана</option>
                  </select>
                </div>
              </>
            )}
          </div>

          {extra && (
          <fieldset class="tool-fieldset">
              <legend>{extra.legend}</legend>
              <div class="tool-field">
                <label for={`mat-${extra.name}`}>{extra.label}</label>
                <select id={`mat-${extra.name}`} name={extra.name} data-extra-toggle>
                  <option value="1">{extra.on}</option>
                  <option value="0">{extra.off}</option>
                </select>
              </div>
              <div class="tool-fields" data-extra-fields>
                {extraFields.map((field) => (
                  <div class="tool-field">
                    <label for={`mat-${field.name}`}>{field.label}{field.optional && <span class="tool-optional"> (по желание)</span>}</label>
                    <div class="tool-input"><input id={`mat-${field.name}`} name={field.name} type="number" inputmode="decimal" min="0" step={field.step ?? 'any'} value={field.optional && field.value === 0 ? '' : field.value} placeholder={field.optional ? '0' : undefined} aria-describedby={field.hint ? `mat-${field.name}-hint` : undefined} /><span>{field.unit}</span></div>
                    {field.hint && <small id={`mat-${field.name}-hint`}>{field.hint}</small>}
                  </div>
                ))}
              </div>
            </fieldset>
          )}
        </form>

        <aside class="tool-result" aria-live="polite">
          <p class="tool-result__kicker">{page.resultTitle ?? 'ТРЯБВАТ ТИ'}</p>
          <p class="tool-result__big"><span data-out="big">–</span> <small data-out="bigUnit" data-one={page.bigOne} data-many={page.big}>{page.big}</small></p>
          <dl data-out="rows"></dl>
          <p class="tool-result__caveat">{page.caveat ?? 'Ориентировъчна сметка. Провери количествата с магазина, преди да купиш.'}</p>
        </aside>
      </section>

      {!embed && (<>
      <section class="tool-notes">
        <article>
          <h2>Как се изчислява</h2>
          <p>{page.how}</p>
          <p class="tool-formula">{page.formula}</p>
          {page.sources && (
            <div class="tool-sources">
              <h3>Източници{page.checked && <span> · проверено {page.checked}</span>}</h3>
              <ul>{page.sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener">{source.label}</a></li>)}</ul>
            </div>
          )}
        </article>
        <article>
          <h2>Съвети</h2>
          <ul>{page.tips.map((tip) => <li>{tip}</li>)}</ul>
          {page.en && <p class="tool-switch"><a href={page.en} hreflang="en">In English, in feet or metres →</a></p>}
        </article>
      </section>

      <section class="tool-embed" aria-labelledby="tool-embed-title">
        <h2 id="tool-embed-title">Вгради калкулатора на твоя сайт</h2>
        <p>Безплатно за блогове, форуми и сайтове на фирми. Постави кода в страницата си и калкулаторът ще работи при теб, с връзка към нас.</p>
        <label class="tool-embed__label" for="embed-code">Код за вграждане</label>
        <textarea id="embed-code" class="tool-embed__code" readonly rows="4" data-embed-code>{embedCode}</textarea>
        <details class="tool-embed__more">
          <summary>Височината да се нагажда сама (по желание)</summary>
          <p>Добави и този ред веднъж в страницата. Тогава рамката става точно колкото калкулатора.</p>
          <textarea class="tool-embed__code" readonly rows="3" aria-label="Скрипт за автоматична височина">{embedResize}</textarea>
        </details>
        <p class="tool-embed__actions">
          <button type="button" class="tool-embed__copy" data-embed-copy>Копирай кода</button>
          <a href={embedPath(page.path)} target="_blank" rel="noopener">Виж как изглежда ↗</a>
        </p>
      </section>

      <RelatedTools lang="bg" id={kind} />

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
          <h2 id="tool-articles-title">Статии по темата</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <img src={`/og/${ogKey(postPath(post))}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
                  <span><strong>{post.data.title}</strong></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      </>)}
    </main>
  </div>
</Layout>

<script>
  import { track } from '@zyankov/design-system/analytics'
  import { estimateAdhesive, estimateAircon, estimateBulk, estimateConcrete, estimateFuelAmount, estimateHeating, estimatePaint, estimateTiles, estimateDrywall, estimateFlooring, estimateInsulation, estimateMasonry, estimateScreed, estimateWallpaper } from '../lib/materials'

  const root = document.querySelector<HTMLElement>('[data-material]')
  if (root) {
    const kind = root.dataset.material
    const form = root.querySelector('form')!
    const field = (name: string) => form.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)
    const num = (name: string) => Math.max(0, Number(field(name)?.value.replace(',', '.')) || 0)
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const fmt = (value: number, digits = 2) => value.toLocaleString('bg-BG', { minimumFractionDigits: 0, maximumFractionDigits: digits })
    const money = (value: number) => `${value.toLocaleString('bg-BG', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} €`
    const unitOut = out('bigUnit')
    let tracked = false

    const render = (big: number | null, rows: [string, string, string?][]) => {
      out('big').textContent = big === null ? '–' : Number.isInteger(big) ? big.toLocaleString('bg-BG') : fmt(big, 2)
      unitOut.textContent = big === 1 ? unitOut.dataset.one ?? '' : unitOut.dataset.many ?? ''
      out('rows').replaceChildren(...rows.map(([label, value, detail]) => {
        const row = document.createElement('div')
        const dt = document.createElement('dt')
        dt.textContent = label
        if (detail) dt.append(Object.assign(document.createElement('small'), { textContent: detail }))
        row.append(dt, Object.assign(document.createElement('dd'), { textContent: value }))
        return row
      }))
    }

    const update = () => {
      const extraOn = root.querySelector<HTMLSelectElement>('[data-extra-toggle]')?.value === '1'
      const extraBox = root.querySelector<HTMLElement>('[data-extra-fields]')
      if (extraBox) extraBox.hidden = !extraOn
      root.querySelectorAll<HTMLElement>('[data-show]').forEach((element) => {
        const [name, value] = (element.dataset.show ?? '').split(':')
        element.hidden = field(name)?.value !== value
      })
      if (kind === 'aircon') {
        const result = estimateAircon({
          area: num('area'), height: num('height'), insulation: Number(field('insulation')?.value ?? 1), climate: Number(field('climate')?.value ?? 1),
          use: field('use')?.value === 'cooling' ? 'cooling' : 'both', sunny: field('sunny')?.value === '1', topFloor: field('topFloor')?.value === '1',
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Нужна мощност', `${fmt(result.needKw, 1)} kW`, `около ${fmt(Math.round(result.needBtu / 100) * 100, 0)} BTU`],
        ]
        if (field('use')?.value !== 'cooling') rows.push(['За отопление', `${fmt(result.heatingKw, 1)} kW`, 'в студените дни'])
        rows.push(['За охлаждане', `${fmt(result.coolingKw, 1)} kW`, 'в горещите дни'])
        if (result.size) rows.push(['Стандартен размер', `${result.size.btu.toLocaleString('bg-BG')} BTU`, `${fmt(result.size.kw, 1)} kW номинално`])
        else rows.push(['Стандартен размер', 'над 24 000 BTU', 'два климатика или мулти сплит система'])
        render(result.size ? result.size.btu : null, rows)
      } else if (kind === 'firewood') {
        const pellets = field('fuel')?.value === 'pellets'
        const result = estimateFuelAmount({
          fuel: pellets ? 'pellets' : 'wood', area: num('area'), heatedShare: num('heatedShare'),
          insulation: Number(field('insulation')?.value ?? 1), climate: Number(field('climate')?.value ?? 1), homeType: Number(field('homeType')?.value ?? 0),
          species: Number(field('species')?.value ?? 0), moisture: Number(field('moisture')?.value ?? 0),
          efficiency: pellets ? num('pelletEfficiency') : num('efficiency'), price: pellets ? num('pelletPrice') : num('woodPrice'),
          pelletKwhPerKg: num('pelletKwh'), bag: num('bag'),
        })
        if (!result) return render(null, [])
        unitOut.dataset.one = pellets ? 'тон пелети' : 'пространствен м³'
        unitOut.dataset.many = pellets ? 'тона пелети' : 'пространствени м³'
        const rows: [string, string, string?][] = [['Нужна топлина', `${fmt(result.demand, 0)} kWh`, 'за целия сезон']]
        if (pellets) {
          rows.push(['Торби', `${result.bags} бр.`, `по ${fmt(num('bag'), 0)} кг`], ['Палети', `${fmt(result.tonnes / 1.05, 1)}`, 'по около 1050 кг'])
        } else {
          rows.push(
            ['Плътни кубици', `${fmt(result.solid, 1)} м³`, 'ако продавачът мери плътно'],
            ['Насипни кубици', `${fmt(result.loose, 1)} м³`, 'нацепени и нахвърлени'],
            ['Тегло', `около ${fmt(result.tonnes, 1)} т`],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(Math.round((pellets ? result.tonnes : result.stacked) * 10) / 10, rows)
      } else if (kind === 'heating') {
        const months = Math.max(1, Math.round(num('months')) || 1)
        const result = estimateHeating({
          area: num('area'), heatedShare: num('heatedShare'), insulation: Number(field('insulation')?.value ?? 1),
          climate: Number(field('climate')?.value ?? 1), homeType: Number(field('homeType')?.value ?? 0), months,
          woodPrice: num('woodPrice'), pelletPrice: num('pelletPrice'), electricityPrice: num('electricityPrice'),
          gasPrice: num('gasPrice'), districtPrice: num('districtPrice'),
        })
        if (!result || !result.cheapest) return render(null, [])
        const rows: [string, string, string?][] = [['Нужна топлина', `${fmt(result.demand, 0)} kWh`, 'за целия сезон']]
        result.options.forEach((option, index) => {
          rows.push([`${index === 0 ? 'Най-евтино: ' : ''}${option.label}`, money(option.cost), `${option.amount} · ${money(option.cost / months)} на месец`])
        })
        render(Math.round(result.cheapest.cost), rows)
      } else if (kind === 'paint') {
        const result = estimatePaint({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'), ceiling: field('ceiling')?.value === '1',
          coats: num('coats'), coverage: num('coverage'), primer: field('primer')?.value === '1', primerCoverage: num('primerCoverage'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [['Площ на стените', `${fmt(result.walls)} м²`]]
        if (result.ceiling > 0) rows.push(['Площ на тавана', `${fmt(result.ceiling)} м²`])
        rows.push(
          ['За боядисване', `${fmt(result.net)} м²`, 'без вратите и прозорците'],
          ['Кофи', result.cans.map((can) => `${can.count} × ${fmt(can.size, 1)} л`).join(' + '), `общо ${fmt(result.bought, 1)} л, с най-малко остатък`],
        )
        if (result.primerLitres > 0) rows.push(['Грунд', `${fmt(result.primerLitres, 1)} л`, 'един слой'])
        if (result.cost > 0) rows.push(['Приблизителна цена на боята', money(result.cost)])
        render(Math.round(result.litres * 10) / 10, rows)
      } else if (kind === 'tile') {
        const result = estimateTiles({
          surface: field('surface')?.value === 'walls' ? 'walls' : 'floor', length: num('length'), width: num('width'),
          wallLength: num('wallLength'), wallHeight: num('wallHeight'), openings: num('openings'), tileLength: num('tileLength'),
          tileWidth: num('tileWidth'), joint: num('joint'), waste: num('waste'), boxArea: num('boxArea'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ', `${fmt(result.area)} м²`],
          ['С фирата', `${fmt(result.withWaste)} м²`],
          ['Плочки', `${result.tiles} бр.`, 'с фугата и фирата'],
          ['Купуваш', `${fmt(result.bought)} м²`, 'закръглено до цели кашони'],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        if (result.boxes > 0) render(result.boxes, rows)
        else render(null, rows)
      } else if (kind === 'concrete') {
        const result = estimateConcrete({
          shape: field('shape')?.value === 'round' ? 'round' : 'slab', length: num('length'), width: num('width'), thickness: num('thickness'),
          diameter: num('diameter'), depth: num('depth'), count: num('count'), waste: num('waste'), mix: Number(field('mix')?.value ?? 1),
          bagYield: num('bagYield'), cementBag: num('cementBag'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Обем', `${fmt(result.volume, 3)} м³`, 'без фирата'],
          ['Поръчка от бетоновоз', `${fmt(result.truck, 1)} м³`, 'закръглено до 0,5 м³'],
          ['Торби сух бетон', `${result.dryBags} бр.`, `по ${fmt(num('bagYield'), 1)} л от торба, за малки обеми`],
          ['Ако бъркаш сам:', ''],
          ['Цимент', `${fmt(result.cementKg, 0)} кг`, `${result.cementBags} торби по ${fmt(num('cementBag'), 0)} кг`],
          ['Пясък', `${fmt(result.sandM3, 2)} м³`, `около ${fmt(result.sandM3 * 1.5, 1)} т`],
          ['Чакъл', `${fmt(result.gravelM3, 2)} м³`, `около ${fmt(result.gravelM3 * 1.6, 1)} т`],
          ['Вода', `${fmt(result.waterL, 0)} л`],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена на готов бетон', money(result.cost)])
        render(result.withWaste, rows)
      } else if (kind === 'gravel') {
        const result = estimateBulk({
          length: num('length'), width: num('width'), depth: num('depth'), material: Number(field('material')?.value ?? 0),
          extra: num('extra'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ', `${fmt(result.area)} м²`],
          ['Обем', `${fmt(result.volume, 2)} м³`, 'без добавката'],
          ['Обем за поръчка', `${fmt(result.withExtra, 2)} м³`, 'с уплътняването и фирата'],
          ['Обемно тегло', `${fmt(result.density, 2)} т/м³`, 'в насипно състояние'],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.tonnes, rows)
      } else if (kind === 'flooring') {
        const trimOn = extraOn
        const result = estimateFlooring({
          length: num('length'), width: num('width'), waste: num('waste'), boxArea: num('boxArea'), price: num('price'),
          trim: trimOn, doorways: num('doorways'), doorWidth: num('doorWidth'), pieceLength: num('pieceLength'),
          insideCorners: num('insideCorners'), outsideCorners: num('outsideCorners'), transitions: num('transitions'), trimPrice: num('trimPrice'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ на пода', `${fmt(result.area)} м²`],
          ['С фирата', `${fmt(result.areaWithWaste)} м²`],
          ['Ламинат в кутиите', `${fmt(result.boughtArea)} м²`, 'закръглено до цели кутии'],
        ]
        if (result.trim) {
          const trim = result.trim
          rows.push(
            ['Периметър на стаята', `${fmt(trim.perimeter)} м`],
            ['Дължина на первазите', `${fmt(trim.baseboardLength)} м`, 'без вратите, с фирата'],
            ['Первази (лайсни)', `${trim.pieces} бр.`],
            ['Вътрешни ъгли', `${trim.insideCorners} бр.`],
          )
          if (trim.outsideCorners > 0) rows.push(['Външни ъгли', `${trim.outsideCorners} бр.`])
          if (trim.endCaps > 0) rows.push(['Крайни капачки', `${trim.endCaps} бр.`, 'където первазът спира до касата'])
          if (trim.connectors > 0) rows.push(['Съединители', `${trim.connectors} бр.`, 'приблизително, по дългите стени'])
        }
        if (result.transitions > 0) rows.push(['Прагове', `${result.transitions} бр.`])
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.boxes, rows)
      } else if (kind === 'masonry') {
        const result = estimateMasonry({
          length: num('length'), height: num('height'), openings: num('openings'), unit: Number(field('unit')?.value ?? 0),
          waste: num('waste'), mortarYield: num('mortarYield'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ на стената', `${fmt(result.net)} м²`, 'без вратите и прозорците'],
          ['Брой на м²', fmt(result.perM2, 1), 'с фугите'],
          ['Разтвор', `${fmt(result.mortarLitres, 0)} л`, result.headJoints ? 'хоризонтални и вертикални фуги, с фирата' : 'само хоризонтални фуги, с фирата'],
          ['Торби разтвор', `${result.bags} бр.`, `по ${fmt(num('mortarYield'), 1)} л от торба`],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.units, rows)
      } else if (kind === 'insulation') {
        const result = estimateInsulation({
          area: num('area'), openings: num('openings'), board: Number(field('board')?.value ?? 0), thickness: num('thickness'),
          waste: num('waste'), supplies: extraOn, price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ за изолиране', `${fmt(result.net)} м²`, 'стените без вратите и прозорците'],
          ['Площ на плочите', `${fmt(result.boardArea)} м²`, 'с фирата, в цели плочи'],
          ['Обем', `${fmt(result.volume, 2)} м³`],
        ]
        if (result.supplies) {
          const s = result.supplies
          rows.push(
            ['Лепило за плочите', `${fmt(s.adhesive, 0)} кг`, 'около 5,5 кг/м²'],
            ['Шпакловка с мрежа', `${fmt(s.baseCoat, 0)} кг`, 'около 4,0 кг/м²'],
            ['Торби лепило-шпакловка', `${s.bags} бр.`, 'по 25 кг, ако е един продукт за двете'],
            ['Мрежа', `${fmt(s.mesh, 0)} м²`, 'с 10% застъпване'],
            ['Дюбели', `${s.anchors} бр.`, 'около 6 на м², повече по ъглите и на височина'],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена на плочите', money(result.cost)])
        render(result.boards, rows)
      } else if (kind === 'screed') {
        const result = estimateScreed({
          area: num('area'), thickness: num('thickness'), material: Number(field('material')?.value ?? 0),
          consumption: num('consumption'), waste: num('waste'), bag: num('bag'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Обем', `${fmt(result.volume, 3)} м³`],
          ['Разход', `${fmt(result.rate, 2)} кг/м² на мм`, result.custom ? 'въведен от теб' : 'типична стойност за материала'],
          ['Суха смес', `${fmt(result.kg, 0)} кг`, 'с фирата'],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.bags, rows)
      } else if (kind === 'wallpaper') {
        const result = estimateWallpaper({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'),
          rollWidth: num('rollWidth'), rollLength: num('rollLength'), repeat: num('repeat'), price: num('price'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Периметър на стаята', `${fmt(result.perimeter)} м`],
          ['Дължина на ивицата', `${fmt(result.drop)} м`, num('repeat') > 0 ? 'височината в цели раппорти, плюс 10 см' : 'височината плюс 10 см за подрязване'],
          ['Ивици', `${result.strips} бр.`, 'вратите и прозорците са извадени по ширина'],
          ['Ивици от една ролка', `${result.stripsPerRoll} бр.`],
        ]
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        rows.push(['Резервна ролка', '+1', 'от същата партида'])
        render(result.rolls, rows)
      } else if (kind === 'adhesive') {
        const result = estimateAdhesive({
          area: num('area'), tileLength: num('tileLength'), tileWidth: num('tileWidth'), thickness: num('thickness'), joint: num('joint'),
          notch: Number(field('notch')?.value ?? -1), waste: num('waste'), adhesiveBag: num('adhesiveBag'), groutBag: num('groutBag'),
          adhesivePrice: num('adhesivePrice'), groutPrice: num('groutPrice'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [
          ['Площ с фирата', `${fmt(result.areaWithWaste)} м²`],
          ['Зъб на маламашката', `${result.notchMm} мм`, result.suggested ? 'според размера на плочката' : undefined],
          ['Лепило', `${fmt(result.adhesive, 1)} кг`, `около ${fmt(result.adhesivePerM2, 1)} кг/м²`],
        ]
        if (result.grout > 0) {
          rows.push(
            ['Фугираща смес', `${fmt(result.grout, 1)} кг`, `около ${fmt(result.groutPerM2, 2)} кг/м²`],
            ['Торби фуга', `${result.groutBags} бр.`, `по ${fmt(num('groutBag'), 1)} кг`],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.adhesiveBags, rows)
      } else {
        const result = estimateDrywall({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'),
          ceiling: field('ceiling')?.value === '1', sheet: Number(field('sheet')?.value ?? 1), waste: num('waste'), price: num('price'),
          supplies: extraOn, studSpacing: num('studSpacing'), profileLength: num('profileLength'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [['Площ на стените', `${fmt(result.walls)} м²`]]
        if (result.ceiling > 0) rows.push(['Площ на тавана', `${fmt(result.ceiling)} м²`])
        rows.push(
          ['Врати и прозорци', `−${fmt(result.openings)} м²`],
          ['За покриване', `${fmt(result.net)} м²`],
          ['С фирата', `${fmt(result.withWaste)} м²`],
          ['Плоскост', result.sheetLabel, 'закръглено до цели плоскости'],
        )
        if (result.supplies) {
          const supplies = result.supplies
          rows.push(
            ['CW профили (стойки)', `${supplies.studs} бр.`, 'само за стените, по една в края на всяка стена'],
            ['CW профили за купуване', `${supplies.studPieces} бр.`],
            ['UW профили (под и таван)', `${fmt(supplies.trackLength, 1)} м`, 'само за стените, с фирата'],
            ['UW профили за купуване', `${supplies.trackPieces} бр.`],
            ['Винтове', `${supplies.screws} бр.`, 'около 11 на м² плоскост'],
            ['Лента за фуги', `${fmt(supplies.tape, 0)} м`, 'фугите и вътрешните ъгли'],
            ['Шпакловка за фуги', `${fmt(supplies.compound, 1)} кг`, 'около 0,5 кг/м² стени и 0,3 кг/м² таван'],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.sheets, rows)
      }
    }

    // Plaster usually comes in 30 kg bags, screed in 25 kg: follow the material unless the user changed the bag.
    const materialSelect = root.querySelector<HTMLSelectElement>('#mat-material')
    const bagInput = root.querySelector<HTMLInputElement>('#mat-bag')
    let bagTouched = false
    bagInput?.addEventListener('input', () => { bagTouched = true })
    materialSelect?.addEventListener('change', () => {
      const bag = materialSelect.selectedOptions[0]?.dataset.bag
      if (bagInput && bag && !bagTouched) bagInput.value = bag
    })

    // Embedded on another site: which site, and whether it is actually used (never the values).
    const embedded = document.documentElement.dataset.embed === '1'
    let host = 'unknown'
    try { host = document.referrer ? new URL(document.referrer).hostname || 'unknown' : 'unknown' } catch { /* keep unknown */ }
    if (embedded) track('embed_view', { calculator: kind ?? '', host, language: 'bg' })

    form.addEventListener('input', () => {
      update()
      if (!tracked) {
        tracked = true
        // Only that the tool was used, never the values.
        track('material_calculate', { kind: kind ?? '', language: 'bg' })
        if (embedded) track('embed_use', { calculator: kind ?? '', host, language: 'bg' })
      }
    })

    const copyButton = document.querySelector<HTMLButtonElement>('[data-embed-copy]')
    const codeBox = document.querySelector<HTMLTextAreaElement>('[data-embed-code]')
    copyButton?.addEventListener('click', async () => {
      if (!codeBox) return
      try {
        await navigator.clipboard.writeText(codeBox.value)
      } catch {
        codeBox.select()
        document.execCommand('copy')
      }
      copyButton.textContent = 'Копирано ✓'
      window.setTimeout(() => { copyButton.textContent = 'Копирай кода' }, 2500)
      track('embed_copy', { calculator: kind ?? '', language: 'bg' })
    })
    form.addEventListener('submit', (event) => event.preventDefault())
    update()
  }
</script>
