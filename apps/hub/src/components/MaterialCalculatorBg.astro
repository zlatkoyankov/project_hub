        <label class="tool-embed__label" for="embed-code">Код за вграждане</label>
        <textarea id="embed-code" class="tool-embed__code" readonly rows="4" data-embed-code>{embedCode}</textarea>
        <details class="tool-embed__more">
          <summary>Височината да се нагажда сама (по желание)</summary>
          <p>Добави и този ред веднъж в страницата. Тогава рамката става точно колкото калкулатора.</p>
          <textarea class="tool-embed__code" readonly rows="3" aria-label="Скрипт за автоматична височина">{embedResize}</textarea>
        </details>
        <p class="tool-embed__actions">
          <button type="button" class="tool-embed__copy" data-embed-copy>Копирай кода</button>
          <a href={embedPath(page.path)} target="_blank" rel="noopener">Виж как изглежда ↗</a>
        </p>
      </section>

      <RelatedTools lang="bg" id={kind} />

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
