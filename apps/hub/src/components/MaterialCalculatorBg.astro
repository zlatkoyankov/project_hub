// Bulgarian, metric material calculators (/bg/kalkulator-laminat/, /bg/kalkulator-beton/, …).
// The English versions live in BuildCalc; the maths is in src/lib/materials.ts.
import BaseLayout from '../layouts/BaseLayout.astro'
import EmbedLayout from '../layouts/EmbedLayout.astro'
