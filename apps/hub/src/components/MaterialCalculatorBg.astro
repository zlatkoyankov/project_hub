          rows.push(
            ['Фугираща смес', `${fmt(result.grout, 1)} кг`, `около ${fmt(result.groutPerM2, 2)} кг/м²`],
            ['Торби фуга', `${result.groutBags} бр.`, `по ${fmt(num('groutBag'), 1)} кг`],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.adhesiveBags, rows)
      } else {
        const result = estimateDrywall({
          length: num('length'), width: num('width'), height: num('height'), openings: num('openings'),
          ceiling: field('ceiling')?.value === '1', sheet: Number(field('sheet')?.value ?? 1), waste: num('waste'), price: num('price'),
          supplies: extraOn, studSpacing: num('studSpacing'), profileLength: num('profileLength'),
        })
        if (!result) return render(null, [])
        const rows: [string, string, string?][] = [['Площ на стените', `${fmt(result.walls)} м²`]]
        if (result.ceiling > 0) rows.push(['Площ на тавана', `${fmt(result.ceiling)} м²`])
        rows.push(
          ['Врати и прозорци', `−${fmt(result.openings)} м²`],
          ['За покриване', `${fmt(result.net)} м²`],
          ['С фирата', `${fmt(result.withWaste)} м²`],
          ['Плоскост', result.sheetLabel, 'закръглено до цели плоскости'],
        )
        if (result.supplies) {
          const supplies = result.supplies
          rows.push(
            ['CW профили (стойки)', `${supplies.studs} бр.`, 'само за стените, по една в края на всяка стена'],
            ['CW профили за купуване', `${supplies.studPieces} бр.`],
            ['UW профили (под и таван)', `${fmt(supplies.trackLength, 1)} м`, 'само за стените, с фирата'],
            ['UW профили за купуване', `${supplies.trackPieces} бр.`],
            ['Винтове', `${supplies.screws} бр.`, 'около 15 на м² плоскост'],
            ['Лента за фуги', `${fmt(supplies.tape, 0)} м`, 'фугите и вътрешните ъгли'],
            ['Шпакловка за фуги', `${fmt(supplies.compound, 1)} кг`, 'около 0,5 кг/м² стени и 0,3 кг/м² таван'],
          )
        }
        if (result.cost > 0) rows.push(['Приблизителна цена', money(result.cost)])
        render(result.sheets, rows)
      }
    }

    // Plaster usually comes in 30 kg bags, screed in 25 kg: follow the material unless the user changed the bag.
    const materialSelect = root.querySelector<HTMLSelectElement>('#mat-material')
    const bagInput = root.querySelector<HTMLInputElement>('#mat-bag')
    let bagTouched = false
    bagInput?.addEventListener('input', () => { bagTouched = true })
    materialSelect?.addEventListener('change', () => {
      const bag = materialSelect.selectedOptions[0]?.dataset.bag
      if (bagInput && bag && !bagTouched) bagInput.value = bag
    })

    // Embedded on another site: which site, and whether it is actually used (never the values).
    const embedded = document.documentElement.dataset.embed === '1'
    let host = 'unknown'
    try { host = document.referrer ? new URL(document.referrer).hostname || 'unknown' : 'unknown' } catch { /* keep unknown */ }
    if (embedded) track('embed_view', { calculator: kind ?? '', host, language: 'bg' })

    form.addEventListener('input', () => {
      update()
      if (!tracked) {
        tracked = true
        // Only that the tool was used, never the values.
        track('material_calculate', { kind: kind ?? '', language: 'bg' })
        if (embedded) track('embed_use', { calculator: kind ?? '', host, language: 'bg' })
      }
    })

    const copyButton = document.querySelector<HTMLButtonElement>('[data-embed-copy]')
    const codeBox = document.querySelector<HTMLTextAreaElement>('[data-embed-code]')
    copyButton?.addEventListener('click', async () => {
      if (!codeBox) return
      try {
        await navigator.clipboard.writeText(codeBox.value)
      } catch {
        codeBox.select()
        document.execCommand('copy')
      }
      copyButton.textContent = 'Копирано ✓'
      window.setTimeout(() => { copyButton.textContent = 'Копирай кода' }, 2500)
      track('embed_copy', { calculator: kind ?? '', language: 'bg' })
    })
    form.addEventListener('submit', (event) => event.preventDefault())

    // Shared links carry the values that differ from the defaults, e.g. ?length=6&thickness=12.
    const controls = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]')]
    const isDefault = (control: HTMLInputElement | HTMLSelectElement) =>
      control instanceof HTMLSelectElement
        ? control.selectedIndex === Math.max(0, [...control.options].findIndex((option) => option.defaultSelected))
        : control.value === control.defaultValue
    const params = new URLSearchParams(window.location.search)
    let restored = false
    for (const control of controls) {
      const value = params.get(control.name)
      if (value === null) continue
      if (control instanceof HTMLSelectElement) {
        if (![...control.options].some((option) => option.value === value)) continue
      } else if (control.type === 'date' ? !/^\d{4}-\d{2}-\d{2}$/.test(value) : !Number.isFinite(Number(value.replace(',', '.')))) continue
      control.value = value
      restored = true
    }
    if (restored) track('material_open_shared', { kind: kind ?? '', language: 'bg' })

    const shareUrl = () => {
      const query = new URLSearchParams()
      for (const control of controls) if (!isDefault(control) && control.value !== '') query.set(control.name, control.value)
      const search = query.toString()
      return `${window.location.origin}${window.location.pathname}${search ? `?${search}` : ''}`
    }
    const status = root.querySelector<HTMLElement>('[data-share-status]')
    const say = (text: string) => {
      if (!status) return
      status.textContent = text
      window.setTimeout(() => { if (status.textContent === text) status.textContent = '' }, 3000)
    }
    const copyText = async (text: string) => {
      try {
        await navigator.clipboard.writeText(text)
        return true
      } catch {
        return false
      }
    }
    root.querySelector('[data-copy-list]')?.addEventListener('click', async () => {
      const lines = [
        `${root.dataset.title ?? document.title} – zyankov.eu`,
        `${root.querySelector('.tool-result__kicker')?.textContent?.trim() ?? ''}: ${out('big').textContent} ${unitOut.textContent}`.trim(),
        ...[...out('rows').querySelectorAll('div')].map((row) => {
          const label = (row.querySelector('dt')?.firstChild?.textContent?.trim() ?? '').replace(/:$/, '')
          const value = row.querySelector('dd')?.textContent?.trim() ?? ''
          const detail = row.querySelector('dt small')?.textContent?.trim()
          return value ? `• ${label}: ${value}${detail ? ` (${detail})` : ''}` : `${label}:`
        }),
        '',
        root.querySelector('.tool-result__caveat')?.textContent?.trim() ?? '',
        shareUrl(),
      ]
      say((await copyText(lines.join('\n'))) ? 'Списъкът е копиран ✓' : 'Не успях да копирам. Маркирай и копирай ръчно.')
      track('material_list_copy', { kind: kind ?? '', language: 'bg' })
    })
    root.querySelector('[data-share-link]')?.addEventListener('click', async () => {
      const url = shareUrl()
      if (navigator.share && window.matchMedia('(pointer: coarse)').matches) {
        try {
          await navigator.share({ title: root.dataset.title ?? document.title, url })
          track('material_share', { kind: kind ?? '', method: 'native', language: 'bg' })
          return
        } catch {
          /* Cancelled or unsupported: fall back to copying. */
        }
      }
      say((await copyText(url)) ? 'Връзката е копирана ✓' : url)
      track('material_share', { kind: kind ?? '', method: 'copy', language: 'bg' })
    })
    update()
  }
</script>
