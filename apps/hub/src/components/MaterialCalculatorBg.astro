---
// Bulgarian, metric material calculators (/bg/kalkulator-laminat/, /bg/kalkulator-beton/, …).
// The English versions live in BuildCalc; the maths is in src/lib/materials.ts.
import BaseLayout from '../layouts/BaseLayout.astro'
import EmbedLayout from '../layouts/EmbedLayout.astro'
import { embedPath } from '../lib/embeds'
import RelatedTools from './RelatedTools.astro'
import '@zyankov/design-system/boards.css'
import { boardFor } from '@zyankov/design-system/boards'
import { getPosts, ogKey, postPath } from '../lib/site'
import { BULK_MATERIALS, CONCRETE_MIXES, DRYWALL_SHEETS, INSULATION_BOARDS, MASONRY_UNITS, SCREED_MATERIALS, TROWEL_NOTCHES } from '../lib/materials'
import { TOOL_ICONS } from '../lib/tools'
import '../styles/tool.css'

type Kind = 'flooring' | 'drywall' | 'adhesive' | 'wallpaper' | 'screed' | 'insulation' | 'masonry' | 'concrete' | 'gravel' | 'paint' | 'tile'

interface Props {
  kind: Kind
  /** Render for an iframe on another site (/bg/vgradi/…): just the calculator. */
  embed?: boolean
}

interface Field {
  name: string
  label: string
  unit: string
  value: number
  step?: string
  hint?: string
  optional?: boolean
  /** Only shown while a select has this value, as "select:value". */
  show?: string
}

interface Select {
  name: string
  label: string
  options: { value: string | number; label: string; selected?: boolean }[]
}

interface Page {
  path: string
  en: string
  tool: string
  title: string
  description: string
  h1: string
  intro: string
  big: string
  bigOne: string
  formula: string
  how: string
  tips: string[]
  jsonName: string
}

/** Newer calculators are described here in one place: page text, form, selects and fields. */
interface Config {
  page: Page
  formTitle: string
  formHint: string
  selects: Select[]
  fields: Field[]
}

