// Static blocks under the calculators, computed at build time with the same functions the calculator uses.
const fmtNumber = (value: number) => value.toLocaleString('bg-BG', { maximumFractionDigits: 2 })
const quickPercent = kind === 'percent'
  ? [
      { question: 'Колко е 15% от 200?', answer: `15% от 200 е 200 × 15 ÷ 100 = ${fmtNumber(percent('of', 15, 200)!.value)}.` },
      { question: 'Колко процента е 45 от 180?', answer: `45 ÷ 180 × 100 = ${fmtNumber(percent('share', 45, 180)!.value)}%, тоест 45 е една четвърт от 180.` },
      { question: 'Как се смята отстъпка?', answer: `Цена 50 € с 20% отстъпка е 50 × (1 − 20 ÷ 100) = ${fmtNumber(percent('add', -20, 50)!.value)} €. Отстъпката е ${fmtNumber(-percent('add', -20, 50)!.extra!)} €.` },
    ]
  : []
// Working days: the example is the Easter week of 2027, where the holidays fall on weekdays.
const WORKDAYS_FROM = '2027-04-26'
const WORKDAYS_TO = '2027-05-10'
const workdaysExample = kind === 'dates'
  ? (() => {
      const span = daysBetween(WORKDAYS_FROM, WORKDAYS_TO)!
      const work = workdaysBetween(WORKDAYS_FROM, WORKDAYS_TO, 'bg')!
      const weekdayHolidays = daysOff(2027).filter((day) => day.date >= WORKDAYS_FROM && day.date < WORKDAYS_TO && ![0, 6].includes(new Date(`${day.date}T12:00:00Z`).getUTCDay()))
      return { days: span.days, weekdays: span.weekdays, workdays: work.workdays, holidays: work.holidays, names: weekdayHolidays.map((day) => `${new Date(`${day.date}T12:00:00Z`).toLocaleDateString('bg-BG', { day: 'numeric', month: 'long', timeZone: 'UTC' })} (${day.name})`) }
    })()
  : null
// BTU by area: the largest whole number of m² for which the calculator still picks that size or a smaller one
// (ceiling 2.6 m, average winter like Sofia, heating and cooling, not under the roof).
const airconAreas = kind === 'aircon'
  ? AIRCON_SIZES.map((size) => ({
      btu: size.btu,
      kw: size.kw,
      areas: [0, 1, 2].map((insulation) => {
        let best = 0
        for (let area = 1; area <= 150; area += 0.5) {
          const estimate = estimateAircon({ area, height: 2.6, insulation, climate: 1, use: 'both', sunny: false, topFloor: false })
          if (estimate?.size && estimate.size.btu <= size.btu) best = area
        }
        return Math.floor(best)
      }),
    }))
  : []
