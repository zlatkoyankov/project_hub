---
// The homepage in English (/) and Bulgarian (/bg/): tool search, the tools by category, latest posts.
import { analyticsEnabled } from '@zyankov/design-system/render'
import { HOME_GROUPS, TOOL_CATALOG, TOOL_ICONS, postCategory } from '../lib/tools'
import { ogKey, postPath, readingMinutes, type Lang, type Post } from '../lib/site'
import '../styles/home.css'

interface Props {
  lang: Lang
  posts: Post[]
}

const { lang, posts } = Astro.props
const bg = lang === 'bg'
const blogPath = bg ? '/bg/blog/' : '/blog/'
const words = TOOL_CATALOG.filter((tool) => tool.category === 'words' && (!tool.only || tool.only === lang))
const home = TOOL_CATALOG.filter((tool) => tool.category === 'home' && (!tool.only || tool.only === lang))
const homeGroups = HOME_GROUPS.map((group) => ({ ...group, items: group.tools.map((id) => home.find((tool) => tool.id === id)).filter((tool): tool is (typeof home)[number] => Boolean(tool)) })).filter((group) => group.items.length > 0)
const wordle = words.find((tool) => tool.id === 'wordle-solver')!
const finder = words.find((tool) => tool.id === 'word-finder')!

const t = bg
  ? {
      kicker: ['БЕЗПЛАТНИ ИНСТРУМЕНТИ', 'БЕЗ РЕГИСТРАЦИЯ'],
      title: ['Малки инструменти.', 'Направени с грижа.'],
      intro: 'Помощници за игри с думи и калкулатори за ремонт, които отговарят добре на един въпрос. Работят в браузъра, на български и английски.',
      searchLabel: 'Търси инструмент',
      searchPlaceholder: 'Какво ти трябва? Напр. „Wordle“ или „бетон“',
      searchButton: 'Намери',
      noMatch: 'Няма такъв инструмент засега. Пиши ни на hello@zyankov.eu с идея.',
      popular: 'Популярни:',
      chips: [['Wordle', '/letterwell/bg/wordle/'], ['Думи от букви', '/letterwell/bg/'], ['Бетон', '/calculators/concrete-calculator/'], ['Боя', '/calculators/paint-calculator/'], ['Плочки', '/calculators/tile-calculator/']],
      art: { wordle: 'ПОМОЩНИК ЗА WORDLE', wordleWord: 'РОЛКА', next: 'Пробвай:', nextWord: 'КАТЕР', concrete: 'КАЛКУЛАТОР ЗА БЕТОН', slab: 'Плоча 3 × 3 м, 10 см', amount: '0,90', unit: 'м³', note: 'Без фира', finder: 'ТЪРСАЧКА ЗА ДУМИ', letters: 'КАРТА', found: 'карта · акт · рак' },
      mineKicker: 'ТВОИТЕ ИНСТРУМЕНТИ',
      mineTitle: 'Любими и последно отворени',
      mineHint: 'Натисни звездичката на някой инструмент, за да го закачиш тук. Пази се само в този браузър.',
      mineClear: 'Изчисти историята',
      recent: 'Последно',
      favAdd: 'Добави в любими',
      favRemove: 'Махни от любими',
      wordsKicker: 'ДУМИ И ИГРИ',
      wordsTitle: 'Намери думата, спечели играта',
      wordsAll: 'Към Letterwell',
      wordsTag: 'БЪЛГАРСКИ И АНГЛИЙСКИ',
      open: 'Отвори',
      new: 'НОВО',
      soon: 'СКОРО',
      homeKicker: 'ДОМ И РЕМОНТ',
      homeTitle: 'Купи точното количество от първия път',
      homeAll: 'Всички калкулатори',
      embedTitle: 'Имаш блог или магазин?',
      embedText: 'Вгради всеки калкулатор на сайта си безплатно.',
      embedLink: 'Вземи кода',
      trust: [
        ['Работи в браузъра', 'Буквите и мерките ти не се изпращат към сървър.'],
        ['Без акаунт и такси', 'Отваряш инструмента и го ползваш. Това е цялата регистрация.'],
        ['Български и английски', 'Инструменти и статии на двата езика, метрични и US мерки.'],
      ],
      blogKicker: 'ОТ БЛОГА',
      blogTitle: 'Статии с примери и изчисления',
      allPosts: 'Всички статии',
      noPosts: 'Скоро тук ще има статии на български.',
      min: 'мин четене',
      categories: { words: 'ДУМИ И ИГРИ', home: 'ДОМ И РЕМОНТ', general: 'ЗА САЙТА' },
      aboutTitle: 'За сайта',
      aboutText: 'Zyankov.eu е независима колекция от практични инструменти, които създавам и поддържам аз, Златко Янков от София. Всеки инструмент обяснява допусканията си, а сигнали за грешки и идеи са винаги добре дошли.',
      aboutLink: 'Повече за мен и сайта',
      faqTitle: 'Често задавани въпроси',
      faq: [
        ['Изпраща ли Letterwell буквите ми към сървър?', 'Не. Letterwell търси в речника директно в браузъра ти. Буквите, които въвеждаш, не се изпращат към Zyankov.eu.'],
        ['Има ли реклами и статистика?', `Да. Страниците показват реклами от Google AdSense, благодарение на които инструментите са безплатни. В ЕС, Великобритания и Швейцария Google първо иска съгласието ти, а изборът може да се промени по всяко време от „Настройки за поверителност“ във footer-а. ${analyticsEnabled ? 'Посещенията се броят с услуга без бисквитки, която никога не вижда буквите или мерките ти.' : 'Не използваме услуга за статистика.'}`],
        ['Работят ли инструментите на телефон?', 'Да. Всички страници са направени за телефон, таблет и компютър.'],
        ['Как да предложа идея или да съобщя за грешка?', 'Пиши на hello@zyankov.eu. Посочи инструмента и накратко какво се случва.'],
      ],
    }
  : {
      kicker: ['FREE BROWSER TOOLS', 'NO SIGN-UP'],
      title: ['Small tools.', 'Made with care.'],
      intro: 'Word game helpers and home-project calculators that answer one question well. Everything runs in your browser, in English and Bulgarian.',
      searchLabel: 'Search tools',
      searchPlaceholder: 'What do you need? Try “Wordle” or “concrete”',
      searchButton: 'Find a tool',
      noMatch: 'No tool for that yet. Send your idea to hello@zyankov.eu.',
      popular: 'Popular:',
      chips: [['Wordle helper', '/letterwell/wordle-solver/'], ['Word finder', '/letterwell/'], ['Concrete', '/calculators/concrete-calculator/'], ['Paint', '/calculators/paint-calculator/'], ['Tiles', '/calculators/tile-calculator/']],
      art: { wordle: 'WORDLE HELPER', wordleWord: 'RAISE', next: 'Try next:', nextWord: 'CLASP', concrete: 'CONCRETE CALCULATOR', slab: '10 × 10 ft slab, 4 in deep', amount: '1.23', unit: 'cu yd', note: 'Before waste allowance', finder: 'WORD FINDER', letters: 'TRIANGLE', found: 'integral · altering · relating' },
      mineKicker: 'YOUR TOOLS',
      mineTitle: 'Favourites and recently opened',
      mineHint: 'Tap the star on any tool to pin it here. It is kept only in this browser.',
      mineClear: 'Clear history',
      recent: 'Recent',
      favAdd: 'Add to favourites',
      favRemove: 'Remove from favourites',
      wordsKicker: 'WORD GAMES',
      wordsTitle: 'Find the word, win the game',
      wordsAll: 'Open Letterwell',
      wordsTag: 'ENGLISH & BULGARIAN',
      open: 'Open',
      new: 'NEW',
      soon: 'SOON',
      homeKicker: 'HOME & DIY',
      homeTitle: 'Buy the right amount, the first time',
      homeAll: 'All calculators',
      embedTitle: 'Have a DIY blog or shop?',
      embedText: 'Embed any calculator on your site for free.',
      embedLink: 'Get the code',
      trust: [
        ['Runs in your browser', 'Your letters and measurements are never sent to a server.'],
        ['No account, no paywall', 'Open a tool and use it. That is the whole sign-up.'],
        ['English and Bulgarian', 'Word tools and guides in both languages, metric and US units.'],
      ],
      blogKicker: 'FROM THE BLOG',
      blogTitle: 'Guides with worked examples',
      allPosts: 'All articles',
      noPosts: 'Articles are on their way.',
      min: 'min read',
      categories: { words: 'WORD GAMES', home: 'HOME & DIY', general: 'ABOUT THE SITE' },
      aboutTitle: 'About the site',
      aboutText: 'Zyankov.eu is an independent collection of practical browser tools, created and maintained by Zlatko Yankov in Sofia, Bulgaria. Every tool explains its assumptions, and feedback about errors and new ideas is always welcome.',
      aboutLink: 'More about me and the site',
      faqTitle: 'Frequently asked questions',
      faq: [
        ['Does Letterwell send my letters to a server?', 'No. Letterwell searches the dictionary in your browser. The letters you enter are not sent to Zyankov.eu.'],
        ['Does Zyankov.eu use advertising or analytics?', `Yes. Pages show ads from Google AdSense, which keeps the tools free. In the EU, the UK and Switzerland, Google asks for your consent first, and you can change your choice at any time with Privacy settings in the footer. ${analyticsEnabled ? 'Visits are counted with a cookieless analytics service that never sees your letters or measurements.' : 'We do not use an analytics service.'}`],
        ['Can I use the tools on my phone?', 'Yes. Every page is designed to work on mobile, tablet and desktop screens.'],
        ['How can I suggest a tool or report a problem?', 'Email hello@zyankov.eu. Please include the tool name and a short description.'],
      ],
    }

const wordleColours = ['absent', 'present', 'absent', 'correct', 'absent']
const tileColours = ['coral', 'yellow', 'blue', 'white', 'mint']
const searchText = (tool: (typeof TOOL_CATALOG)[number]) => `${tool.name.en} ${tool.name.bg} ${tool.keywords}`.toLowerCase()
/** Tools shown in this language, for "Your tools": both language paths match the recently opened pages. */
const mineCatalog = [...words, ...home].filter((tool) => !tool.comingSoon).map((tool) => ({
  id: tool.id,
  name: tool.name[lang],
  description: tool.description[lang],
  href: tool.href[lang],
  paths: [...new Set([tool.href.en, tool.href.bg])],
  icon: tool.icon ? TOOL_ICONS[tool.icon] : '',
}))
const star = (tool: (typeof TOOL_CATALOG)[number]) => `<button class="tool-fav" type="button" data-fav="${tool.id}" aria-pressed="false" aria-label="${t.favAdd}: ${tool.name[lang]}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9Z" /></svg></button>`
---

<div class="home">
  <main id="top">
    <section class="home-hero" aria-labelledby="page-title">
      <div class="home-hero__copy">
        <p class="home-kicker">{t.kicker[0]} <span aria-hidden="true"></span> {t.kicker[1]}</p>
        <h1 id="page-title">{t.title[0]}<br /><em>{t.title[1]}</em></h1>
        <p class="home-hero__intro">{t.intro}</p>
        <form class="tool-search" role="search" data-tool-search>
          <label class="sr-only" for="tool-search">{t.searchLabel}</label>
          <svg class="tool-search__icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <input id="tool-search" type="search" autocomplete="off" placeholder={t.searchPlaceholder} />
          <button class="zy-cta" type="submit">{t.searchButton}</button>
        </form>
        <p class="tool-search__empty" role="status" data-tool-search-empty hidden>{t.noMatch}</p>
        <p class="home-chips"><span>{t.popular}</span>{t.chips.map(([label, href]) => <a class="zy-key" href={href}>{label}</a>)}</p>
      </div>

      <div class="home-hero__art" aria-hidden="true">
        <div class="art-backdrop"></div>
        <div class="art-card art-card--wordle">
          <p class="art-label">{t.art.wordle}</p>
          <div class="art-wordle">{[...t.art.wordleWord].map((letter, index) => <span class={`clue clue--${wordleColours[index]}`}>{letter}</span>)}</div>
          <p class="art-note">{t.art.next} <strong>{t.art.nextWord}</strong></p>
        </div>
        <div class="art-card art-card--result">
          <p class="art-label">{t.art.concrete}</p>
          <p class="art-sub">{t.art.slab}</p>
          <p class="art-amount">{t.art.amount} <span>{t.art.unit}</span></p>
          <p class="art-pill">{t.art.note}</p>
        </div>
        <div class="art-card art-card--finder">
          <p class="art-label">{t.art.finder}</p>
          <div class="art-letters">{[...t.art.letters].map((letter, index) => <span class={`letter zy-gloss letter--${tileColours[index % tileColours.length]}`}>{letter}</span>)}</div>
          <p class="art-note">{t.art.found}</p>
        </div>
      </div>
    </section>

    <section class="home-section home-mine" id="my-tools" aria-labelledby="mine-title" data-my-tools hidden>
      <div class="home-section__head">
        <div>
          <p class="home-section__kicker">{t.mineKicker}</p>
          <h2 id="mine-title">{t.mineTitle}</h2>
        </div>
        <button class="home-section__more home-mine__clear" type="button" data-my-tools-clear>{t.mineClear}</button>
      </div>
      <p class="home-mine__hint">{t.mineHint}</p>
      <ul class="tool-grid" data-my-tools-list></ul>
      <script is:inline type="application/json" data-my-tools-catalog set:html={JSON.stringify(mineCatalog).replace(/</g, '\\u003c')} />
      <script is:inline type="application/json" data-my-tools-strings set:html={JSON.stringify({ recent: t.recent, favAdd: t.favAdd, favRemove: t.favRemove })} />
    </section>

    <section class="home-section" id="word-games" aria-labelledby="words-title">
      <div class="home-section__head">
        <div>
          <p class="home-section__kicker home-section__kicker--coral">{t.wordsKicker}</p>
          <h2 id="words-title">{t.wordsTitle}</h2>
        </div>
        <a class="home-section__more" href={bg ? '/letterwell/bg/' : '/letterwell/'}>{t.wordsAll} <span aria-hidden="true">→</span></a>
      </div>
      <ul class="tool-grid">
        <li class="tool-grid__wide" data-tool={searchText(wordle)}>
          <Fragment set:html={star(wordle)} />
          <a class="feature-tile feature-tile--dark" href={wordle.href[lang]}>
            <div class="feature-tile__body">
              <span class="badge badge--new">{t.new}</span>
              <h3>{wordle.name[lang]}</h3>
              <p>{wordle.description[lang]}</p>
              <span class="feature-tile__cta">{t.open} <span aria-hidden="true">→</span></span>
            </div>
            <div class="feature-tile__board" aria-hidden="true">
              {['absent', 'present', 'absent', 'correct', 'absent', 'correct', 'absent', 'present', 'correct', 'absent', 'correct', 'correct', 'correct', 'correct', 'correct'].map((clue) => <span class={`clue clue--${clue}`}></span>)}
            </div>
          </a>
        </li>
        <li class="tool-grid__wide" data-tool={searchText(finder)}>
          <Fragment set:html={star(finder)} />
          <a class="feature-tile feature-tile--coral" href={finder.href[lang]}>
            <div class="feature-tile__body">
              <span class="feature-tile__tag">{t.wordsTag}</span>
              <h3>{finder.name[lang]}</h3>
              <p>{finder.description[lang]}</p>
              <span class="feature-tile__cta">{t.open} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
        {words.filter((tool) => tool !== wordle && tool !== finder).map((tool) => (
          <li data-tool={searchText(tool)}>
            {!tool.comingSoon && <Fragment set:html={star(tool)} />}
            <a class="tool-tile" href={tool.href[lang]}>
              {tool.icon && <span class="tool-tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={TOOL_ICONS[tool.icon]} /></span>}
              <strong>{tool.name[lang]} {tool.isNew && <span class="badge badge--new">{t.new}</span>}</strong>
              <span>{tool.description[lang]}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-section" id="home-diy" aria-labelledby="home-title">
      <div class="home-section__head">
        <div>
          <p class="home-section__kicker">{t.homeKicker}</p>
          <h2 id="home-title">{t.homeTitle}</h2>
        </div>
        <a class="home-section__more" href="/calculators/all-calculators/">{t.homeAll} <span aria-hidden="true">→</span></a>
      </div>
      {homeGroups.map((group) => (
        <div class="tool-group" id={group.id} data-tool-group>
          <h3 class="tool-group__title">{group.name[lang]}</h3>
          <ul class="tool-grid">
            {group.items.map((tool) => (
              <li data-tool={searchText(tool)}>
                <Fragment set:html={star(tool)} />
                <a class="tool-tile" href={tool.href[lang]}>
                  <span class="tool-tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={TOOL_ICONS[tool.icon!]} /></span>
                  <strong>{tool.name[lang]} {tool.isNew && <span class="badge badge--new">{t.new}</span>}</strong>
                  <span>{tool.description[lang]}</span>
                </a>
              </li>
            ))}
            {group.id === 'energy' && (
              <li data-tool="embed widget website blog shop вграждане сайт блог магазин">
                <a class="tool-tile tool-tile--embed" href="/calculators/concrete-calculator/#embed-title">
                  <strong>{t.embedTitle}</strong>
                  <span>{t.embedText}</span>
                  <span class="tool-tile__cta">{t.embedLink} <span aria-hidden="true">→</span></span>
                </a>
              </li>
            )}
          </ul>
        </div>
      ))}
    </section>

    <section class="trust" aria-label={t.trust[0][0]}>
      {t.trust.map(([title, text], index) => (
        <div class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            {index === 0 && <svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>}
            {index === 1 && <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>}
            {index === 2 && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>}
          </span>
          <div><strong>{title}</strong><p>{text}</p></div>
        </div>
      ))}
    </section>

    <section class="home-section" id="blog" aria-labelledby="blog-title">
      <div class="home-section__head">
        <div>
          <p class="home-section__kicker home-section__kicker--muted">{t.blogKicker}</p>
          <h2 id="blog-title">{t.blogTitle}</h2>
        </div>
        {posts.length > 0 && <a class="home-section__more" href={blogPath}>{t.allPosts} <span aria-hidden="true">→</span></a>}
      </div>
      {posts.length === 0 && <p class="home-empty">{t.noPosts}</p>}
      <ul class="post-cards">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={postPath(post)}>
              <img src={`/og/${ogKey(postPath(post))}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
              <div class="post-card__body">
                <span class={`post-card__category post-card__category--${postCategory(post.data.tool)}`}>{t.categories[postCategory(post.data.tool)]}</span>
                <h3>{post.data.title}</h3>
                <span class="post-card__meta">{readingMinutes(post.body)} {t.min}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="home-about" id="about" aria-labelledby="about-title">
      <div class="home-about__text">
        <h2 id="about-title">{t.aboutTitle}</h2>
        <p>{t.aboutText}</p>
        <a href="/about/">{t.aboutLink} <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-about__faq" id="faq">
        <h2>{t.faqTitle}</h2>
        {t.faq.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
</div>

<script>
  import { track } from '@zyankov/design-system/analytics'

  // "Your tools": favourites (tool ids) and recently opened pages (paths), kept in localStorage on this site.
  interface MineTool { id: string; name: string; description: string; href: string; paths: string[]; icon: string }
  const FAV_KEY = 'zyankov-favourites'
  const RECENT_KEY = 'zyankov-recent'
  const mine = document.querySelector<HTMLElement>('[data-my-tools]')
  const mineList = document.querySelector<HTMLElement>('[data-my-tools-list]')
  const catalog: MineTool[] = JSON.parse(document.querySelector('[data-my-tools-catalog]')?.textContent || '[]')
  const strings = JSON.parse(document.querySelector('[data-my-tools-strings]')?.textContent || '{}')
  const readList = (key: string): string[] => {
    try {
      const value = JSON.parse(localStorage.getItem(key) || '[]')
      return Array.isArray(value) ? value.filter((item) => typeof item === 'string') : []
    } catch {
      return []
    }
  }
  const writeList = (key: string, list: string[]) => {
    try {
      localStorage.setItem(key, JSON.stringify(list))
    } catch {
      /* Storage unavailable: the change lasts only for this page view. */
    }
  }
  const byPath = (path: string) => catalog.find((tool) => tool.paths.includes(path))
  const escapeHtml = (text: string) => text.replace(/[&<>"]/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[char]!)

  function renderMine() {
    if (!mine || !mineList) return
    const favourites = readList(FAV_KEY).map((id) => catalog.find((tool) => tool.id === id)).filter((tool): tool is MineTool => Boolean(tool))
    const recent = readList(RECENT_KEY).map(byPath).filter((tool): tool is MineTool => Boolean(tool) && !favourites.includes(tool!))
    const shown = [...favourites.map((tool) => ({ tool, fav: true })), ...[...new Set(recent)].map((tool) => ({ tool, fav: false }))].slice(0, 8)
    mine.hidden = shown.length === 0
    mineList.innerHTML = shown.map(({ tool, fav }) => `
      <li>
        <button class="tool-fav" type="button" data-fav="${tool.id}" aria-pressed="${fav}" aria-label="${escapeHtml(`${fav ? strings.favRemove : strings.favAdd}: ${tool.name}`)}"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.5 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9Z" /></svg></button>
        <a class="tool-tile" href="${tool.href}">
          ${tool.icon ? `<span class="tool-tile__icon"><svg viewBox="0 0 24 24" aria-hidden="true">${tool.icon}</svg></span>` : ''}
          <strong>${escapeHtml(tool.name)}${fav ? '' : ` <span class="badge badge--recent">${escapeHtml(strings.recent)}</span>`}</strong>
          <span>${escapeHtml(tool.description)}</span>
        </a>
      </li>`).join('')
    const favSet = new Set(favourites.map((tool) => tool.id))
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-fav]')) {
      const on = favSet.has(button.dataset.fav!)
      const name = catalog.find((tool) => tool.id === button.dataset.fav)?.name ?? ''
      button.setAttribute('aria-pressed', String(on))
      button.setAttribute('aria-label', `${on ? strings.favRemove : strings.favAdd}: ${name}`)
    }
  }

  document.addEventListener('click', (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>('[data-fav]')
    if (button) {
      const id = button.dataset.fav!
      const favourites = readList(FAV_KEY)
      const on = favourites.includes(id)
      writeList(FAV_KEY, on ? favourites.filter((item) => item !== id) : [id, ...favourites])
      track(on ? 'favourite_remove' : 'favourite_add', { tool: id })
      renderMine()
      return
    }
    if ((event.target as Element | null)?.closest('[data-my-tools-clear]')) {
      writeList(RECENT_KEY, [])
      renderMine()
    }
  })
  window.addEventListener('storage', (event) => {
    if (event.key === FAV_KEY || event.key === RECENT_KEY) renderMine()
  })
  renderMine()

  // Tool search: filters the tool tiles as you type; Enter opens the first match.
  const form = document.querySelector<HTMLFormElement>('[data-tool-search]')
  const input = form?.querySelector<HTMLInputElement>('input')
  const empty = document.querySelector<HTMLElement>('[data-tool-search-empty]')
  const items = [...document.querySelectorAll<HTMLElement>('[data-tool]')]
  const matches = () => {
    const terms = (input?.value ?? '').toLowerCase().trim().split(/\s+/).filter(Boolean)
    return items.filter((item) => terms.every((term) => (item.dataset.tool ?? '').includes(term)))
  }
  input?.addEventListener('input', () => {
    const found = new Set(matches())
    const searching = Boolean(input.value.trim())
    for (const item of items) item.hidden = searching && !found.has(item)
    for (const group of document.querySelectorAll<HTMLElement>('[data-tool-group]')) {
      group.hidden = searching && ![...group.querySelectorAll<HTMLElement>('[data-tool]')].some((item) => !item.hidden)
    }
    if (empty) empty.hidden = !searching || found.size > 0
    if (mine) mine.classList.toggle('is-searching', searching)
  })
  form?.addEventListener('submit', (event) => {
    event.preventDefault()
    const first = matches().find((item) => item.querySelector('a'))
    const link = first?.querySelector('a')
    if (input?.value.trim() && link) window.location.assign(link.href)
    else document.getElementById('word-games')?.scrollIntoView({ behavior: 'smooth' })
  })
</script>
