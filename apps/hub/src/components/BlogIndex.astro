---
// Blog listing for one language: featured post, category filter and a grid of post cards.
import BaseLayout from '../layouts/BaseLayout.astro'
import { TOOLS, formatDate, isoDate, ogKey, postPath, readingMinutes, type Lang, type Post } from '../lib/site'
import { postCategory } from '../lib/tools'
import '../styles/page.css'
import '../styles/blog.css'

interface Props {
  lang: Lang
  posts: Post[]
}

const { lang, posts } = Astro.props
const bg = lang === 'bg'
const path = bg ? '/bg/blog/' : '/blog/'
const t = bg
  ? { title: 'Блог | Zyankov.eu', h1: 'Блог', kicker: 'СТАТИИ И АНАЛИЗИ', intro: 'Практични статии за думи, игри и ремонти, с примери и изчисления, които можеш да провериш с инструментите на сайта.', min: 'мин четене', empty: 'Все още няма статии на български.', description: 'Статии за думи, игри с думи и изчисления за ремонт, с практични примери и инструменти от Zyankov.eu.', filter: 'Филтър по тема', all: 'Всички', featured: 'ИЗБРАНО', read: 'Прочети', tool: 'Инструмент:', other: ['In English', '/blog/'], categories: { words: 'Думи и игри', home: 'Дом и ремонт', general: 'За сайта' } }
  : { title: 'Blog | Zyankov.eu', h1: 'Blog', kicker: 'GUIDES & ANALYSIS', intro: 'Worked examples for word games and home projects, each tied to a tool you can check it in.', min: 'min read', empty: 'No articles yet.', description: 'Articles about word games and home-improvement estimates, with worked examples and the free tools from Zyankov.eu.', filter: 'Filter by topic', all: 'All', featured: 'FEATURED', read: 'Read the article', tool: 'Tool:', other: ['На български', '/bg/blog/'], categories: { words: 'Word games', home: 'Home & DIY', general: 'About the site' } }
const [featured, ...rest] = posts
const present = new Set(posts.map((post) => postCategory(post.data.tool)))
const filters = (['words', 'home', 'general'] as const).filter((category) => present.has(category))
const cover = (post: Post) => `/og/${ogKey(postPath(post))}.png`
---

<BaseLayout project="blog" title={t.title} description={t.description} path={path} lang={lang} alternates={{ en: '/blog/', bg: '/bg/blog/' }} rss={`${path}rss.xml`} jsonLd={{ '@type': 'Blog', name: t.title }}>
  <div class="blog-page">
    <main id="top">
      <header class="blog-head">
        <div>
          <p class="eyebrow">{t.kicker}</p>
          <h1>{t.h1}</h1>
          <p class="intro">{t.intro}</p>
        </div>
        {posts.length > 1 && (
          <div class="blog-filters" role="group" aria-label={t.filter} data-blog-filters>
            <button type="button" aria-pressed="true" data-filter="all">{t.all}</button>
            {filters.map((category) => <button type="button" aria-pressed="false" data-filter={category}>{t.categories[category]}</button>)}
            <a href={t.other[1]} hreflang={bg ? 'en' : 'bg'}>{t.other[0]}</a>
          </div>
        )}
      </header>

      {posts.length === 0 && <p>{t.empty}</p>}

      {featured && (
        <a class="featured-post" href={postPath(featured)} data-category={postCategory(featured.data.tool)}>
          <img src={cover(featured)} alt="" width="1200" height="630" decoding="async" />
          <div class="featured-post__body">
            <p class="featured-post__kicker">{t.featured} · {t.categories[postCategory(featured.data.tool)]}</p>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <p class="post-meta"><time datetime={isoDate(featured.data.date)}>{formatDate(featured.data.date, lang)}</time> · {readingMinutes(featured.body)} {t.min}</p>
            <span class="featured-post__cta">{t.read} <span aria-hidden="true">→</span>{featured.data.tool && <span class="tool-chip">{t.tool} {TOOLS[featured.data.tool][lang].name}</span>}</span>
          </div>
        </a>
      )}

      <ul class="post-grid">
        {rest.map((post) => (
          <li data-category={postCategory(post.data.tool)}>
            <a class="post-tile" href={postPath(post)}>
              <img src={cover(post)} alt="" width="1200" height="630" loading="lazy" decoding="async" />
              <div class="post-tile__body">
                <span class={`post-tile__category post-tile__category--${postCategory(post.data.tool)}`}>{t.categories[postCategory(post.data.tool)]}</span>
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
                <span class="post-meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time> · {readingMinutes(post.body)} {t.min}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>

<script>
  // Topic filter: shows only the posts of the chosen category (the featured post included).
  const group = document.querySelector<HTMLElement>('[data-blog-filters]')
  const buttons = [...(group?.querySelectorAll<HTMLButtonElement>('button[data-filter]') ?? [])]
  const posts = [...document.querySelectorAll<HTMLElement>('[data-category]')]
  for (const button of buttons) {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter
      for (const other of buttons) other.setAttribute('aria-pressed', String(other === button))
      for (const post of posts) post.hidden = filter !== 'all' && post.dataset.category !== filter
    })
  }
</script>
