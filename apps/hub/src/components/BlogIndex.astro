---
// Blog listing for one language.
import BaseLayout from '../layouts/BaseLayout.astro'
import { formatDate, isoDate, postPath, readingMinutes, type Lang, type Post } from '../lib/site'
import '../styles/page.css'
import '../styles/blog.css'

interface Props {
  lang: Lang
  posts: Post[]
}

const { lang, posts } = Astro.props
const bg = lang === 'bg'
const path = bg ? '/bg/blog/' : '/blog/'
const t = bg
  ? { title: 'Блог | Zyankov.eu', h1: 'Блог', kicker: 'СТАТИИ', intro: 'Практични статии за думи, игри и ремонти, с примери и изчисления, които можеш да провериш с инструментите на сайта.', min: 'мин четене', empty: 'Все още няма статии на български.', description: 'Статии за думи, игри с думи и изчисления за ремонт, с практични примери и инструменти от Zyankov.eu.' }
  : { title: 'Blog | Zyankov.eu', h1: 'Blog', kicker: 'ARTICLES', intro: 'Practical articles about words, word games and home projects, with worked examples you can check in the tools on this site.', min: 'min read', empty: 'No articles yet.', description: 'Articles about word games and home-improvement estimates, with worked examples and the free tools from Zyankov.eu.' }
---

<BaseLayout project="blog" title={t.title} description={t.description} path={path} lang={lang} alternates={{ en: '/blog/', bg: '/bg/blog/' }} rss={`${path}rss.xml`} jsonLd={{ '@type': 'Blog', name: t.title }}>
  <div class="page">
    <main id="top">
      <p class="eyebrow">{t.kicker}</p>
      <h1>{t.h1}</h1>
      <p class="intro">{t.intro}</p>
      {posts.length === 0 && <p>{t.empty}</p>}
      <ul class="post-index">
        {posts.map((post) => (
          <li>
            <a href={postPath(post)}><h2>{post.data.title}</h2></a>
            <p class="post-meta"><time datetime={isoDate(post.data.date)}>{formatDate(post.data.date, lang)}</time> · {readingMinutes(post.body)} {t.min}</p>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </main>
  </div>
</BaseLayout>
