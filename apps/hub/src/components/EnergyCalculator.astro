---
// Appliance energy cost calculator, English (/energy-cost-calculator/) and Bulgarian (/bg/razhod-na-tok/).
import BaseLayout from '../layouts/BaseLayout.astro'
import RelatedTools from './RelatedTools.astro'
import '@zyankov/design-system/boards.css'
import { AUTHOR, formatDate, getPosts, ogKey, postPath, readingMinutes, type Lang } from '../lib/site'
import '../styles/tool.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const bg = lang === 'bg'
const path = bg ? '/bg/razhod-na-tok/' : '/energy-cost-calculator/'
const alternates = { en: '/energy-cost-calculator/', bg: '/bg/razhod-na-tok/' }

// Typical ratings only: the page tells people to check the label on their own appliance.
const presets: { id: string; en: string; bg: string; watts: number; hours: number; load: number }[] = [
  { id: 'heater', en: 'Space heater (fan heater)', bg: 'Вентилаторна печка (духалка)', watts: 2000, hours: 6, load: 100 },
  { id: 'radiator', en: 'Oil-filled radiator', bg: 'Маслен радиатор', watts: 1500, hours: 8, load: 100 },
  { id: 'ac', en: 'Air conditioner, heating', bg: 'Климатик, отопление', watts: 1000, hours: 8, load: 100 },
  { id: 'boiler', en: 'Electric water heater (boiler)', bg: 'Бойлер', watts: 3000, hours: 2, load: 100 },
  { id: 'oven', en: 'Electric oven', bg: 'Фурна', watts: 2200, hours: 1, load: 100 },
  { id: 'kettle', en: 'Kettle', bg: 'Електрическа кана', watts: 2200, hours: 0.25, load: 100 },
  { id: 'washer', en: 'Washing machine', bg: 'Перална машина', watts: 700, hours: 1, load: 100 },
  { id: 'dishwasher', en: 'Dishwasher', bg: 'Съдомиялна', watts: 1400, hours: 1, load: 100 },
  { id: 'fridge', en: 'Fridge-freezer', bg: 'Хладилник', watts: 100, hours: 24, load: 25 },
  { id: 'tv', en: 'TV', bg: 'Телевизор', watts: 100, hours: 4, load: 100 },
  { id: 'pc', en: 'Desktop computer', bg: 'Настолен компютър', watts: 140, hours: 6, load: 100 },
  { id: 'led', en: 'LED bulb', bg: 'LED крушка', watts: 8, hours: 5, load: 100 },
]

/** Where the preset power ratings and the example prices come from. Hours of use are only examples. */
const sources: { bg: string; en: string; href: string }[] = [
  { bg: 'Centre for Sustainable Energy: мощност на уредите (печки, радиатор, бойлер, фурна, кана, хладилник, компютър)', en: 'Centre for Sustainable Energy: appliance power ratings (heaters, radiator, immersion heater, oven, kettle, fridge, computer)', href: 'https://www.nea.org.uk/wp-content/uploads/2021/07/advice_leaflet_what_uses_watt.pdf' },
  { bg: 'Electric Ireland: телевизор около 0,1 kWh на час, съдомиялна около 1,5 kWh на цикъл, хладилник клас C 171 kWh на година', en: 'Electric Ireland: TV about 0.1 kWh per hour, dishwasher about 1.5 kWh per cycle, C-rated fridge-freezer 171 kWh a year', href: 'https://prd-cdn.electricireland.ie/media/docs/default-source/know-your-energy/know-your-energy-booklet.pdf' },
  { bg: 'Mitsubishi Heavy SRK35ZS: климатик 12000 BTU, 0,94 kW консумация при отопление', en: 'Mitsubishi Heavy SRK35ZS: 12,000 BTU air conditioner, 0.94 kW input when heating', href: 'https://editor.alleop.bg/en/air-conditioners/25131-mitsubishi-heavy-industries-srk35zs-wb-src35zs-w-inverter-air-conditioner-12000-btu-25-m-a-a-allergen-free-r-32-white-black-4961317391020.html' },
  { bg: 'Philips LED A60: 8 W за 806 lm (замества 60 W)', en: 'Philips LED A60: 8 W for 806 lm (replaces 60 W)', href: 'https://www.onninen.fi/en/philips-led-bulb-e27-830-806lm-60w-8w-a60-fr/p/DAA752?term=EI' },
  { bg: 'ЕНЕРГО-ПРО: цени на тока от 1 юли 2026 г.', en: 'ENERGO-PRO (Bulgaria): electricity prices from 1 July 2026', href: 'https://www.energo-pro.bg/en/novini/kevr-utvrdi-novi-ceni-na-elektroenergiyata-ot-1-yuli-2026-g' },
  { bg: 'EIA: средна цена на тока за домакинства в САЩ', en: 'EIA: average US residential electricity price', href: 'https://www.eia.gov/electricity/monthly/epm_table_grapher.php?t=epmt_5_6_a' },
]
const start = presets[0]

const t = bg
  ? {
      title: 'Калкулатор за разход на ток: колко струва уредът | Zyankov.eu',
      description: 'Изчисли колко киловатчаса харчи печката, климатикът или бойлерът и колко струва на ден, месец и година при твоята цена на тока.',
      crumbs: ['Начало', 'Дом и ремонт'],
      kicker: 'ДОМ И ЕНЕРГИЯ',
      h1: 'Колко ток харчи уредът?',
      intro: 'Избери уред или въведи мощността му, колко часа работи и цената на тока от сметката. Виждаш разхода в kWh и в пари на ден, месец и година.',
      form: 'Твоят уред',
      formHint: 'Стойностите по подразбиране са типични. Мощността на твоя уред е на етикета му.',
      appliance: 'Уред',
      custom: 'Друг уред',
      watts: 'Мощност',
      hours: 'Часа на ден',
      days: 'Дни в месеца',
      load: 'Средно натоварване',
      loadHint: 'Намали за уреди с термостат (хладилник, печка, бойлер), които се включват и изключват.',
      price: 'Цена за kWh',
      priceHint: 'Виж сметката си. Пример: дневната тарифа на ЕНЕРГО-ПРО от 1 юли 2026 г. е 0,12927 € за kWh.',
      currency: 'Валута',
      result: 'ПРИБЛИЗИТЕЛЕН РАЗХОД',
      perMonth: 'на месец',
      rows: ['На ден', 'На година', 'За един час работа', 'Енергия на ден', 'Енергия на месец', 'Енергия на година'],
      caveat: 'Приблизителна оценка. Реалната консумация зависи от модела, настройките и помещението.',
      howTitle: 'Как се изчислява',
      how: 'Мощността във ватове се дели на 1000, за да стане в киловати, и се умножава по часовете работа и средното натоварване. Така се получават киловатчасове (kWh), а те се умножават по цената за kWh.',
      tipsTitle: 'Как да намалиш сметката',
      tips: ['Ползвай нощната тарифа за бойлера, пералнята и съдомиялната, ако имаш двутарифен електромер.', 'За отопление климатикът обикновено харчи по-малко ток от духалка или маслен радиатор за същата топлина.', 'Термостатът и затворените врати пестят повече от всяка настройка на самия уред.'],
      articles: 'Статии по темата',
      min: 'мин четене',
      currencyDefault: '€',
      priceDefault: '0.13',
      name: 'Име в списъка',
      qty: 'Брой',
      qtyUnit: 'бр.',
      add: 'Добави към списъка',
      added: 'Добавено ✓',
      listTitle: 'Моят списък с уреди',
      listHint: 'Добави уредите един по един и сравни общата сума със сметката си. Махни отметката, за да изключиш уред от сумата. Списъкът се пази само в този браузър.',
      empty: 'Списъкът е празен. Сметни уред по-горе и натисни „Добави към списъка“.',
      cols: ['В сумата', 'Уред', 'kWh на месец', 'На месец'],
      include: 'Включи в сумата',
      remove: 'Махни',
      total: 'Общо',
      perYear: 'на година',
      bill: 'Сметката ми за месеца',
      billHint: 'Сумата за ток от последната фактура, без такси, ако искаш точно сравнение.',
      billCompare: (share: string) => `Списъкът обяснява около ${share} от сметката ти.`,
      billOver: (share: string) => `Списъкът е с ${share} над сметката ти. Може би някой уред работи по-малко, отколкото си въвел.`,
      clear: 'Изчисти списъка',
    }
  : {
      title: 'Electricity Cost Calculator: What Does a Heater Cost to Run? | Zyankov.eu',
      description: 'What a space heater, air conditioner or water heater costs to run: enter the watts and your price per kWh to see the cost per hour, day, month and year.',
      answer: 'A 1,500 W space heater uses 1.5 kWh an hour. At the US average of 18.83¢ per kWh (EIA, April 2026) that is about 28¢ an hour; a 750 W heater costs about 14¢ and a 2 kW heater about 38¢. Running 8 hours a day for 30 days, the 1,500 W heater costs about $68 a month.',
      crumbs: ['Home', 'Home & DIY'],
      kicker: 'HOME & ENERGY',
      h1: 'What does it cost to run?',
      intro: 'Pick an appliance or enter its power, how long it runs and the price on your bill. See the energy in kWh and the cost per day, month and year.',
      form: 'Your appliance',
      formHint: 'The defaults are typical values. Your appliance’s power is on its rating label.',
      appliance: 'Appliance',
      custom: 'Other appliance',
      watts: 'Power',
      hours: 'Hours per day',
      days: 'Days per month',
      load: 'Average load',
      loadHint: 'Lower it for appliances a thermostat switches on and off, such as fridges, heaters and water heaters.',
      price: 'Price per kWh',
      priceHint: 'Check your bill. The US residential average was 18.83¢ per kWh in April 2026 (EIA).',
      currency: 'Currency',
      result: 'ESTIMATED COST',
      perMonth: 'per month',
      rows: ['Per day', 'Per year', 'Per hour of use', 'Energy per day', 'Energy per month', 'Energy per year'],
      caveat: 'Planning estimate. Real use depends on the model, its settings and the room.',
      howTitle: 'How it works',
      how: 'Power in watts is divided by 1,000 to get kilowatts, then multiplied by the hours the appliance runs and its average load. That gives kilowatt-hours (kWh), which are multiplied by your price per kWh.',
      tipsTitle: 'Ways to cut the cost',
      tips: ['Run water heaters, washing machines and dishwashers on a cheaper night rate if your tariff has one.', 'For heating, an air conditioner (heat pump) usually uses less electricity than a fan heater or radiator for the same warmth.', 'A thermostat and closed doors save more than any setting on the appliance itself.'],
      articles: 'Related articles',
      min: 'min read',
      currencyDefault: '$',
      priceDefault: '0.19',
      name: 'Name in your list',
      qty: 'How many',
      qtyUnit: 'pcs',
      add: 'Add to my list',
      added: 'Added ✓',
      listTitle: 'My appliance list',
      listHint: 'Add appliances one by one and compare the total with your bill. Untick an appliance to leave it out of the total. The list is kept only in this browser.',
      empty: 'Your list is empty. Work out an appliance above and press “Add to my list”.',
      cols: ['In total', 'Appliance', 'kWh per month', 'Per month'],
      include: 'Include in the total',
      remove: 'Remove',
      total: 'Total',
      perYear: 'per year',
      bill: 'My monthly bill',
      billHint: 'The electricity amount on your last bill, without fixed fees, for a fair comparison.',
      billCompare: (share: string) => `Your list explains about ${share} of your bill.`,
      billOver: (share: string) => `Your list comes to ${share} more than your bill. Some appliance may run less than you entered.`,
      clear: 'Clear the list',
    }

const posts = (await getPosts(lang)).filter((post) => post.data.tool === 'energy-cost-calculator')
// When the presets, prices and sources were last checked: shown on the page and in dateModified.
const CHECKED = '2026-11-07'
const checkedText = formatDate(new Date(CHECKED), lang)
const jsonLd = {
  '@type': 'WebApplication',
  name: bg ? 'Калкулатор за разход на ток' : 'Appliance energy cost calculator',
  description: t.description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  inLanguage: lang,
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  author: AUTHOR,
  publisher: AUTHOR,
  dateModified: CHECKED,
}
---

<BaseLayout title={t.title} description={t.description} path={path} lang={lang} alternates={alternates} project="buildcalc" jsonLd={jsonLd} breadcrumbs={[{ name: t.crumbs[0], path: bg ? '/bg/' : '/' }, { name: jsonLd.name, path }]}>
  <div class="tool-page zy-board" data-board={'blueprint'}>
    <main id="top">
      <nav class="tool-crumbs" aria-label="Breadcrumb"><a href={bg ? '/bg/' : '/'}>{t.crumbs[0]}</a><span aria-hidden="true">/</span><a href={bg ? '/bg/#home-diy' : '/#home-diy'}>{t.crumbs[1]}</a></nav>
      <header class="tool-head">
        <span class="tool-head__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M13 2 4 14h7l-1 8 9-12h-7z" /></svg></span>
        <div>
          <p class="tool-kicker">{t.kicker}</p>
          <h1>{t.h1}</h1>
          <p class="tool-intro">{t.intro}</p>
          {'answer' in t && t.answer && <p class="tool-answer"><strong>In short:</strong> {t.answer}</p>}
        </div>
      </header>

      <section class="tool-layout" aria-label={t.h1} data-energy data-lang={lang}>
        <form class="tool-form" novalidate>
          <h2>{t.form}</h2>
          <p class="tool-form__hint">{t.formHint}</p>
          <div class="tool-field tool-field--wide">
            <label for="energy-appliance">{t.appliance}</label>
            <select id="energy-appliance" name="appliance">
              {presets.map((preset) => (
                <option value={preset.id} data-watts={preset.watts} data-hours={preset.hours} data-load={preset.load} data-name={bg ? preset.bg : preset.en}>{bg ? preset.bg : preset.en}</option>
              ))}
              <option value="custom">{t.custom}</option>
            </select>
          </div>
          <div class="tool-fields">
            <div class="tool-field">
              <label for="energy-name">{t.name}</label>
              <div class="tool-input"><input id="energy-name" name="name" type="text" maxlength="40" value={bg ? start.bg : start.en} /></div>
            </div>
            <div class="tool-field">
              <label for="energy-qty">{t.qty}</label>
              <div class="tool-input"><input id="energy-qty" name="qty" type="number" inputmode="numeric" min="1" max="99" step="1" value="1" /><span>{t.qtyUnit}</span></div>
            </div>
            <div class="tool-field">
              <label for="energy-watts">{t.watts}</label>
              <div class="tool-input"><input id="energy-watts" name="watts" type="number" inputmode="decimal" min="0" step="any" value={start.watts} /><span>W</span></div>
            </div>
            <div class="tool-field">
              <label for="energy-hours">{t.hours}</label>
              <div class="tool-input"><input id="energy-hours" name="hours" type="number" inputmode="decimal" min="0" max="24" step="any" value={start.hours} /><span>h</span></div>
            </div>
            <div class="tool-field">
              <label for="energy-days">{t.days}</label>
              <div class="tool-input"><input id="energy-days" name="days" type="number" inputmode="numeric" min="1" max="31" step="1" value="30" /><span>{bg ? 'дни' : 'days'}</span></div>
            </div>
            <div class="tool-field">
              <label for="energy-load">{t.load}</label>
              <div class="tool-input"><input id="energy-load" name="load" type="number" inputmode="numeric" min="1" max="100" step="1" value={start.load} aria-describedby="energy-load-hint" /><span>%</span></div>
              <small id="energy-load-hint">{t.loadHint}</small>
            </div>
            <div class="tool-field">
              <label for="energy-price">{t.price}</label>
              <div class="tool-input"><input id="energy-price" name="price" type="number" inputmode="decimal" min="0" step="any" value={t.priceDefault} aria-describedby="energy-price-hint" /><span data-energy-currency-label>{t.currencyDefault}</span></div>
              <small id="energy-price-hint">{t.priceHint}</small>
            </div>
            <div class="tool-field">
              <label for="energy-currency">{t.currency}</label>
              <select id="energy-currency" name="currency">
                {['€', '$', '£'].map((symbol) => <option value={symbol} selected={symbol === t.currencyDefault}>{symbol}</option>)}
              </select>
            </div>
          </div>
        </form>

        <aside class="tool-result" aria-live="polite">
          <p class="tool-result__kicker">{t.result}</p>
          <p class="tool-result__big"><span data-out="month">–</span> <small>{t.perMonth}</small></p>
          <dl>
            <div><dt>{t.rows[0]}</dt><dd data-out="day">–</dd></div>
            <div><dt>{t.rows[1]}</dt><dd data-out="year">–</dd></div>
            <div><dt>{t.rows[2]}</dt><dd data-out="hour">–</dd></div>
            <div><dt>{t.rows[3]}</dt><dd data-out="kwhDay">–</dd></div>
            <div><dt>{t.rows[4]}</dt><dd data-out="kwhMonth">–</dd></div>
            <div><dt>{t.rows[5]}</dt><dd data-out="kwhYear">–</dd></div>
          </dl>
          <button class="zy-cta energy-add" type="button" data-energy-add data-added={t.added}>+ {t.add}</button>
          <p class="tool-result__caveat">{t.caveat}</p>
        </aside>
      </section>

      <section class="energy-list" aria-labelledby="energy-list-title" data-energy-list
        data-include={t.include} data-remove={t.remove} data-bill-under={t.billCompare('{share}')} data-bill-over={t.billOver('{share}')} data-per-year={t.perYear}>
        <div class="energy-list__head">
          <div>
            <h2 id="energy-list-title">{t.listTitle}</h2>
            <p>{t.listHint}</p>
          </div>
          <button class="zy-key energy-list__clear" type="button" data-energy-clear hidden>{t.clear}</button>
        </div>
        <p class="energy-list__empty" data-energy-empty>{t.empty}</p>
        <div class="energy-list__table" data-energy-table hidden>
          <table>
            <thead><tr><th scope="col">{t.cols[0]}</th><th scope="col">{t.cols[1]}</th><th scope="col">{t.cols[2]}</th><th scope="col">{t.cols[3]}</th><th scope="col"><span class="sr-only">{t.remove}</span></th></tr></thead>
            <tbody data-energy-rows></tbody>
            <tfoot>
              <tr><th scope="row" colspan="2">{t.total}</th><td data-energy-total-kwh>–</td><td><strong data-energy-total>–</strong><small data-energy-total-year></small></td><td></td></tr>
            </tfoot>
          </table>
        </div>
        <div class="energy-bill" data-energy-billbox hidden>
          <div class="tool-field">
            <label for="energy-bill">{t.bill}</label>
            <div class="tool-input"><input id="energy-bill" type="number" inputmode="decimal" min="0" step="any" aria-describedby="energy-bill-hint" /><span data-energy-bill-currency>{t.currencyDefault}</span></div>
            <small id="energy-bill-hint">{t.billHint}</small>
          </div>
          <p class="energy-bill__result" data-energy-bill-result aria-live="polite"></p>
        </div>
      </section>

      <section class="tool-notes">
        <article>
          <h2>{t.howTitle}</h2>
          <p>{t.how}</p>
          <p class="tool-formula">kWh = W ÷ 1000 × h × load</p>
          <div class="tool-sources">
            <h3>{bg ? 'Източници' : 'Sources'}<span> · {bg ? 'проверено' : 'checked'} {checkedText}</span></h3>
            <ul>{sources.map((source) => <li><a href={source.href} target="_blank" rel="noopener">{bg ? source.bg : source.en}</a></li>)}</ul>
            <p>{bg ? 'Пералнята (0,7 kWh на цикъл) е наша оценка: зависи силно от програмата. Часовете по подразбиране са само пример.' : 'The washing machine (0.7 kWh per cycle) is our estimate: it depends heavily on the programme. Default hours are only examples.'}</p>
          </div>
        </article>
        <article>
          <h2>{t.tipsTitle}</h2>
          <ul>{t.tips.map((tip) => <li>{tip}</li>)}</ul>
        </article>
      </section>

      <RelatedTools lang={lang} id="energy" />

      {posts.length > 0 && (
        <section class="tool-articles" aria-labelledby="tool-articles-title">
          <h2 id="tool-articles-title">{t.articles}</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <a href={postPath(post)}>
                  <img src={`/og/${ogKey(postPath(post))}.png`} alt={post.data.title} width="1200" height="630" loading="lazy" decoding="async" />
                  <span><strong>{post.data.title}</strong><small>{readingMinutes(post.body)} {t.min}</small></span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>
  </div>
</BaseLayout>

<script>
  import { track } from '@zyankov/design-system/analytics'

  // Live calculation: every change updates the result card.
  const root = document.querySelector<HTMLElement>('[data-energy]')
  if (root) {
    const lang = root.dataset.lang === 'bg' ? 'bg' : 'en'
    const locale = lang === 'bg' ? 'bg-BG' : 'en-GB'
    const field = (name: string) => root.querySelector<HTMLInputElement | HTMLSelectElement>(`[name="${name}"]`)!
    const out = (name: string) => root.querySelector<HTMLElement>(`[data-out="${name}"]`)!
    const currencyLabel = root.querySelector<HTMLElement>('[data-energy-currency-label]')!
    const number = (name: string) => Math.max(0, Number(field(name).value) || 0)
    const money = (value: number) => {
      const symbol = field('currency').value
      const digits = value < 1 ? 3 : 2
      const amount = value.toLocaleString(locale, { minimumFractionDigits: 2, maximumFractionDigits: digits })
      return symbol === '€' ? `${amount} €` : `${symbol}${amount}`
    }
    const kwh = (value: number) => `${value.toLocaleString(locale, { maximumFractionDigits: value < 10 ? 2 : 0 })} kWh`
    let tracked = false

    const update = () => {
      const watts = number('watts')
      const hours = Math.min(24, number('hours'))
      const days = Math.min(31, Math.max(1, number('days')))
      const load = Math.min(100, number('load')) / 100
      const price = number('price')
      const perDay = (watts / 1000) * hours * load * Math.min(99, Math.max(1, Math.round(number('qty')) || 1))
      currencyLabel.textContent = field('currency').value
      out('month').textContent = money(perDay * days * price)
      out('day').textContent = money(perDay * price)
      out('year').textContent = money(perDay * 365 * price)
      out('hour').textContent = money((watts / 1000) * load * price * Math.min(99, Math.max(1, Math.round(number('qty')) || 1)))
      out('kwhDay').textContent = kwh(perDay)
      out('kwhMonth').textContent = kwh(perDay * days)
      out('kwhYear').textContent = kwh(perDay * 365)
    }

    field('appliance').addEventListener('change', () => {
      const option = (field('appliance') as HTMLSelectElement).selectedOptions[0]
      if (option?.dataset.watts) {
        field('name').value = option.dataset.name ?? ''
        field('watts').value = option.dataset.watts
        field('hours').value = option.dataset.hours ?? '1'
        field('load').value = option.dataset.load ?? '100'
      }
      update()
    })
    root.querySelector('form')!.addEventListener('input', (event) => {
      const name = (event.target as HTMLInputElement).name
      if (name === 'watts' || name === 'hours' || name === 'load') (field('appliance') as HTMLSelectElement).value = 'custom'
      if (name === 'currency') renderList()
      update()
      if (!tracked) {
        tracked = true
        // Only that the tool was used, never the values.
        track('energy_calculate', { language: lang })
      }
    })
    root.querySelector('form')!.addEventListener('submit', (event) => event.preventDefault())

    // ── My appliance list: add the current appliance, tick what counts, compare with the bill.
    interface Item { id: string; name: string; qty: number; watts: number; hours: number; load: number; kwhMonth: number; costMonth: number; include: boolean }
    const STORE = 'zyankov-energy-list'
    const list = document.querySelector<HTMLElement>('[data-energy-list]')!
    const rows = list.querySelector<HTMLElement>('[data-energy-rows]')!
    const billInput = list.querySelector<HTMLInputElement>('#energy-bill')!
    const show = (selector: string, visible: boolean) => { list.querySelector<HTMLElement>(selector)!.hidden = !visible }
    const load = (): Item[] => {
      try { return JSON.parse(localStorage.getItem(STORE) ?? '[]') as Item[] } catch { return [] }
    }
    const save = () => {
      try { localStorage.setItem(STORE, JSON.stringify(items)) } catch { /* private mode: the list lasts for this visit */ }
    }
    let items = load()
    const fmt = (value: number, digits = 1) => value.toLocaleString(locale, { maximumFractionDigits: digits })

    function renderList() {
      rows.replaceChildren(...items.map((item) => {
        const row = document.createElement('tr')
        if (!item.include) row.className = 'is-off'
        const check = document.createElement('input')
        check.type = 'checkbox'
        check.checked = item.include
        check.setAttribute('aria-label', `${list.dataset.include}: ${item.name}`)
        check.addEventListener('change', () => { item.include = check.checked; save(); renderList() })
        const remove = document.createElement('button')
        remove.type = 'button'
        remove.className = 'energy-remove'
        remove.textContent = '×'
        remove.setAttribute('aria-label', `${list.dataset.remove}: ${item.name}`)
        remove.addEventListener('click', () => { items = items.filter((other) => other.id !== item.id); save(); renderList() })
        const cells = [
          check,
          Object.assign(document.createElement('span'), { className: 'energy-name', textContent: `${item.qty > 1 ? `${item.qty} × ` : ''}${item.name}` }),
          document.createTextNode(fmt(item.kwhMonth)),
          document.createTextNode(money(item.costMonth)),
          remove,
        ]
        const detail = document.createElement('small')
        detail.textContent = `${fmt(item.watts, 0)} W · ${fmt(item.hours, 2)} h · ${fmt(item.load, 0)}%`
        cells.forEach((cell, index) => {
          const td = document.createElement('td')
          td.append(cell)
          if (index === 1) td.append(detail)
          row.append(td)
        })
        return row
      }))
      const included = items.filter((item) => item.include)
      const totalKwh = included.reduce((sum, item) => sum + item.kwhMonth, 0)
      const totalCost = included.reduce((sum, item) => sum + item.costMonth, 0)
      list.querySelector('[data-energy-total-kwh]')!.textContent = fmt(totalKwh)
      list.querySelector('[data-energy-total]')!.textContent = money(totalCost)
      list.querySelector('[data-energy-total-year]')!.textContent = `${money(totalCost * 12)} ${list.dataset.perYear}`
      list.querySelector('[data-energy-bill-currency]')!.textContent = field('currency').value
      show('[data-energy-empty]', items.length === 0)
      show('[data-energy-table]', items.length > 0)
      show('[data-energy-billbox]', items.length > 0)
      show('[data-energy-clear]', items.length > 0)
      const bill = Number(billInput.value)
      const result = list.querySelector<HTMLElement>('[data-energy-bill-result]')!
      if (bill > 0 && totalCost > 0) {
        const share = totalCost / bill
        result.textContent = share <= 1
          ? (list.dataset.billUnder ?? '').replace('{share}', `${Math.round(share * 100)}%`)
          : (list.dataset.billOver ?? '').replace('{share}', `${Math.round((share - 1) * 100)}%`)
      } else {
        result.textContent = ''
      }
    }

    const addButton = root.querySelector<HTMLButtonElement>('[data-energy-add]')!
    const addLabel = addButton.textContent
    addButton.addEventListener('click', () => {
      const qty = Math.min(99, Math.max(1, Math.round(number('qty')) || 1))
      const watts = number('watts')
      const hours = Math.min(24, number('hours'))
      const days = Math.min(31, Math.max(1, number('days')))
      const loadPct = Math.min(100, number('load'))
      const kwhMonth = (watts / 1000) * hours * (loadPct / 100) * qty * days
      const select = field('appliance') as HTMLSelectElement
      const name = field('name').value.trim() || select.selectedOptions[0]?.textContent || ''
      items.push({ id: `${Date.now()}-${items.length}`, name, qty, watts, hours, load: loadPct, kwhMonth, costMonth: kwhMonth * number('price'), include: true })
      save()
      renderList()
      addButton.textContent = addButton.dataset.added ?? addLabel
      window.setTimeout(() => { addButton.textContent = addLabel }, 1400)
      track('energy_list_add', { language: lang, items: items.length })
    })
    list.querySelector('[data-energy-clear]')!.addEventListener('click', () => { items = []; save(); renderList() })
    try { billInput.value = localStorage.getItem(`${STORE}-bill`) ?? '' } catch { /* storage unavailable */ }
    billInput.addEventListener('input', () => {
      try { localStorage.setItem(`${STORE}-bill`, billInput.value) } catch { /* storage unavailable */ }
      renderList()
    })

    update()
    renderList()
  }
</script>
