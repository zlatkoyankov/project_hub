---
// Every hub page: head metadata, the shared shell (top bar + footer) and the design tokens.
import '@zyankov/design-system/tokens.css'
import '@zyankov/design-system/fonts.css'
import literataCyrillic from '@zyankov/design-system/fonts/literata-cyrillic-opsz-normal.woff2?url'
import literataLatin from '@zyankov/design-system/fonts/literata-latin-opsz-normal.woff2?url'
import onestCyrillic from '@zyankov/design-system/fonts/onest-cyrillic-wght-normal.woff2?url'
import onestLatin from '@zyankov/design-system/fonts/onest-latin-wght-normal.woff2?url'
import '@zyankov/design-system/shell.css'
import { renderBar, renderFooter, renderHead } from '@zyankov/design-system/render'
import { absolute, ogKey, type Lang } from '../lib/site'

interface Props {
  title: string
  description: string
  /** Canonical path, e.g. "/about/". */
  path: string
  lang?: Lang
  /** Same page in other languages: { en: '/', bg: '/bg/' }. */
  alternates?: Partial<Record<Lang, string>>
  /** Leave AdSense out (privacy, terms, disclaimer). */
  noAds?: boolean
  /** Which bar link is current: 'hub' or 'about'. */
  project?: string
  ogType?: 'website' | 'article'
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  rss?: string
}

const { title: fullTitle, description, path, lang = 'en', alternates = {}, noAds = false, project = 'hub', ogType = 'website', jsonLd, rss } = Astro.props
// Search engines cut titles at about 70 characters, and they show the site name on their own. A long title drops the
// " | Zyankov.eu" suffix instead of being cut in the middle of the words that matter.
const title = fullTitle.length > 70 ? fullTitle.replace(/ \| Zyankov\.eu$/, '') : fullTitle
const url = absolute(path)
const ogImage = absolute(`/og/${ogKey(path)}.png`)
const alternateUrls = Object.fromEntries(Object.entries(alternates).map(([key, value]) => [key, absolute(value as string)]))
const structured = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((item) => ({
  '@context': 'https://schema.org',
  url,
  name: title,
  description,
  inLanguage: lang,
  isPartOf: { '@type': 'WebSite', name: 'Zyankov.eu', url: 'https://zyankov.eu/' },
  ...item,
}))
---

<!doctype html>
<html lang={lang} data-project="hub">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment set:html={renderHead({ ads: !noAds })} />
    <meta name="theme-color" content="#f1f5ef" />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {Object.entries(alternateUrls).map(([key, href]) => <link rel="alternate" hreflang={key} href={href} />)}
    {alternateUrls.en && alternateUrls.bg && <link rel="alternate" hreflang="x-default" href={alternateUrls.en} />}
    {/* Preload the fonts for the page's language, so headings do not reflow when the fonts arrive. */}
    {(lang === 'bg' ? [literataCyrillic, onestCyrillic] : [literataLatin, onestLatin]).map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {rss && <link rel="alternate" type="application/rss+xml" title="Zyankov.eu blog" href={rss} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={lang === 'bg' ? 'bg_BG' : 'en_US'} />
    <meta property="og:site_name" content="Zyankov.eu" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structured.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, '\\u003c')} />)}
    <slot name="head" />
  </head>
  <body>
    <Fragment set:html={renderBar({ project, main: 'top', lang, alternates: alternateUrls })} />
    <slot />
    <Fragment set:html={renderFooter({ project, lang })} />
  </body>
</html>
