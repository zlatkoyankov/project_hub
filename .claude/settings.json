{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build:*)",
      "Bash(npm run lint)",
      "Bash(npm run lint:colors)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(node scripts/assemble-site.mjs)",
      "Bash(node scripts/lint-colors.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env.deploy)",
      "Edit(./.env.deploy)",
      "Bash(npm run deploy:*)",
      "Bash(node scripts/deploy.mjs:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-colors.mjs\""
          }
        ]
      }
    ]
  }
}
